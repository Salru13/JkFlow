+/* ---- Blur launcher UI seam (launcher/INTEGRATION.md) -------------------- */
+
+typedef struct BlurHost {
+    PwVideoOutPs5 video;
+    PwPadPs5 pad;
+    PwPadPs5Ops pad_ops;
+    int pad_status, ops_ok;
+    uint64_t pad_tried;
+} BlurHost;
+
+static int blur_host_present(void *ctx, const BlFrame *f)
+{
+    BlurHost *h = ctx;
+    const PwPresentView view = { f->pixels, f->width, f->height, f->stride, f->stride * f->height };
+    int rc = pw_videoout_ps5_present(&h->video, &view);
+    (void)sceGnmSubmitDone();
+    return rc == PW_OK ? 0 : -1;
+}
+
+static int blur_host_pad(void *ctx, uint32_t *held, uint32_t *pressed)
+{
+    BlurHost *h = ctx;
+    *held = *pressed = 0;
+    if (h->pad_status != PW_OK) {
+        uint64_t now = now_ns();
+        /* No controller signed in yet: try again every 2 s. */
+        if (!h->ops_ok || now - h->pad_tried < 2000000000ull) return -1;
+        h->pad_tried = now;
+        h->pad_status = pw_pad_ps5_open(&h->pad, &h->pad_ops, pad_open_map,
+                                        sizeof(pad_open_map) / sizeof(pad_open_map[0]));
+        if (h->pad_status != PW_OK) return -1;
+    }
+    if (pw_pad_ps5_read(&h->pad) != PW_OK) return -1;
+    *held = h->pad.core.previous_buttons;
+    *pressed = h->pad.core.pressed_edges;
+    return 0;
+}
+
+static uint64_t blur_host_now(void *ctx) { (void)ctx; return now_ns(); }
+static void blur_host_sleep(void *ctx, uint32_t us) { (void)ctx; usleep(us); }
+
+static int blur_host_net(void *ctx, char *ipv4, size_t cap)
+{
+    (void)ctx;
+#ifdef __PS4__
+    extern int pw_ps4_netctl_config(char *buffer, size_t size);
+    char cfg[160] = "";
+    if (pw_ps4_netctl_config(cfg, sizeof(cfg)) == 0) {
+        size_t n = strcspn(cfg, ",");
+        if (n && n < cap && strncmp(cfg, "0.0.0.0", n)) {
+            memcpy(ipv4, cfg, n);
+            ipv4[n] = 0;
+            return 0;
+        }
+    }
+#else
+    (void)ipv4; (void)cap;
+#endif
+    return -1;
+}
+
+/* is_pro is left NULL ("unknown"): sceKernelIsNeoMode would be the title's only
+ * new import, and without model-pro.ini it changes nothing but a label. */
+
+/* Readiness when the package has no blur-files/ (then the patcher cannot
+ * decide): any Blur.exe that is a PE file. */
+static int blur_host_game_state(void *ctx)
+{
+    (void)ctx;
+    return direct_game_file_ok("/data/Pc/Blur/Blur.exe") ? BL_READY_OK : BL_READY_NO_GAME;
+}
+
+static void blur_host_log(void *ctx, const char *line)
+{
+    (void)ctx;
+    PS5LOG_LOG("PW_WINE64 launcher %s", line);
+}
+
+/* The player's decision for this start; its strings back extra[] until Wine
+ * has copied them. */
+static BlDecision blur_decision;
+
+/* Runs the launcher UI until play (returns) or close (leaves to home). */
+static void blur_launcher_screen(void)
+{
+    static BlurHost host;
+    static char files_dir[200];
+    BlServices s;
+    memset(&s, 0, sizeof(s));
+    /* The app sets up its own folders, before the user has copied anything. */
+    (void)mkdir("/data/Pc", 0777);
+    (void)mkdir("/data/Pc/Blur", 0777);
+    for (size_t i = 0; i < sizeof(runtime_roots) / sizeof(runtime_roots[0]) && !files_dir[0]; i++) {
+        char probe[240];
+        snprintf(probe, sizeof(probe), "%s/blur-files/manifest.txt", runtime_roots[i]);
+        if (access(probe, R_OK) == 0) snprintf(files_dir, sizeof(files_dir), "%s/blur-files", runtime_roots[i]);
+    }
+    int video_status = pw_videoout_ps5_open(&host.video);
+    host.ops_ok = pw_pad_ps5_platform_ops(&host.pad_ops) == PW_OK;
+    host.pad_status = host.ops_ok ? pw_pad_ps5_open(&host.pad, &host.pad_ops, pad_open_map,
+                                                    sizeof(pad_open_map) / sizeof(pad_open_map[0]))
+                                  : PW_ERR_STATE;
+    host.pad_tried = now_ns();
+    PS5LOG_LOG("PW_WINE64 launcher open video=%s pad=%s files=%s", pw_result_name(video_status),
+               pw_result_name(host.pad_status), files_dir[0] ? files_dir : "-");
+    s.ctx = &host;
+    s.present = blur_host_present;
+    s.pad = blur_host_pad;
+    s.now_ns = blur_host_now;
+    s.sleep_us = blur_host_sleep;
+    s.net_status = blur_host_net;
+    s.game_state = blur_host_game_state;
+    s.log = blur_host_log;
+    s.data_root = library_root;
+    s.game_dir = "/data/Pc/Blur";
+    s.package_files_dir = files_dir[0] ? files_dir : NULL;
+    s.build_id = PW_BUILD_ID;
+    int rc = video_status == PW_OK ? bl_frontend_run(&s, &blur_decision) : -1;
+    if (host.pad_status == PW_OK) (void)pw_pad_ps5_close(&host.pad);
+    if (video_status == PW_OK) (void)pw_videoout_ps5_close(&host.video);
+    if (rc != 0) {
+        /* No display: start only a game that is there, with the built-in profile. */
+        PS5LOG_LOG("PW_WINE64 launcher run=%d video=%s", rc, pw_result_name(video_status));
+        memset(&blur_decision, 0, sizeof(blur_decision));
+        if (blur_host_game_state(NULL) == BL_READY_OK) return;
+        leave_to_home("blur-launcher-no-display");
+    }
+    if (blur_decision.action == BL_LEAVE_HOME) leave_to_home("blur-launcher-close");
+    PS5LOG_LOG("PW_WINE64 launcher chose=start env=%u", blur_decision.env_count);
+}
+
+/* The launcher's environment into extra[]: WINEDEBUG through extra[0], the
+ * rest replaces a variable the profile already set or is appended. The
+ * launcher removes DXVK_PS4_NATIVE for the compatible renderer, so a value
+ * the built-in profile set is dropped too. */
+static void blur_apply_decision(PwWineStartEnv *extra, uint32_t *count, size_t capacity)
+{
+    int native = 0;
+    for (unsigned i = 0; i < blur_decision.env_count; i++) {
+        const char *name = blur_decision.env[i].name, *value = blur_decision.env[i].value;
+        if (!strcmp(name, "DXVK_PS4_NATIVE")) native = 1;
+        if (!strcmp(name, "WINEDEBUG")) { extra[0].value = value; continue; }
+        uint32_t j;
+        for (j = 1; j < *count; j++) if (extra[j].name && !strcmp(extra[j].name, name)) break;
+        if (j < *count) extra[j].value = value;
+        else if (*count < capacity) extra[(*count)++] = (PwWineStartEnv){ name, value };
+        else PS5LOG_LOG("PW_WINE64 launcher env dropped=%s (no room)", name);
+    }
+    if (!native)
+        for (uint32_t j = 1; j < *count; j++)
+            if (extra[j].name && !strcmp(extra[j].name, "DXVK_PS4_NATIVE")) {
+                memmove(&extra[j], &extra[j + 1], (*count - j - 1) * sizeof(extra[0]));
+                (*count)--;
+                extra[*count] = (PwWineStartEnv){ NULL, NULL };
+                break;
+            }
+    PS5LOG_LOG("PW_WINE64 launcher env applied=%u native=%d winedebug=%s", blur_decision.env_count, native,
+               extra[0].value);
+}
