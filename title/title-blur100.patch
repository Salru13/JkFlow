diff -ruN base/prospero/native/blur100-display-name.c r4/prospero/native/blur100-display-name.c
--- base/prospero/native/blur100-display-name.c
+++ r4/prospero/native/blur100-display-name.c
@@ -0,0 +1,159 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Copyright 2026 XxXJoker13XxX and contributors */
+/* The game display name from the PS4 local user name, made portable without
+ * the system keyboard (audit finding 4). See blur100-display-name.h. */
+#include "blur100-display-name.h"
+#include <string.h>
+
+static int portable_char(unsigned char c)
+{
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
+           c == '_' || c == '-' || c == '.';
+}
+
+/* The accepted native policy (formerly pw_blur_name_portable): 1..16 bytes
+ * of A-Z a-z 0-9 . _ -, no dot at either end, NUL within extent. */
+static int portable(const char *in, size_t extent, size_t *length)
+{
+    size_t n = 0;
+    while (n < extent && n <= PW_BLUR100_NAME_MAX && in[n]) {
+        if (!portable_char((unsigned char)in[n])) return 0;
+        n++;
+    }
+    if (!n || n > PW_BLUR100_NAME_MAX || n >= extent || in[n]) return 0;
+    if (in[0] == '.' || in[n - 1] == '.') return 0;
+    *length = n;
+    return 1;
+}
+
+/* U+00C0..U+00FF and U+0100..U+017F: the base letter, '?' for a two-letter
+ * fold (fold2), '_' for a non-letter (x and division sign). */
+static const char latin1[] =
+    "AAAAAA?CEEEEIIII" "DNOOOOO_OUUUUY??" "aaaaaa?ceeeeiiii" "dnooooo_ouuuuy?y";
+static const char latin_ext_a[] =
+    "AaAaAaCcCcCcCcDd" "DdEeEeEeEeEeGgGg" "GgGgHhHhIiIiIiIi" "Ii??JjKkkLlLlLlL"
+    "lLlNnNnNnnNnOoOo" "Oo??RrRrRrSsSsSs" "SsTtTtTtUuUuUuUu" "UuUuWwYyYZzZzZzs";
+
+static const char *fold2(uint32_t code)
+{
+    switch (code) {
+    case 0xc6: return "AE";
+    case 0xde: return "TH";
+    case 0xdf: return "ss";
+    case 0xe6: return "ae";
+    case 0xfe: return "th";
+    case 0x132: return "IJ";
+    case 0x133: return "ij";
+    case 0x152: return "OE";
+    case 0x153: return "oe";
+    default: return "_";
+    }
+}
+
+/* The ASCII text for one code point: a letter, two letters, "" (combining
+ * mark, dropped) or "_". */
+static const char *fold(uint32_t code, char one[2])
+{
+    char c = 0;
+    if (code < 0x80) c = portable_char((unsigned char)code) ? (char)code : '_';
+    else if (code >= 0x300 && code <= 0x36f) return "";
+    else if (code >= 0xc0 && code <= 0xff) c = latin1[code - 0xc0];
+    else if (code >= 0x100 && code <= 0x17f) c = latin_ext_a[code - 0x100];
+    else if (code >= 0x218 && code <= 0x21b) c = "SsTt"[code - 0x218];
+    else c = '_';
+    if (c == '?') return fold2(code);
+    one[0] = c;
+    one[1] = 0;
+    return one;
+}
+
+/* One UTF-8 scalar at in[*i] (strict: shortest form, no surrogates); a
+ * malformed byte is consumed alone and reported as U+FFFD. */
+static uint32_t next_scalar(const unsigned char *in, size_t length, size_t *i)
+{
+    unsigned char first = in[(*i)++];
+    uint32_t code, minimum;
+    unsigned extra;
+    if (first < 0x80) return first;
+    if (first >= 0xc2 && first <= 0xdf) { code = first & 31u; extra = 1; minimum = 0x80; }
+    else if (first >= 0xe0 && first <= 0xef) { code = first & 15u; extra = 2; minimum = 0x800; }
+    else if (first >= 0xf0 && first <= 0xf4) { code = first & 7u; extra = 3; minimum = 0x10000; }
+    else return 0xfffd;
+    if (*i + extra > length) return 0xfffd;
+    for (unsigned j = 0; j < extra; j++)
+        if ((in[*i + j] & 0xc0) != 0x80) return 0xfffd;
+    for (unsigned j = 0; j < extra; j++) code = (code << 6) | (in[(*i)++] & 63u);
+    if (code < minimum || code > 0x10ffff || (code >= 0xd800 && code <= 0xdfff)) return 0xfffd;
+    return code;
+}
+
+static int trim_char(char c) { return c == '_' || c == '.' || c == '-'; }
+
+size_t pw_blur100_name_sanitize(const char *in, size_t extent, char out[PW_BLUR100_NAME_MAX + 1],
+                                int *sanitized)
+{
+    size_t length = 0, n = 0;
+    char work[4 * PW_BLUR100_NAME_MAX + 8];
+    if (sanitized) *sanitized = 1;
+    if (in && portable(in, extent, &length)) {
+        memcpy(out, in, length);
+        out[length] = 0;
+        if (sanitized) *sanitized = 0;
+        return length;
+    }
+    length = 0;
+    while (in && length < extent && in[length]) length++;
+    /* Converted text, '_' collapsed, leading '_' '.' '-' never stored; stop
+     * once enough is kept for 16 bytes after the trailing trim. */
+    for (size_t i = 0; i < length && n < sizeof(work) - 3;) {
+        char one[2];
+        const char *text = fold(next_scalar((const unsigned char *)in, length, &i), one);
+        for (; *text; text++) {
+            if (!n && trim_char(*text)) continue;
+            if (*text == '_' && n && work[n - 1] == '_') continue;
+            work[n++] = *text;
+        }
+    }
+    if (n > PW_BLUR100_NAME_MAX) n = PW_BLUR100_NAME_MAX;
+    while (n && trim_char(work[n - 1])) n--;
+    if (!n) {
+        memcpy(out, "Player", sizeof("Player"));
+        return sizeof("Player") - 1;
+    }
+    memcpy(out, work, n);
+    out[n] = 0;
+    return n;
+}
+
+int pw_blur100_display_name(const PwBlurNameOps *ops, PwBlurName *out, int *sanitized)
+{
+    char text[PW_BLUR_NAME_UTF8_CAP], name[PW_BLUR100_NAME_MAX + 1];
+    int32_t user = -1, foreground_rc = -1, username_rc = -1;
+    int local = 0, changed = 1;
+    if (ops && ops->foreground && ops->username) {
+        foreground_rc = ops->foreground(&user);
+        if (foreground_rc != 0 || user < 0) user = -1;
+        else {
+            memset(text, 0, sizeof(text));
+            username_rc = ops->username(user, text, sizeof(text));
+            local = username_rc == 0;
+        }
+    }
+    if (!local) user = -1;
+    size_t bytes = pw_blur100_name_sanitize(local ? text : NULL, local ? sizeof(text) : 0, name, &changed);
+    if (out) {
+        /* A portable ASCII name always validates. */
+        if (!pw_blur_name_validate(name, bytes + 1, out)) {
+            memset(out, 0, sizeof(*out));
+            memcpy(out->utf8, "Player", sizeof("Player"));
+            out->bytes = out->units = out->scalars = sizeof("Player") - 1;
+            for (size_t i = 0; i < out->units; i++) out->utf16[i] = (uint16_t)out->utf8[i];
+        }
+        out->source = PW_BLUR_NAME_LOCAL;
+        out->user_id = user;
+        out->foreground_rc = foreground_rc;
+        out->username_rc = username_rc;
+    }
+    if (sanitized) *sanitized = changed;
+    return local;
+}
diff -ruN base/prospero/native/blur100-display-name.h r4/prospero/native/blur100-display-name.h
--- base/prospero/native/blur100-display-name.h
+++ r4/prospero/native/blur100-display-name.h
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Copyright 2026 XxXJoker13XxX and contributors */
+#ifndef BLUR100_DISPLAY_NAME_H
+#define BLUR100_DISPLAY_NAME_H
+/* The game display name from the PS4 local user name (audit finding 4).
+ * The system keyboard is never opened: a name that is not portable is
+ * converted. Portable: 1..16 bytes of A-Z a-z 0-9 . _ - and no dot at
+ * either end; such a name stays byte-identical. Any other name: Latin
+ * letters with diacritics fold to ASCII (Latin-1 Supplement, Latin
+ * Extended-A, Romanian comma letters), combining marks drop, every other
+ * character becomes _, repeated _ collapse, _ . - are trimmed at
+ * both ends, at most 16 bytes, and "Player" when nothing is left. The online
+ * (AMAX) account is not involved. */
+#include "native279-username.h"
+
+enum { PW_BLUR100_NAME_MAX = 16 };
+
+/* Reads at most extent bytes of in (stops at NUL). out always receives a
+ * portable, NUL-terminated name; returns its length (1..16). *sanitized is 0
+ * only when the input was already portable and was copied unchanged. */
+size_t pw_blur100_name_sanitize(const char *in, size_t extent, char out[PW_BLUR100_NAME_MAX + 1],
+                                int *sanitized);
+/* The foreground local user name through ops, sanitized. out always holds a
+ * valid portable name (source PW_BLUR_NAME_LOCAL). Returns 1 when the local
+ * name was read, 0 when no foreground user or name was available ("Player").
+ * No account, network, save or keyboard is touched. */
+int pw_blur100_display_name(const PwBlurNameOps *ops, PwBlurName *out, int *sanitized);
+/* The same with sceUserServiceGetForegroundUser / sceUserServiceGetUserName. */
+int pw_blur100_display_name_from_orbis(PwBlurName *out, int *sanitized);
+#endif
diff -ruN base/prospero/native/native245_seed.c r4/prospero/native/native245_seed.c
--- base/prospero/native/native245_seed.c
+++ r4/prospero/native/native245_seed.c
@@ -144,6 +144,7 @@
     case N245_PRESENT: return "present";
     case N245_PRESENT_EXTERNAL: return "present-external";
     case N245_RESUMED_PUBLISH: return "resumed-publish";
+    case N245_UPDATED: return "updated";
     case N245_DISABLED: return "disabled";
     case N245_NO_SEED: return "no-seed";
     case N245_REFUSED_FOREIGN_PROFILE: return "refused-foreign-profile";
@@ -943,3 +944,157 @@
     n245_index_free(&ix);
     return st;
 }
+
+/* ------------------------------------------------------------------ import2 */
+/* BLUR 1.00 (plan Task T1 item 4): the seed straight into prefix_dir. See
+ * native245_seed.h. No profiles/ and no prefixes/<slug>: the title names the
+ * prefix itself. */
+static int n245_in_users(const char *rel)
+{
+    static const char users[] = "drive_c/users/";
+    return !strncmp(rel, users, sizeof(users) - 1);
+}
+
+N245Status n245_seed_import2(const char *const *app_roots, size_t root_count, const char *prefix_dir,
+                             const char *pinned_end, N245Result *r,
+                             void (*progress)(void *ctx, unsigned done, unsigned total), void *ctx,
+                             int update_mode)
+{
+    char seed[N245_PATH_MAX], path[N245_PATH_MAX], src[N245_PATH_MAX], staging[N245_PATH_MAX];
+    char owner_text[128], marker_text[128];
+    char *marker = NULL, *owner = NULL;
+    size_t marker_size = 0, owner_size = 0, i;
+    int is_dir = 0, updating = 0;
+    unsigned k;
+    N245Index ix;
+    N245Status st = N245_ERR_ARGS;
+    const char *root;
+
+    if (!r) return N245_ERR_ARGS;
+    memset(r, 0, sizeof(*r));
+    memset(&ix, 0, sizeof(ix));
+#define N245_DONE(code) do { st = (code); goto done; } while (0)
+    if (!pinned_end) N245_DONE(N245_DISABLED);
+    if (!app_roots || !prefix_dir || prefix_dir[0] != '/' || strlen(pinned_end) != 64 || !n245_is_hex64(pinned_end)) {
+        snprintf(r->detail, sizeof(r->detail), "bad arguments");
+        N245_DONE(N245_ERR_ARGS);
+    }
+    seed[0] = 0;
+    for (i = 0; i < root_count; i++) {
+        if (!app_roots[i]) continue;
+        if (!n245_join3(path, sizeof(path), app_roots[i], N245_SEED_DIR, "seed.idx")) continue;
+        if (n245_exists(path, &is_dir) && !is_dir) {
+            n245_join(seed, sizeof(seed), app_roots[i], N245_SEED_DIR);
+            snprintf(r->seed_root, sizeof(r->seed_root), "%s", app_roots[i]);
+            break;
+        }
+    }
+    if (!seed[0]) N245_DONE(N245_NO_SEED);
+    if (!n245_join(path, sizeof(path), seed, "seed.idx")) N245_DONE(N245_ERR_ARGS);
+    st = n245_index_load(path, pinned_end, &ix, r->detail, sizeof(r->detail));
+    if (st != N245_IMPORTED) goto done;
+    r->files_total = ix.file_count;
+    r->dirs_total = ix.dir_count;
+    snprintf(owner_text, sizeof(owner_text), "N245-OWNER %s\n", ix.end_hash);
+    snprintf(marker_text, sizeof(marker_text), "N245-COMPLETE %s\n", ix.end_hash);
+    if (snprintf(staging, sizeof(staging), "%s.n245-staging", prefix_dir) >= (int)sizeof(staging))
+        N245_DONE(N245_ERR_ARGS);
+
+    /* 1. Fast path: this seed's marker in the prefix. */
+    if (n245_exists(prefix_dir, &is_dir)) {
+        if (!is_dir) {
+            snprintf(r->detail, sizeof(r->detail), "%.200s is not a folder", prefix_dir);
+            N245_DONE(N245_REFUSED_FOREIGN_PREFIX);
+        }
+        if (!n245_join(path, sizeof(path), prefix_dir, N245_MARKER_FILE)) N245_DONE(N245_ERR_ARGS);
+        if (n245_read_all(path, 256, &marker, &marker_size) == 0 && marker_size == strlen(marker_text) &&
+            !memcmp(marker, marker_text, marker_size))
+            N245_DONE(N245_PRESENT);
+        if (!update_mode) {
+            snprintf(r->detail, sizeof(r->detail), "%.200s exists and was not completed by this seed", prefix_dir);
+            N245_DONE(N245_REFUSED_FOREIGN_PREFIX);
+        }
+        updating = 1;
+        root = prefix_dir;
+    } else {
+        /* 2. Fresh: build in staging (resumed; any earlier owner is adopted,
+         *    since every file below is verified against this index). */
+        if (n245_exists(staging, &is_dir)) {
+            if (!is_dir) {
+                snprintf(r->detail, sizeof(r->detail), "%.200s is not a folder", staging);
+                N245_DONE(N245_REFUSED_STAGING);
+            }
+        } else if (n245_mkdir_parent(staging) || n245_mkdir_one(staging)) {
+            snprintf(r->detail, sizeof(r->detail), "mkdir %.200s errno=%d", staging, errno);
+            N245_DONE(N245_ERR_IO);
+        }
+        if (!n245_join(path, sizeof(path), staging, N245_OWNER_FILE)) N245_DONE(N245_ERR_ARGS);
+        if (n245_read_all(path, 256, &owner, &owner_size) != 0 || owner_size != strlen(owner_text) ||
+            memcmp(owner, owner_text, owner_size)) {
+            if (n245_publish_bytes(path, owner_text, strlen(owner_text))) {
+                snprintf(r->detail, sizeof(r->detail), "owner stamp errno=%d", errno);
+                N245_DONE(N245_ERR_IO);
+            }
+            n245_sync_dir(staging);
+        }
+        root = staging;
+    }
+
+    for (k = 0; k < ix.dir_count; k++) {
+        if (!n245_join(path, sizeof(path), root, ix.dirs[k]) || n245_mkdir_p(path)) {
+            snprintf(r->detail, sizeof(r->detail), "mkdir %s errno=%d", ix.dirs[k], errno);
+            N245_DONE(N245_ERR_IO);
+        }
+    }
+    for (k = 0; k < ix.file_count; k++) {
+        const N245File *f = &ix.files[k];
+        if (progress) progress(ctx, k, ix.file_count);
+        if (!n245_join(path, sizeof(path), root, f->rel)) N245_DONE(N245_ERR_ARGS);
+        /* An update never touches the player's files: under drive_c/users/
+         * only a missing file is created. */
+        if (updating && n245_in_users(f->rel) && n245_exists(path, NULL)) { r->kept++; continue; }
+        if (n245_file_matches(path, f->size, f->sha)) { r->kept++; continue; }
+        if (!strcmp(f->src, "-")) {
+            if (!n245_join3(src, sizeof(src), seed, "objects", f->sha)) N245_DONE(N245_ERR_ARGS);
+        } else if (!n245_join(src, sizeof(src), r->seed_root, f->src)) {
+            N245_DONE(N245_ERR_ARGS);
+        }
+        if (n245_mkdir_parent(path)) {
+            snprintf(r->detail, sizeof(r->detail), "mkdir parent of %s errno=%d", f->rel, errno);
+            N245_DONE(N245_ERR_IO);
+        }
+        st = n245_copy_verified(src, path, f->size, f->sha, &r->bytes_copied, r->detail, sizeof(r->detail));
+        if (st != N245_IMPORTED) goto done;
+        r->copied++;
+    }
+    if (progress) progress(ctx, ix.file_count, ix.file_count);
+
+    /* 3. Every file is verified: the completion marker last. */
+    if (!n245_join(path, sizeof(path), root, N245_MARKER_FILE) ||
+        n245_publish_bytes(path, marker_text, strlen(marker_text))) {
+        snprintf(r->detail, sizeof(r->detail), "completion stamp errno=%d", errno);
+        N245_DONE(N245_ERR_IO);
+    }
+    n245_sync_dir(root);
+    if (!updating) {
+        if (N245_FAULT("rename", prefix_dir) || rename(staging, prefix_dir) != 0) {
+            snprintf(r->detail, sizeof(r->detail), "rename staging errno=%d", errno);
+            N245_DONE(N245_ERR_IO);
+        }
+        {
+            char parent[N245_PATH_MAX];
+            const char *slash = strrchr(prefix_dir, '/');
+            size_t n = slash ? (size_t)(slash - prefix_dir) : 0;
+            if (n && n < sizeof(parent)) { memcpy(parent, prefix_dir, n); parent[n] = 0; n245_sync_dir(parent); }
+        }
+    }
+    st = updating ? N245_UPDATED : N245_IMPORTED;
+
+done:
+#undef N245_DONE
+    r->status = st;
+    free(marker);
+    free(owner);
+    n245_index_free(&ix);
+    return st;
+}
