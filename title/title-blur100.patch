+/* ---- free_bytes: free space of the volume holding path (audit finding 16) */
+/* The SDK's libkernel has no statfs and its libc statvfs does not fill its
+ * result, so the kernel's fstatfs (libkernel _fstatfs) is asked directly and
+ * its FreeBSD struct statfs read only when its version says that layout.
+ * Free = f_bavail * f_bsize (FreeBSD has no f_frsize). <0 unknown: the
+ * launcher then skips its disk-space checks, as before. */
+extern int _fstatfs(int fd, void *buf);
+#define BLUR_STATFS_VERSION 0x20030518u
+static long long blur_host_free_bytes(void *ctx, const char *path)
+{
+    union {
+        struct {
+            uint32_t version, type;
+            uint64_t flags, bsize, iosize, blocks, bfree;
+            int64_t bavail;
+        } f;
+        uint8_t raw[1024];              /* the whole struct (472 bytes) with room to spare */
+    } st;
+    int fd, rc;
+    (void)ctx;
+    if (!path || (fd = open(path, O_RDONLY)) < 0) return -1;
+    memset(&st, 0, sizeof(st));
+    rc = _fstatfs(fd, &st);
+    close(fd);
+    if (rc != 0 || st.f.version != BLUR_STATFS_VERSION || st.f.bsize < 512 || st.f.bsize > (1u << 20) ||
+        st.f.bavail < 0 || (uint64_t)st.f.bavail > (uint64_t)INT64_MAX / st.f.bsize)
+        return -1;
+    return st.f.bavail * (long long)st.f.bsize;
+}
 
