+static int blur_http_date_header(const char *head, char *out, size_t cap)
+{
+    for (const char *line = head; line && *line; ) {
+        if (!strncasecmp(line, "Date:", 5)) {
+            const char *v = line + 5;
+            while (*v == ' ' || *v == '\t') v++;
+            size_t n = strcspn(v, "\r\n");
+            if (!n || n >= cap) return -1;
+            memcpy(out, v, n);
+            out[n] = 0;
+            return 0;
+        }
+        line = strchr(line, '\n');
+        if (line) line++;
+    }
+    return -1;
+}
