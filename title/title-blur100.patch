+/* The launcher's dxvk.conf (model-base.ini [dxvk.conf]) at <root>/cache/dxvk.conf,
+ * where DXVK_CONFIG_FILE points: written only when it differs, atomically. */
+static void blur_write_dxvk_conf(void)
+{
+    char dir[160], path[192], temp[208], old[sizeof(blur_decision.dxvk_conf)];
+    const char *text = blur_decision.dxvk_conf;
+    size_t n = strlen(text), got = 0;
+    int fd, ok = 0;
+    if (!n) return;
+    snprintf(dir, sizeof(dir), "%s/cache", library_root);
+    snprintf(path, sizeof(path), "%s/dxvk.conf", dir);
+    snprintf(temp, sizeof(temp), "%s.new", path);
+    (void)mkdir(dir, 0777);
+    if ((fd = open(path, O_RDONLY)) >= 0) {
+        ssize_t r;
+        while (got < sizeof(old) && (r = read(fd, old + got, sizeof(old) - got)) > 0) got += (size_t)r;
+        close(fd);
+        if (got == n && !memcmp(old, text, n)) { PS5LOG_LOG("PW_WINE64 dxvk.conf unchanged"); return; }
+    }
+    if ((fd = open(temp, O_WRONLY | O_CREAT | O_TRUNC, 0666)) >= 0) {
+        ok = write(fd, text, n) == (ssize_t)n && fsync(fd) == 0;
+        ok = close(fd) == 0 && ok;
+        ok = ok && rename(temp, path) == 0;
+        if (!ok) (void)unlink(temp);
+    }
+    PS5LOG_LOG("PW_WINE64 dxvk.conf written=%d bytes=%u", ok, (unsigned)n);
+}
