+/* ---- http_date: one HEAD to host:80 for the clock check (D7) ----------- */
+
+typedef struct BlurNetAddr {        /* the console's sockaddr_in (BSD layout) */
+    uint8_t length, family;
+    uint16_t port;
+    uint32_t address;
+    uint8_t zero[8];
+} BlurNetAddr;
+
+extern int sceNetRecv(int socket, void *data, size_t length, int flags);
+extern int sceNetPoolCreate(const char *name, int size, int flags);
+extern void sceNetPoolDestroy(int memid);
+extern int sceNetResolverCreate(const char *name, int memid, int flags);
+extern int sceNetResolverStartNtoa(int rid, const char *hostname, uint32_t *addr, int timeout, int retry, int flags);
+extern int sceNetResolverDestroy(int rid);
+
+/* The resolver runs on its own thread so a resolver that ignores its timeout
+ * can never hold the launcher: the caller waits at most BLUR_HTTP_RESOLVE_MS. */
+enum { BLUR_HTTP_RESOLVE_MS = 1500, BLUR_HTTP_IO_US = 1000000 };
+static struct {
+    pthread_mutex_t lock;
+    int busy, done, rc;
+    uint32_t addr;
+    char host[64];
+    uint32_t timeout_us;                /* the resolver's own timeout for this lookup */
+} blur_resolve = { PTHREAD_MUTEX_INITIALIZER, 0, 0, -1, 0, "", BLUR_HTTP_IO_US };
+
+static void *blur_resolve_thread(void *arg)
+{
+    char host[64];
+    uint32_t addr = 0, timeout_us;
+    int rc = -1, pool, rid = -1;
+    (void)arg;
+    pthread_mutex_lock(&blur_resolve.lock);
+    memcpy(host, blur_resolve.host, sizeof(host));
+    timeout_us = blur_resolve.timeout_us;
+    pthread_mutex_unlock(&blur_resolve.lock);
+    pool = sceNetPoolCreate("blur-clock", 4 * 1024, 0);
+    if (pool >= 0) rid = sceNetResolverCreate("blur-clock", pool, 0);
+    if (rid >= 0) rc = sceNetResolverStartNtoa(rid, host, &addr, timeout_us, 0, 0);
+    if (rid >= 0) (void)sceNetResolverDestroy(rid);
+    if (pool >= 0) sceNetPoolDestroy(pool);
+    pthread_mutex_lock(&blur_resolve.lock);
+    blur_resolve.rc = rc < 0 ? -1 : 0;
+    blur_resolve.addr = addr;
+    blur_resolve.done = 1;
+    blur_resolve.busy = 0;
+    pthread_mutex_unlock(&blur_resolve.lock);
+    return NULL;
+}
+
+static int blur_resolve_ipv4_wait(const char *host, uint32_t *addr, int wait_ms, uint32_t timeout_us)
+{
+    pthread_t thread;
+    pthread_attr_t attr;
+    int started, rc = -1;
+    pthread_mutex_lock(&blur_resolve.lock);
+    if (blur_resolve.busy || strlen(host) >= sizeof(blur_resolve.host)) {   /* an earlier one still hangs */
+        pthread_mutex_unlock(&blur_resolve.lock);
+        return -1;
+    }
+    blur_resolve.busy = 1;
+    blur_resolve.done = 0;
+    snprintf(blur_resolve.host, sizeof(blur_resolve.host), "%s", host);
+    blur_resolve.timeout_us = timeout_us;
+    pthread_mutex_unlock(&blur_resolve.lock);
+    pthread_attr_init(&attr);
+    pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+    pthread_attr_setstacksize(&attr, 256u << 10);
+    started = pthread_create(&thread, &attr, blur_resolve_thread, NULL) == 0;
+    pthread_attr_destroy(&attr);
+    if (!started) {
+        pthread_mutex_lock(&blur_resolve.lock);
+        blur_resolve.busy = 0;
+        pthread_mutex_unlock(&blur_resolve.lock);
+        return -1;
+    }
+    for (int waited = 0; waited <= wait_ms; waited += 20) {
+        pthread_mutex_lock(&blur_resolve.lock);
+        int done = blur_resolve.done;
+        if (done) { rc = blur_resolve.rc; *addr = blur_resolve.addr; }
+        pthread_mutex_unlock(&blur_resolve.lock);
+        if (done) break;
+        usleep(20000);
+    }
+    return rc == 0 && *addr ? 0 : -1;
+}
+
+static int blur_resolve_ipv4(const char *host, uint32_t *addr)
+{
+    return blur_resolve_ipv4_wait(host, addr, BLUR_HTTP_RESOLVE_MS, BLUR_HTTP_IO_US);
+}
