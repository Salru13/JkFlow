+    char request[160], head[2048], date[64];
+    size_t used = 0;
+    int s = -1, rc = -1;
+    uint64_t started = now_ns();
+    (void)ctx;
+    if (!host || !epoch || blur_resolve_ipv4(host, &addr) != 0) goto done;
+    s = ps5log_ps5_socket(AF_INET, SOCK_STREAM, 0);
+    if (s < 0) goto done;
+    {   /* send, receive and connect timeouts in microseconds (pw_lapy_elevation.c) */
+        static const int options[] = { 0x1105, 0x1106, 0x1109 };
+        for (size_t i = 0; i < sizeof(options) / sizeof(options[0]); i++)
+            if (ps5log_ps5_setsockopt(s, 0xffff, options[i], &timeout, sizeof(timeout)) < 0) goto done;
+    }
+    memset(&address, 0, sizeof(address));
+    address.length = sizeof(address);
+    address.family = AF_INET;
+    address.port = (uint16_t)((80 << 8) | (80 >> 8));
+    address.address = addr;
+    if (ps5log_ps5_connect(s, (const struct sockaddr *)&address, sizeof(address)) < 0) goto done;
+    int n = snprintf(request, sizeof(request), "HEAD / HTTP/1.0\r\nHost: %s\r\nUser-Agent: JkFlow\r\n\r\n", host);
+    if (n <= 0 || (size_t)n >= sizeof(request) || ps5log_ps5_send(s, request, (size_t)n, 0) != n) goto done;
+    while (used < sizeof(head) - 1 && now_ns() - started < 3000000000ull) {
+        int got = sceNetRecv(s, head + used, sizeof(head) - 1 - used, 0);
+        if (got <= 0) break;
+        used += (size_t)got;
+        head[used] = 0;
+        if (strstr(head, "\r\n\r\n")) break;
+    }
+    head[used] = 0;
+    if (used && blur_http_date_header(head, date, sizeof(date)) == 0 && bl_http_date_parse(date, epoch) == 0) rc = 0;
+done:
+    if (s >= 0) (void)ps5log_ps5_close(s);
+    PS5LOG_LOG("PW_WINE64 launcher http_date rc=%d ms=%llu", rc,
+               (unsigned long long)((now_ns() - started) / 1000000u));
+    return rc;
+}
+
+/* ---- https_get: the system libSceHttp/libSceSsl, certificate check on ---- */
+/* Console test 2026-11-15 (docs/status/https-console-test-20261115.md):
+ * the same init, pools and timeouts fetched both AMAX zips (200, SHA match);
+ * an unreachable host failed after 30 s with 0x80431068. The modules are
+ * loaded with sceSysmoduleLoadModuleInternal (the one import this adds, from
+ * the already imported libSceSysmodule) until one init succeeds, never again
+ * after; their functions are looked up with sceKernelDlsym, as in pw_osk_ps5.c.
+ * Each operation has a 30 s timeout; the whole download 150 s, and 30 s
+ * without a byte ends it (audit finding 8). Redirects are not followed: only
+ * 200, or 206 for a resumed download, is accepted. The SHA-256 pin, checked
+ * by the launcher before anything is unpacked, decides in the end. */
+extern int sceSysmoduleLoadModuleInternal(unsigned int, ...);
+extern int sceSysmoduleGetModuleHandleInternal(uint32_t id, int32_t *handle);
+extern int sceKernelDlsym(int32_t handle, const char *symbol, void **address);
+
+enum {
+    BLUR_HTTPS_NET_POOL = 64 << 10, BLUR_HTTPS_SSL_POOL = 512 << 10,
+    BLUR_HTTPS_HTTP_POOL = 512 << 10, BLUR_HTTPS_BUFFER = 64 << 10,
+    BLUR_HTTPS_TIMEOUT_US = 30000000,
+    /* The reachability check before a download: DNS, then a TCP connect. */
+    BLUR_HTTPS_REACH_RESOLVE_MS = 2500, BLUR_HTTPS_REACH_RESOLVE_US = 2000000,
+    BLUR_HTTPS_REACH_CONNECT_US = 5000000,
+};
+#define BLUR_HTTPS_TOTAL_NS 150000000000ull
+#define BLUR_HTTPS_STALL_NS 30000000000ull
+
+/* Results of blur_host_https_get (audit finding 8), for the launcher:
+ *   0  BLUR_HTTPS_OK             dest is the complete file, no .part left
+ *  -1  BLUR_HTTPS_FAILED         refused input (.part removed), no HTTPS
+ *                                service or a local file error
+ *  -2  BLUR_HTTPS_NO_CONNECTION  the host did not resolve or did not accept
+ *                                a TCP connection within a few seconds,
+ *                                before any request; .part kept as it was
+ *  -3  BLUR_HTTPS_INTERRUPTED    stopped by the 150 s limit, 30 s without
+ *                                data, or a transport error; .part kept
+ *                                (the next call resumes it)
+ *  -4  BLUR_HTTPS_SERVER_ERROR   an answer other than 200 (or 206 to a
+ *                                resume), a body longer than max_bytes or
+ *                                shorter than announced; .part removed
+ *  -5  BLUR_HTTPS_HASH_MISMATCH  not returned here: the title has no pin;
+ *                                reserved for the launcher's own check
+ *  -6  BLUR_HTTPS_CERT_ERROR     the TLS certificate was not accepted
+ *                                (expired / not yet valid / not verified):
+ *                                the console clock is probably wrong;
+ *                                checking stays on; .part kept
+ *  -7  BLUR_HTTPS_RESUME_MISMATCH  a resume answered 206 with a
+ *                                Content-Range that does not continue the
+ *                                .part; .part removed */
+enum {
+    BLUR_HTTPS_OK = 0, BLUR_HTTPS_FAILED = -1, BLUR_HTTPS_NO_CONNECTION = -2, BLUR_HTTPS_INTERRUPTED = -3,
+    BLUR_HTTPS_SERVER_ERROR = -4, BLUR_HTTPS_HASH_MISMATCH = -5, BLUR_HTTPS_CERT_ERROR = -6,
+    BLUR_HTTPS_RESUME_MISMATCH = -7,
+};
+/* libSceHttp / libSceHttps error codes and sceHttpsGetSslError detail bits
+ * (SDK names; only 0x80431068 has been seen on this console so far). */
+#define BLUR_SCE_HTTP_ERROR_SSL        0x80431075u
+#define BLUR_SCE_HTTPS_ERROR_CERT      0x80435060u
+#define BLUR_SCE_HTTPS_ERROR_HANDSHAKE 0x80435061u
+#define BLUR_SCE_HTTPS_SSL_INVALID_CERT 0x02u
+#define BLUR_SCE_HTTPS_SSL_NOT_AFTER    0x08u     /* expired */
+#define BLUR_SCE_HTTPS_SSL_NOT_BEFORE   0x10u     /* not yet valid */
+#define BLUR_SCE_HTTPS_SSL_UNKNOWN_CA   0x20u
+
+static struct {
+    pthread_mutex_t lock;
+    int state, http;                    /* state 1 ready; 0 not yet (retried next call) */
+    int (*net_init)(void);
+    int (*ssl_init)(size_t pool);
+    int (*ssl_term)(int id);
+    int (*http_init)(int net, int ssl, size_t pool);
+    int (*http_term)(int id);
+    int (*create_template)(int http, const char *agent, int version, int auto_proxy);
+    int (*create_connection)(int tmpl, const char *url, int keepalive);
+    int (*create_request)(int conn, int method, const char *url, uint64_t length);
+    int (*send)(int req, const void *data, size_t size);
+    int (*status)(int req, int *code);
+    int (*content_length)(int req, int *result, uint64_t *length);
+    int (*read)(int req, void *data, uint32_t size);
+    int (*resolve_timeout)(int id, uint32_t us);
+    int (*connect_timeout)(int id, uint32_t us);
+    int (*send_timeout)(int id, uint32_t us);
+    int (*recv_timeout)(int id, uint32_t us);
+    int (*auto_redirect)(int id, int enable);
+    int (*delete_request)(int req);
+    int (*delete_connection)(int conn);
+    int (*delete_template)(int tmpl);
+    /* Optional: without the first two no download is resumed (a .part is
+     * started again); without the third a TLS failure is not told apart. */
+    int (*add_header)(int id, const char *name, const char *value, int mode);
+    int (*all_headers)(int req, char **header, size_t *size);
+    int (*ssl_error)(int req, int *error, uint32_t *detail);
+} blur_https = { .lock = PTHREAD_MUTEX_INITIALIZER, .http = -1 };
+
+static int32_t blur_https_module(uint32_t id)
+{
+    int32_t handle = -1;
+    int load = sceSysmoduleLoadModuleInternal(id);
+    int found = sceSysmoduleGetModuleHandleInternal(id, &handle);
+    if (found != 0 || handle < 0) {
+        PS5LOG_LOG("PW_WINE64 launcher https module 0x%08x load=0x%08x handle=0x%08x",
+                   (unsigned)id, (unsigned)load, (unsigned)found);
+        return -1;
+    }
+    return handle;
+}
+
+static int blur_https_init_locked(void)
+{
+    int32_t net = blur_https_module(0x8000001Cu), ssl = blur_https_module(0x8000000Bu),
+            http = blur_https_module(0x8000000Au);
+    int missing = 0, pool = -1, ssl_id = -1;
+    if (net < 0 || ssl < 0 || http < 0) return -1;
+#define BLUR_HTTPS_SYM(field, handle, name) do { void *p_ = NULL; \
+        if (sceKernelDlsym((handle), (name), &p_) != 0 || !p_) { missing++; \
+            PS5LOG_LOG("PW_WINE64 launcher https no %s", (name)); } \
+        else memcpy(&blur_https.field, &p_, sizeof(p_)); } while (0)
+    BLUR_HTTPS_SYM(net_init, net, "sceNetInit");
+    BLUR_HTTPS_SYM(ssl_init, ssl, "sceSslInit");
+    BLUR_HTTPS_SYM(ssl_term, ssl, "sceSslTerm");
+    BLUR_HTTPS_SYM(http_init, http, "sceHttpInit");
+    BLUR_HTTPS_SYM(http_term, http, "sceHttpTerm");
+    BLUR_HTTPS_SYM(create_template, http, "sceHttpCreateTemplate");
+    BLUR_HTTPS_SYM(create_connection, http, "sceHttpCreateConnectionWithURL");
+    BLUR_HTTPS_SYM(create_request, http, "sceHttpCreateRequestWithURL");
+    BLUR_HTTPS_SYM(send, http, "sceHttpSendRequest");
+    BLUR_HTTPS_SYM(status, http, "sceHttpGetStatusCode");
+    BLUR_HTTPS_SYM(content_length, http, "sceHttpGetResponseContentLength");
+    BLUR_HTTPS_SYM(read, http, "sceHttpReadData");
+    BLUR_HTTPS_SYM(resolve_timeout, http, "sceHttpSetResolveTimeOut");
+    BLUR_HTTPS_SYM(connect_timeout, http, "sceHttpSetConnectTimeOut");
+    BLUR_HTTPS_SYM(send_timeout, http, "sceHttpSetSendTimeOut");
+    BLUR_HTTPS_SYM(recv_timeout, http, "sceHttpSetRecvTimeOut");
+    BLUR_HTTPS_SYM(auto_redirect, http, "sceHttpSetAutoRedirect");
+    BLUR_HTTPS_SYM(delete_request, http, "sceHttpDeleteRequest");
+    BLUR_HTTPS_SYM(delete_connection, http, "sceHttpDeleteConnection");
+    BLUR_HTTPS_SYM(delete_template, http, "sceHttpDeleteTemplate");
+#undef BLUR_HTTPS_SYM
+    if (missing) return -1;
+    {   /* optional */
+        void *p = NULL;
+        if (sceKernelDlsym(http, "sceHttpAddRequestHeader", &p) == 0 && p) memcpy(&blur_https.add_header, &p, sizeof(p));
+        p = NULL;
+        if (sceKernelDlsym(http, "sceHttpGetAllResponseHeaders", &p) == 0 && p) memcpy(&blur_https.all_headers, &p, sizeof(p));
+        p = NULL;
+        if (sceKernelDlsym(http, "sceHttpsGetSslError", &p) == 0 && p) memcpy(&blur_https.ssl_error, &p, sizeof(p));
+        PS5LOG_LOG("PW_WINE64 launcher https resume=%d ssl_error=%d",
+                   blur_https.add_header && blur_https.all_headers, blur_https.ssl_error != NULL);
+    }
+    (void)blur_https.net_init();            /* already initialised by the title: not an error */
+    pool = sceNetPoolCreate("blur-https", BLUR_HTTPS_NET_POOL, 0);
+    if (pool >= 0) ssl_id = blur_https.ssl_init(BLUR_HTTPS_SSL_POOL);
+    if (ssl_id >= 0) blur_https.http = blur_https.http_init(pool, ssl_id, BLUR_HTTPS_HTTP_POOL);
+    PS5LOG_LOG("PW_WINE64 launcher https init pool=0x%08x ssl=0x%08x http=0x%08x",
+               (unsigned)pool, (unsigned)ssl_id, (unsigned)blur_https.http);
+    if (blur_https.http >= 0) return 0;
+    if (ssl_id >= 0) (void)blur_https.ssl_term(ssl_id);
+    if (pool >= 0) sceNetPoolDestroy(pool);
+    return -1;
+}
+
+/* The host and port of an https:// URL. 0 ok. */
+static int blur_https_host(const char *url, char *host, size_t cap, int *port)
+{
+    const char *h = url + 8, *end = h + strcspn(h, ":/?#");
+    size_t n = (size_t)(end - h);
+    *port = 443;
+    if (!n || n >= cap) return -1;
+    memcpy(host, h, n);
+    host[n] = 0;
+    if (*end == ':') {
+        char *stop;
+        long p = strtol(end + 1, &stop, 10);
+        if (p <= 0 || p > 65535 || (*stop && *stop != '/' && *stop != '?' && *stop != '#')) return -1;
+        *port = (int)p;
+    }
+    return 0;
+}
+
+/* Fail fast without internet: DNS, then a TCP connect, a few seconds in
+ * all, before libSceHttp's 30 s timeouts. 0 reachable. */
+static int blur_https_reachable(const char *host, int port)
+{
+    BlurNetAddr address;
+    uint32_t addr = 0, timeout = BLUR_HTTPS_REACH_CONNECT_US;
+    int s, rc = -1;
+    if (blur_resolve_ipv4_wait(host, &addr, BLUR_HTTPS_REACH_RESOLVE_MS, BLUR_HTTPS_REACH_RESOLVE_US) != 0) {
+        PS5LOG_LOG("PW_WINE64 launcher https reach resolve failed");
+        return -1;
+    }
+    s = ps5log_ps5_socket(AF_INET, SOCK_STREAM, 0);
+    if (s < 0) return -1;
+    if (ps5log_ps5_setsockopt(s, 0xffff, 0x1109, &timeout, sizeof(timeout)) >= 0) {   /* connect timeout, us */
+        memset(&address, 0, sizeof(address));
+        address.length = sizeof(address);
+        address.family = AF_INET;
+        address.port = (uint16_t)(((port & 0xff) << 8) | ((port >> 8) & 0xff));
+        address.address = addr;
+        rc = ps5log_ps5_connect(s, (const struct sockaddr *)&address, sizeof(address)) < 0 ? -1 : 0;
+    }
+    (void)ps5log_ps5_close(s);
+    if (rc) PS5LOG_LOG("PW_WINE64 launcher https reach connect failed");
+    return rc;
+}
+
+/* "Content-Range: bytes S-E/T" (any case) in a header block. 0 parsed. */
+static int blur_https_content_range(const char *head, size_t size, unsigned long long *start,
+                                    unsigned long long *end, unsigned long long *total)
+{
+    char block[4096];
+    if (!head || !size) return -1;
+    if (size >= sizeof(block)) size = sizeof(block) - 1;
+    memcpy(block, head, size);
+    block[size] = 0;
+    for (const char *line = block; line && *line; ) {
+        if (!strncasecmp(line, "Content-Range:", 14)) {
+            const char *v = line + 14;
+            char *stop;
+            while (*v == ' ' || *v == '\t') v++;
+            if (strncasecmp(v, "bytes", 5)) return -1;
+            v += 5;
+            while (*v == ' ') v++;
+            if (*v < '0' || *v > '9') return -1;
+            *start = strtoull(v, &stop, 10);
+            if (*stop != '-' || stop[1] < '0' || stop[1] > '9') return -1;
+            *end = strtoull(stop + 1, &stop, 10);
+            if (*stop != '/' || stop[1] < '0' || stop[1] > '9') return -1;
+            *total = strtoull(stop + 1, &stop, 10);
+            if (*stop && *stop != '\r' && *stop != '\n' && *stop != ' ') return -1;
+            return 0;
+        }
+        line = strchr(line, '\n');
+        if (line) line++;
+    }
+    return -1;
+}
+
+/* A failed send: a certificate the console would not accept (expired, not
+ * yet valid, not verified) is told apart, as the clock is the likely cause. */
+static int blur_https_cert_failure(int req, int rc)
+{
+    int error = 0;
+    uint32_t detail = 0;
+    int got = blur_https.ssl_error ? blur_https.ssl_error(req, &error, &detail) : -1;
+    PS5LOG_LOG("PW_WINE64 launcher https send=0x%08x ssl_error=0x%08x/0x%08x detail=0x%x", (unsigned)rc,
+               (unsigned)got, (unsigned)error, (unsigned)detail);
+    if ((unsigned)rc == BLUR_SCE_HTTPS_ERROR_CERT || (got == 0 && (unsigned)error == BLUR_SCE_HTTPS_ERROR_CERT))
+        return 1;
+    if (((unsigned)rc == BLUR_SCE_HTTP_ERROR_SSL || (unsigned)rc == BLUR_SCE_HTTPS_ERROR_HANDSHAKE) && got == 0 &&
+        (detail & (BLUR_SCE_HTTPS_SSL_INVALID_CERT | BLUR_SCE_HTTPS_SSL_NOT_AFTER | BLUR_SCE_HTTPS_SSL_NOT_BEFORE |
+                   BLUR_SCE_HTTPS_SSL_UNKNOWN_CA)))
+        return 1;
+    return 0;
+}
+
+/* GET url (https:// only) into dest+".part", at most max_bytes, renamed to
+ * dest (the final path) when complete. A .part left by an interrupted call
+ * is resumed with Range: bytes=<size>-; a 206 must continue it exactly
+ * (Content-Range start = its size, end = total - 1, total <= max_bytes),
+ * a 200 starts it again from 0 (never appended to). Results: BLUR_HTTPS_*
+ * above; only a complete download replaces dest. */
+static int blur_host_https_get(void *ctx, const char *url, const char *dest, long long max_bytes,
+                               void (*prog)(void *, long long, long long), void *pctx)
+{
+    char part[512], host[256], range[48];
+    int tmpl = -1, conn = -1, req = -1, code = 0, rc = BLUR_HTTPS_FAILED, step = 0, last = 0, has_length = -1;
+    int port = 443, keep_part = 0, resume = 0;
+    uint64_t length = 0, started = now_ns(), progress_ns = started, now = started;
+    long long got = 0, total = -1, have = 0;
+    uint8_t *buffer = NULL;
+    FILE *file = NULL;
+    int ready, have_part = 0;
+    struct stat st;
+    (void)ctx;
+    if (!dest || snprintf(part, sizeof(part), "%s.part", dest) >= (int)sizeof(part)) goto done;
+    step = 1;
+    if (!url || strncmp(url, "https://", 8) || max_bytes <= 0 ||
+        blur_https_host(url, host, sizeof(host), &port) != 0) {
+        have_part = 1;                      /* refused input: no stale .part either */
+        goto done;
+    }
+    keep_part = 1;                          /* from here a failure before the request keeps it */
+    have_part = 1;
+    step = 19;
+    if (blur_https_reachable(host, port) != 0) { rc = BLUR_HTTPS_NO_CONNECTION; goto done; }
+    pthread_mutex_lock(&blur_https.lock);
+    if (blur_https.state != 1 && blur_https_init_locked() == 0) blur_https.state = 1;
+    ready = blur_https.state == 1;
+    pthread_mutex_unlock(&blur_https.lock);
+    step = 2;
+    if (!ready) { keep_part = 0; goto done; }
+    /* A .part to resume: a regular file, shorter than the limit. */
+    if (stat(part, &st) == 0 && S_ISREG(st.st_mode) && st.st_size > 0 && st.st_size < max_bytes &&
+        blur_https.add_header && blur_https.all_headers && access(part, W_OK) == 0)
+        have = (long long)st.st_size;
+    else (void)remove(part);
+    step = 3;
+    if ((last = tmpl = blur_https.create_template(blur_https.http, "JkFlow", 2 /* HTTP/1.1 */, 1)) < 0) goto done;
+    step = 4;
+    if ((last = blur_https.resolve_timeout(tmpl, BLUR_HTTPS_TIMEOUT_US)) < 0 ||
+        (last = blur_https.connect_timeout(tmpl, BLUR_HTTPS_TIMEOUT_US)) < 0 ||
+        (last = blur_https.send_timeout(tmpl, BLUR_HTTPS_TIMEOUT_US)) < 0 ||
+        (last = blur_https.recv_timeout(tmpl, BLUR_HTTPS_TIMEOUT_US)) < 0 ||
+        (last = blur_https.auto_redirect(tmpl, 0)) < 0) goto done;
+    step = 5;
+    if ((last = conn = blur_https.create_connection(tmpl, url, 1)) < 0) goto done;
+    step = 6;
+    if ((last = req = blur_https.create_request(conn, 0 /* GET */, url, 0)) < 0) goto done;
+    if (have) {
+        snprintf(range, sizeof(range), "bytes=%lld-", have);
+        if ((last = blur_https.add_header(req, "Range", range, 0 /* overwrite */)) < 0) goto done;
+    }
+    step = 7;
+    if ((last = blur_https.send(req, NULL, 0)) < 0) {
+        rc = blur_https_cert_failure(req, last) ? BLUR_HTTPS_CERT_ERROR : BLUR_HTTPS_INTERRUPTED;
+        goto done;
+    }
+    progress_ns = now = now_ns();
+    if (now - started > BLUR_HTTPS_TOTAL_NS) { step = 17; rc = BLUR_HTTPS_INTERRUPTED; goto done; }
+    step = 8;
+    keep_part = 0;                          /* the server answered: from here the answer decides */
+    if ((last = blur_https.status(req, &code)) < 0) goto done;
+    if (code != 200 && !(code == 206 && have)) { rc = BLUR_HTTPS_SERVER_ERROR; goto done; }
+    step = 9;
+    if ((last = blur_https.content_length(req, &has_length, &length)) < 0) goto done;
+    if (code == 206) {
+        char *head = NULL;
+        size_t head_size = 0;
+        unsigned long long first = 0, end = 0, whole = 0;
+        step = 20;
+        rc = BLUR_HTTPS_RESUME_MISMATCH;
+        if ((last = blur_https.all_headers(req, &head, &head_size)) < 0 ||
+            blur_https_content_range(head, head_size, &first, &end, &whole) != 0 ||
+            first != (unsigned long long)have || end < first || end + 1 != whole || whole > (unsigned long long)max_bytes ||
+            (has_length == 0 && length != whole - first)) {
+            PS5LOG_LOG("PW_WINE64 launcher https resume refused: part=%lld range=%llu-%llu/%llu", have,
+                       first, end, whole);
+            goto done;
+        }
+        rc = BLUR_HTTPS_FAILED;
+        got = have;
+        total = (long long)whole;
+        if (!(file = fopen(part, "ab"))) goto done;
+    } else {
+        if (has_length == 0) {
+            if (length > (uint64_t)max_bytes) { rc = BLUR_HTTPS_SERVER_ERROR; goto done; }
+            total = (long long)length;
+        }
+        if (have) PS5LOG_LOG("PW_WINE64 launcher https resume answered 200: from 0");
+        if (!(file = fopen(part, "wb"))) goto done;   /* a 200 starts again, never appended */
+    }
+    resume = code == 206;
+    step = 10;
+    if (!(buffer = malloc(BLUR_HTTPS_BUFFER))) goto done;
+    step = 11;
+    for (;;) {
+        int n = last = blur_https.read(req, buffer, BLUR_HTTPS_BUFFER);
+        if (n < 0) { rc = BLUR_HTTPS_INTERRUPTED; keep_part = 1; goto done; }
+        now = now_ns();
+        if (now - started > BLUR_HTTPS_TOTAL_NS) { step = 17; rc = BLUR_HTTPS_INTERRUPTED; keep_part = 1; goto done; }
+        if (now - progress_ns > BLUR_HTTPS_STALL_NS) { step = 18; rc = BLUR_HTTPS_INTERRUPTED; keep_part = 1; goto done; }
+        if (n == 0) break;
+        progress_ns = now;
+        if ((long long)n > max_bytes - got) { step = 12; rc = BLUR_HTTPS_SERVER_ERROR; goto done; }
+        if (fwrite(buffer, 1, (size_t)n, file) != (size_t)n) { step = 13; goto done; }
+        got += n;
+        if (prog) prog(pctx, got, total);
+    }
+    step = 14;
+    if (total >= 0 && got != total) { rc = BLUR_HTTPS_SERVER_ERROR; goto done; }
+    step = 15;
+    last = fclose(file);
+    file = NULL;
+    if (last != 0) goto done;
+    step = 16;
+    if (rename(part, dest) != 0) {
+        (void)remove(dest);
+        if (rename(part, dest) != 0) goto done;
+    }
+    rc = BLUR_HTTPS_OK;
