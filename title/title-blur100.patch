+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Copyright 2026 XxXJoker13XxX and contributors */
+#include "blur100-display-name.h"
+#include <orbis/UserService.h>
+
+/* The same foreground local user as pad/HID startup; the existing lifecycle
+ * owns UserService init/terminate. */
+int pw_blur100_display_name_from_orbis(PwBlurName *out, int *sanitized)
+{
+    static const PwBlurNameOps ops = { sceUserServiceGetForegroundUser, sceUserServiceGetUserName };
