+/* 1 when dir holds an entry named name in any letter case; found (may be
+ * NULL) then gets dir/<that spelling>. */
+static int blur_dir_has_ci(const char *dir, const char *name, char *found, size_t cap)
+{
+    DIR *d = opendir(dir);
+    struct dirent *e;
+    int hit = 0;
+
+    if (!d) return 0;
+    while (!hit && (e = readdir(d)) != NULL)
+        if (!strcasecmp(e->d_name, name)) {
+            hit = 1;
+            if (found && snprintf(found, cap, "%s/%s", dir, e->d_name) >= (int)cap) hit = -1;
+        }
+    closedir(d);
+    return hit;
