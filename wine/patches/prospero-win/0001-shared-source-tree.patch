diff --git a/wine/patches/0743-ntdll-survive-a-null-environ.patch b/wine/patches/0743-ntdll-survive-a-null-environ.patch
new file mode 100644
--- /dev/null
+++ b/wine/patches/0743-ntdll-survive-a-null-environ.patch
@@ -0,0 +1,63 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: ps4-gladius <ps4-gladius@invalid>
+Date: Thu, 8 Oct 2026 10:10:00 +0000
+Subject: [PATCH] ntdll: survive a NULL environ.
+
+The client and the in-process server now complete their handshake --
+
+    WINE wine startup: server connected
+
+-- and start_main_thread carries on to get_initial_environment, which faults at
+address 0:
+
+    PW_WINE64 fault signal=0xb addr=0x0 rip=0x800884612   (env.c:877)
+
+    for (e = environ; *e; e++) *size += strlen(*e) + 6;
+
+environ is NULL. A title inherits no environment, and this module's libc leaves
+the list NULL until something writes to it -- pw_ps4_setenv, which the title
+calls through the module's descriptor, because each module otherwise carries a
+private one. Wine takes POSIX at its word and dereferences it unguarded.
+
+Carry on with an empty environment instead of dying, and say so once through
+klog. This is not the whole story: an empty environment means no WINEPREFIX and
+no HOME, so Wine will go looking for its prefix somewhere else. The title's own
+"environment status=0" covers only its setenv and never the module's, so
+pw_prx_env_ps4.c now reports what reached this environ -- "never called" and
+"called and did not take" have looked identical until now.
+---
+diff --git a/dlls/ntdll/unix/env.c b/dlls/ntdll/unix/env.c
+index 1d289007c7..1ac16ed28b 100644
+--- a/dlls/ntdll/unix/env.c
++++ b/dlls/ntdll/unix/env.c
+@@ -872,14 +872,28 @@ static WCHAR *get_initial_environment( SIZE_T *pos, SIZE_T *size )
+     char **e;
+     WCHAR *env, *ptr, *end;
+ 
++#ifdef __PROSPERO__
++    /* ⚠ A title has no environment to inherit, and this module's libc leaves
++     * environ NULL until something writes to it (pw_ps4_setenv, which the title
++     * calls through the module's descriptor). Wine assumes POSIX gives it a
++     * list and walked straight into the NULL here, faulting at address 0 with
++     * the whole client/server handshake already behind it. Say so and carry on
++     * with an empty environment rather than die. */
++    if (!environ)
++    {
++        extern int sceKernelDebugOutText( int channel, const char *text );
++        sceKernelDebugOutText( 0, "wine: environ is NULL; starting with an empty environment\n" );
++    }
++#endif
++
+     /* estimate needed size */
+     *size = 1;
+-    for (e = environ; *e; e++) *size += strlen(*e) + 6;
++    for (e = environ; e && *e; e++) *size += strlen(*e) + 6;
+ 
+     env = malloc( *size * sizeof(WCHAR) );
+     ptr = env;
+     end = env + *size - 1;
+-    for (e = environ; *e && ptr < end; e++)
++    for (e = environ; e && *e && ptr < end; e++)
+     {
+         char *str = *e;
+ 
diff --git a/wine/patches/0744-ntdll-usd-maps-a-host-page.patch b/wine/patches/0744-ntdll-usd-maps-a-host-page.patch
new file mode 100644
--- /dev/null
+++ b/wine/patches/0744-ntdll-usd-maps-a-host-page.patch
@@ -0,0 +1,65 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: ps4-gladius <ps4-gladius@invalid>
+Date: Thu, 8 Oct 2026 10:40:00 +0000
+Subject: [PATCH] ntdll: map the user shared data a whole host page at a time.
+
+With the environment reaching Wine, it finds its prefix, decides the prefix
+needs wineboot, and stops there:
+
+    err:virtual:virtual_init_user_shared_data failed to remap the process USD: 0
+
+res is 0, so server_get_unix_fd worked and it is the mmap that failed -- which
+the message could not say, because it only ever prints res.
+
+The length is the likely reason: it asks for sizeof(KUSER_SHARED_DATA), and this
+console's pages are 16 KiB, so that is not a whole page. The section is exactly
+one host page wide (patch 0102), so map it that way. virtual_map_user_shared_data
+already passes a page-sized length and is reached first, without complaint.
+
+Both messages now print errno as well, so if the length was not the reason the
+next run says what was.
+---
+diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
+index aba21c6f4b..2cf071d0e2 100644
+--- a/dlls/ntdll/unix/virtual.c
++++ b/dlls/ntdll/unix/virtual.c
+@@ -4799,7 +4799,11 @@ void virtual_map_user_shared_data(void)
+     if ((res = server_get_unix_fd( section, 0, &fd, &needs_close, NULL, NULL )) ||
+         (user_shared_data != mmap( user_shared_data, page_size, PROT_READ, MAP_SHARED|MAP_FIXED, fd, 0 )))
+     {
++#ifdef __PROSPERO__
++        ERR( "failed to remap the process USD: %d errno %d\n", res, errno );
++#else
+         ERR( "failed to remap the process USD: %d\n", res );
++#endif
+         exit(1);
+     }
+     if (needs_close) close( fd );
+@@ -4827,12 +4831,27 @@ void virtual_init_user_shared_data(void)
+         ERR( "failed to open the USD section: %08x\n", status );
+         exit(1);
+     }
++#ifdef __PROSPERO__
++    /* ⚠ Map a whole host page. This console's pages are 16 KiB, and the
++     * section is exactly one of them (patch 0102); mmap refuses a length that
++     * is not a multiple of a page. The error below prints errno too, because
++     * res is 0 whenever it is the mmap rather than the fd that failed. */
++    if ((res = server_get_unix_fd( section, 0, &fd, &needs_close, NULL, NULL )) ||
++        (data = mmap( NULL, (sizeof(*data) + host_page_size - 1) & ~(host_page_size - 1),
++                      PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0 )) == MAP_FAILED)
++    {
++        ERR( "failed to remap the process USD: %d errno %d size %u host_page %u\n",
++             res, errno, (unsigned int)sizeof(*data), (unsigned int)host_page_size );
++        exit(1);
++    }
++#else
+     if ((res = server_get_unix_fd( section, 0, &fd, &needs_close, NULL, NULL )) ||
+         (data = mmap( NULL, sizeof(*data), PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0 )) == MAP_FAILED)
+     {
+         ERR( "failed to remap the process USD: %d\n", res );
+         exit(1);
+     }
++#endif
+     if (needs_close) close( fd );
+     NtClose( section );
+ 
diff --git a/wine/patches/0745-ntdll-client-does-not-own-server-fds.patch b/wine/patches/0745-ntdll-client-does-not-own-server-fds.patch
new file mode 100644
--- /dev/null
+++ b/wine/patches/0745-ntdll-client-does-not-own-server-fds.patch
@@ -0,0 +1,75 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: ps4-gladius <ps4-gladius@invalid>
+Date: Thu, 8 Oct 2026 10:55:00 +0000
+Subject: [PATCH] ntdll: the client does not own the descriptors the server sends.
+
+0744 added errno to the failure and it answered a different question than the
+one asked:
+
+    failed to remap the process USD: 0 errno 9 size 1848 host_page 16384
+
+errno 9 is EBADF. The length was never the problem -- the descriptor was.
+
+server_get_unix_fd hands the caller a descriptor and a needs_close telling it to
+close it afterwards, which is right when the server sent a duplicate. Nothing
+can be duplicated on this console, so send_client_fd hands over the descriptor
+itself (0737, 0738), and closing it closes the server's. The user shared data
+shows it plainly: virtual_map_user_shared_data maps the section, closes the
+descriptor on its way out, and the next caller asks the server for the same
+object and gets a number that is no longer open.
+
+The server owns these and closes them with the object, so the client closes
+none of them: not on needs_close, and not when a cache entry is evicted.
+
+The 16 KiB rounding 0744 added stays -- the section is a host page wide (0102)
+and mapping it whole is correct either way.
+---
+diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
+index ceb82e7182..5747dd9089 100644
+--- a/dlls/ntdll/unix/server.c
++++ b/dlls/ntdll/unix/server.c
+@@ -1285,6 +1285,16 @@ int server_get_unix_fd( HANDLE handle, unsigned int wanted_access, int *unix_fd,
+                     *needs_close = (!reply->cacheable ||
+                                     !add_fd_to_cache( handle, fd, reply->type,
+                                                       reply->access, reply->options ));
++#ifdef __PROSPERO__
++                    /* ⚠ This descriptor is the server's own, not a copy of it:
++                     * nothing can be duplicated on this console, so the server
++                     * hands the descriptor itself over (see wine_server_send_fd
++                     * and send_client_fd). Closing it here closes the server's,
++                     * and the next request for the same object answers with a
++                     * number that is no longer open. The server owns these and
++                     * closes them with the object. */
++                    *needs_close = 0;
++#endif
+                 }
+                 else ret = STATUS_TOO_MANY_OPENED_FILES;
+             }
+@@ -2105,7 +2115,13 @@ NTSTATUS WINAPI NtDuplicateObject( HANDLE source_process, HANDLE source, HANDLE
+ 
+     server_leave_uninterrupted_section( &fd_cache_mutex, &sigset );
+ 
++#ifndef __PROSPERO__
++    /* the cache held a copy of the server's descriptor; here it holds the
++     * server's own -- see server_get_unix_fd */
+     if (fd != -1) close( fd );
++#else
++    (void)fd;
++#endif
+     return ret;
+ }
+ 
+@@ -2170,7 +2186,13 @@ NTSTATUS WINAPI NtClose( HANDLE handle )
+ 
+     server_leave_uninterrupted_section( &fd_cache_mutex, &sigset );
+ 
++#ifndef __PROSPERO__
++    /* as above: evicting the cache entry does not close the server's own
++     * descriptor, which it closes with the object */
+     if (fd != -1) close( fd );
++#else
++    (void)fd;
++#endif
+ 
+     if (ret != STATUS_INVALID_HANDLE || !handle) return ret;
+     if (!peb->BeingDebugged) return ret;
diff --git a/wine/patches/0746-ntdll-prefix-arrives-booted.patch b/wine/patches/0746-ntdll-prefix-arrives-booted.patch
new file mode 100644
--- /dev/null
+++ b/wine/patches/0746-ntdll-prefix-arrives-booted.patch
@@ -0,0 +1,52 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: ps4-gladius <ps4-gladius@invalid>
+Date: Thu, 8 Oct 2026 11:20:00 +0000
+Subject: [PATCH] ntdll: the prefix arrives booted, so do not run wineboot.
+
+With the user shared data mapped (0744, 0745), Wine reaches the end of its
+process initialisation and stops at the one thing a title cannot do:
+
+    trace:process:NtCreateUserProcess process creation is not supported on PS5
+    err:environ:run_wineboot failed to start wineboot c00000bb
+
+c00000bb is STATUS_NOT_SUPPORTED. wineboot is a separate executable, and
+NtCreateUserProcess has never been available here.
+
+It also has nothing to do. The prefix is built by Wine on a host and copied to
+the console whole -- registry, system32 and all -- so it arrives in the state
+wineboot would leave it in. Signal the event the rest of the process waits on
+and return.
+
+Falling through instead would wait the full five minutes for a process that
+cannot start, report a timeout, and carry on anyway.
+
+virtual_init_user_shared_data still runs: it fills in the shared data the
+process needs regardless of who booted the prefix.
+---
+diff --git a/dlls/ntdll/unix/env.c b/dlls/ntdll/unix/env.c
+index 1ac16ed28b..5d2b5252c4 100644
+--- a/dlls/ntdll/unix/env.c
++++ b/dlls/ntdll/unix/env.c
+@@ -1582,6 +1582,22 @@ static void run_wineboot( WCHAR *env, SIZE_T size )
+     }
+ 
+     virtual_init_user_shared_data();
++
++#ifdef __PROSPERO__
++    /* ⚠ A title cannot create a process -- NtCreateUserProcess answers
++     * STATUS_NOT_SUPPORTED -- so wineboot cannot run here:
++     *
++     *     trace:process:NtCreateUserProcess process creation is not supported
++     *     err:environ:run_wineboot failed to start wineboot c00000bb
++     *
++     * It has nothing to do either. The prefix is built by Wine on a host and
++     * copied to the console whole, registry and all, so it arrives booted.
++     * Signal the event the rest of the process waits on and carry on; falling
++     * through would wait five minutes for a process that cannot start. */
++    NtSetEvent( handles[0], NULL );
++    goto wait;
++#endif
++
+     env[size] = 0;
+     params.Flags           = PROCESS_PARAMS_FLAG_NORMALIZED;
+     params.Environment     = env;
diff --git a/wine/patches/0747-ntdll-no-auxiliary-vector.patch b/wine/patches/0747-ntdll-no-auxiliary-vector.patch
new file mode 100644
--- /dev/null
+++ b/wine/patches/0747-ntdll-no-auxiliary-vector.patch
@@ -0,0 +1,44 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: ps4-gladius <ps4-gladius@invalid>
+Date: Thu, 8 Oct 2026 11:50:00 +0000
+Subject: [PATCH] ntdll: report no image address; there is no auxiliary vector.
+
+With the mapping fixed, load_main_exe maps Oblivion and start_main_thread
+carries on to get_image_address, which faults at address 0:
+
+    PW_WINE64 fault signal=0xb addr=0x0 rip=0x8008ef49a
+                                        ntdll+0xbf49a = __getauxval
+
+A title has no auxiliary vector, and this console's getauxval does not answer
+that with 0 -- it dereferences and faults. Report no image address instead,
+which is what every platform without an auxv does here; the value only reaches
+peb->CloudFileFlags.
+
+Only this caller is affected. The auxv is read in three other places and none
+is reachable: one is behind __linux__ and this is FreeBSD, and the other two
+are on the ARM feature paths.
+---
+diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
+index 592889315e..e90f83c79e 100644
+--- a/dlls/ntdll/unix/loader.c
++++ b/dlls/ntdll/unix/loader.c
+@@ -1839,7 +1839,18 @@ static void load_wow64_ntdll( USHORT machine )
+  */
+ static ULONG_PTR get_image_address(void)
+ {
+-#ifdef HAVE_GETAUXVAL
++#ifdef __PROSPERO__
++    /* ⚠ A title has no auxiliary vector, and this console's getauxval does
++     * not answer that with 0 -- it faults:
++     *
++     *     fault signal=0xb addr=0x0 rip=0x8008ef49a  (__getauxval)
++     *
++     * Report no image address, which is what every platform without an auxv
++     * does here. Only this caller is affected: the auxv is read in three other
++     * places and all of them are out of reach -- one behind __linux__, two on
++     * the ARM feature paths. */
++    return 0;
++#elif defined(HAVE_GETAUXVAL)
+     ULONG_PTR size, num, phdr_addr = getauxval( AT_PHDR );
+     ElfW(Phdr) *phdr;
+ 
