 esac
+# Task 245: the launcher patch calls the first-launch seed importer, so its
+# source must be present; a package that carries the Blur seed also pins the
+# seed index END hash into it (native245_seed.h). Without N245_SEED_DIR the
+# importer is compiled in but disabled.
+[[ -f $PW/native/native245_seed.c && -f $PW/native/native245_seed.h ]] || {
+  echo "missing $PW/native/native245_seed.{c,h} (task 245 launcher patch)" >&2; exit 2;
+}
+N245_DEF=""
+if [[ -n ${N245_SEED_DIR:-} ]]; then
+  [[ ${N245_SEED_END:-} =~ ^[0-9a-f]{64}$ ]] || { echo "N245_SEED_DIR needs N245_SEED_END (64 lowercase hex)" >&2; exit 2; }
+  [[ $N245_SEED_DIR == /* && -f $N245_SEED_DIR/seed245/blur-native/seed.idx && -f $N245_SEED_DIR/runtime-pins.sha256 ]] || {
+    echo "N245_SEED_DIR is not an absolute native245_stage seed: $N245_SEED_DIR" >&2; exit 2;
+  }
+  N245_DEF="-DN245_SEED_END=\"$N245_SEED_END\""
+fi
 CFL="-std=gnu11 -O2 -fPIC -DPW_BUILD_ID=\"${PW_BUILD_ID:-unknown-local}\" -DPW_WINE64_WAIT_WATCHDOG=$PW_WINE64_WAIT_WATCHDOG -DPW_WINE64_SERVER_DIRECT_OFF=$PW_WINE64_SERVER_DIRECT_OFF -DPW_WINE64_HEAP_FLEXIBLE=$PW_WINE64_HEAP_FLEXIBLE $INC $PS5LOG_NET"
 
 say "compile: portable core (DBT + launcher) and the portable half of native/"
+CFL="$CFL $N245_DEF"
 for f in "$PW"/src/*.c "$PW"/native/wine64_main.c "$PW"/native/pw_data_mount.c \
          "$PW"/native/pw_diagnostics.c "$PW"/native/pw_wine_display.c \
          "$PW"/native/pw_wine_library.c "$PW"/native/pw_wine_prefix.c \
-         "$PW"/native/pw_osk_ps5.c "$PW"/native/ps5log/*.c; do
+         "$PW"/native/pw_osk_ps5.c "$PW"/native/native245_seed.c "$PW"/native/ps5log/*.c; do
   [ -f "$f" ] || continue
   $CC $CFL -c "$f" -o "$OBJ/$(echo "${f#$PW/}" | tr '/' '_' | sed 's/\.c$/.o/')"
 done
@@ -249,6 +265,16 @@
   done
   (( font_count > 0 )) || { echo "   X no Wine TTF fonts in $FONTDIR" >&2; exit 1; }
   printf '   fonts: %s shared runtime TTFs\n' "$font_count"
+  # Task 245: the Blur first-launch seed (native245_stage output). Its runtime
+  # entries name the PE files packaged below, so it adds only registry/metadata.
+  if [[ -n ${N245_SEED_DIR:-} ]]; then
