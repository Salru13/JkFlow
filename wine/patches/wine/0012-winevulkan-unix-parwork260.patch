diff --git a/dlls/winevulkan/pw_vk_async_multi.h b/dlls/winevulkan/pw_vk_async_multi.h
new file mode 100644
--- /dev/null
+++ b/dlls/winevulkan/pw_vk_async_multi.h
@@ -0,0 +1,310 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Parallel Vulkan replay: N ordered worker queues, each owning whole command pools.
+ *
+ * A batch is split by owning worker, keeping stream order within every worker:
+ *   command-buffer records        -> the worker of the buffer's pool
+ *   descriptor-template updates   -> the worker of the last routed command record
+ *   anything else                 -> the whole batch is "blocking": nothing is queued
+ *                                    and the caller drains and replays inline (as today)
+ * Waits can target one worker, the owners of given command buffers, or all.
+ * Callers are serialised by the PE batch gate. See
+ * docs/superpowers/plans/2026-11-11-parallel-native-recording.md.
+ */
+#ifndef PW_VK_ASYNC_MULTI_H
+#define PW_VK_ASYNC_MULTI_H
+
+#include <time.h>
+#include "pw_vk_async_core.h"
+#include "pw_vk_async_route.h"
+#include "pw_vk_command_stream.h"
+
+typedef int (*pw_multi_classify)(void *ctx, const struct pw_vk_stream_record *r, uint64_t *cb);
+/* Optional exact descriptor routing: the set a descriptor record updates (returns 1), and the sets
+ * a command record binds (count written to sets). Without them, descriptor records follow the
+ * next command record. */
+typedef int (*pw_multi_descriptor_set)(void *ctx, const struct pw_vk_stream_record *r, uint64_t *set);
+typedef unsigned (*pw_multi_bound_sets)(void *ctx, const struct pw_vk_stream_record *r, uint64_t *sets, unsigned max);
+enum { PW_MULTI_CB = 0, PW_MULTI_DESCRIPTOR = 1, PW_MULTI_BLOCKING = 2 };
+
+struct pw_async_multi;
+struct pw_multi_slot { struct pw_async_multi *m; unsigned worker; };
+
+struct pw_async_multi {
+    unsigned workers;
+    struct pw_async q[PW_ROUTE_MAX_WORKERS];
+    struct pw_route route;
+    _Atomic uint64_t busy_ns[PW_ROUTE_MAX_WORKERS];   /* time inside run() per worker */
+    _Atomic uint64_t jobs[PW_ROUTE_MAX_WORKERS];      /* sub-batches run per worker */
+    pw_async_run run;
+    void *ctx;
+    struct pw_multi_slot slot[PW_ROUTE_MAX_WORKERS];
+    unsigned char *scratch[PW_ROUTE_MAX_WORKERS];
+    size_t scratch_used[PW_ROUTE_MAX_WORKERS];
+    size_t scratch_capacity;
+    pw_multi_descriptor_set descriptor_set;
+    pw_multi_bound_sets bound_sets;
+    int last_bind_worker;   /* worker of the last command record that bound descriptor sets */
+};
+
+static void pw_multi_set_matching(struct pw_async_multi *m, pw_multi_descriptor_set d, pw_multi_bound_sets b)
+{
+    m->descriptor_set = d;
+    m->bound_sets = b;
+}
+
+static inline uint64_t pw_multi_now(void)
+{
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return (uint64_t)t.tv_sec * 1000000000u + (uint64_t)t.tv_nsec;
+}
+
+static int pw_multi_run(void *context, const void *bytes, size_t size)
+{
+    struct pw_multi_slot *s = context;
+    uint64_t start = pw_multi_now();
+    int failed = s->m->run(s->m->ctx, bytes, size);
+    atomic_fetch_add(&s->m->busy_ns[s->worker], pw_multi_now() - start);
+    atomic_fetch_add(&s->m->jobs[s->worker], 1);
+    return failed;
+}
+
+/* ring_bytes is split evenly between the workers. Returns 0, or -1 when a
+ * worker could not start (the caller then stays synchronous). */
+static int pw_multi_start(struct pw_async_multi *m, unsigned workers, size_t ring_bytes,
+                          pw_async_run run, void *ctx)
+{
+    memset(m, 0, sizeof(*m));
+    pw_route_init(&m->route, workers);
+    m->workers = m->route.workers;
+    m->run = run;
+    m->ctx = ctx;
+    m->scratch_capacity = ring_bytes / m->workers / 2;
+    m->last_bind_worker = -1;
+    for (unsigned w = 0; w < m->workers; w++) {
+        m->slot[w] = (struct pw_multi_slot){ m, w };
+        if (!(m->scratch[w] = malloc(m->scratch_capacity)) ||
+            pw_async_start(&m->q[w], ring_bytes / m->workers, pw_multi_run, &m->slot[w])) {
+            for (unsigned k = 0; k < w; k++) pw_async_shutdown(&m->q[k]);
+            for (unsigned k = 0; k <= w; k++) free(m->scratch[k]);
+            return -1;
+        }
+    }
+    return 0;
+}
+
+#define PW_MULTI_PENDING 64u
+struct pw_multi_scan {
+    struct pw_async_multi *m;
+    pw_multi_classify classify;
+    void *ctx;
+    /* Descriptor updates wait here for the next command record, so they land on the
+     * worker of the buffer that binds them (DXVK updates a set just before its bind). */
+    const unsigned char *pending[PW_MULTI_PENDING];
+    uint64_t pending_set[PW_MULTI_PENDING];
+    size_t pending_pos[PW_MULTI_PENDING][PW_ROUTE_MAX_WORKERS];   /* each worker's fill when it appeared */
+    unsigned char pending_keyed[PW_MULTI_PENDING];
+    unsigned pending_n;
+};
+
+static int pw_multi_append(struct pw_multi_scan *s, int worker, const unsigned char *start)
+{
+    uint32_t total;
+    memcpy(&total, start + 8, 4);   /* little-endian framing, record size incl. padding */
+    if (s->m->scratch_used[worker] + total > s->m->scratch_capacity) return 1;
+    memcpy(s->m->scratch[worker] + s->m->scratch_used[worker], start, total);
+    s->m->scratch_used[worker] += total;
+    return 0;
+}
+
+/* Place pending record i on `worker` at its stream position (where that worker's sub-batch
+ * stood when the record appeared), so every sub-batch keeps the original record order. */
+static int pw_multi_place(struct pw_multi_scan *s, unsigned i, int worker)
+{
+    const unsigned char *start = s->pending[i];
+    unsigned char *base = s->m->scratch[worker];
+    size_t at = s->pending_pos[i][worker], used = s->m->scratch_used[worker];
+    uint32_t total;
+    memcpy(&total, start + 8, 4);
+    if (used + total > s->m->scratch_capacity || at > used) return 1;
+    memmove(base + at + total, base + at, used - at);
+    memcpy(base + at, start, total);
+    s->m->scratch_used[worker] = used + total;
+    for (unsigned k = i + 1; k < s->pending_n; k++)   /* later records come after this one */
+        s->pending_pos[k][worker] += total;
+    return 0;
+}
+
+/* Before a command record on `worker`: unkeyed pending records always go with it; keyed ones
+ * only when the record binds their set. What stays pending keeps its order and positions. */
+static int pw_multi_flush_matching(struct pw_multi_scan *s, int worker, const uint64_t *sets, unsigned n)
+{
+    unsigned keep = 0;
+    for (unsigned i = 0; i < s->pending_n; i++) {
+        int go = !s->pending_keyed[i];
+        for (unsigned k = 0; !go && k < n; k++) go = sets[k] == s->pending_set[i];
+        if (go) {
+            if (pw_multi_place(s, i, worker)) return 1;
+        } else {
+            if (keep != i) {
+                s->pending[keep] = s->pending[i];
+                s->pending_set[keep] = s->pending_set[i];
+                s->pending_keyed[keep] = s->pending_keyed[i];
+                memcpy(s->pending_pos[keep], s->pending_pos[i], sizeof(s->pending_pos[i]));
+            }
+            keep++;
+        }
+    }
+    s->pending_n = keep;
+    return 0;
+}
+
+static int pw_multi_flush_pending(struct pw_multi_scan *s, int worker)
+{
+    for (unsigned i = 0; i < s->pending_n; i++)
+        if (pw_multi_place(s, i, worker)) return 1;
+    s->pending_n = 0;
+    return 0;
+}
+
+static int pw_multi_leftover_worker(const struct pw_async_multi *m)
+{
+    return m->last_bind_worker >= 0 ? m->last_bind_worker : pw_route_descriptor_worker(&m->route);
+}
+
+static int pw_multi_scan_record(struct pw_multi_scan *s, const struct pw_vk_stream_record *r)
+{
+    uint64_t cb = 0;
+    int kind = s->classify(s->ctx, r, &cb), worker;
+
+    if (kind == PW_MULTI_BLOCKING) return 1;
+    if (kind == PW_MULTI_DESCRIPTOR) {
+        uint64_t set = 0;
+        int keyed = s->m->descriptor_set && s->m->descriptor_set(s->ctx, r, &set);
+        if (s->pending_n == PW_MULTI_PENDING) {
+            worker = pw_multi_leftover_worker(s->m);
+            if (worker < 0 || pw_multi_flush_pending(s, worker)) return 1;
+        }
+        s->pending[s->pending_n] = r->payload - PW_VK_STREAM_HEADER;
+        s->pending_set[s->pending_n] = set;
+        s->pending_keyed[s->pending_n] = (unsigned char)keyed;
+        for (unsigned w = 0; w < s->m->workers; w++) s->pending_pos[s->pending_n][w] = s->m->scratch_used[w];
+        s->pending_n++;
+        return 0;
+    }
+    worker = pw_route_worker_for_cb(&s->m->route, cb);
+    {
+        uint64_t sets[16];
+        unsigned n = s->m->bound_sets ? s->m->bound_sets(s->ctx, r, sets, 16) : 0;
+        if (n) s->m->last_bind_worker = worker;
+        if (s->pending_n && pw_multi_flush_matching(s, worker, sets, n)) return 1;
+    }
+    return pw_multi_append(s, worker, r->payload - PW_VK_STREAM_HEADER);
+}
+
+/* One pass over a batch the caller has already validated (pw_vk_stream_replay /
+ * pw_vk_stream_validate); only the framing is bounds-checked here. */
+static int pw_multi_walk(struct pw_multi_scan *s, const unsigned char *p, size_t size)
+{
+    struct pw_vk_stream_record r;
+    size_t at = 0;
+    while (at + PW_VK_STREAM_HEADER <= size) {
+        uint32_t total, opcode, payload;
+        memcpy(&total, p + at + 8, 4);
+        memcpy(&opcode, p + at + 12, 4);
+        memcpy(&payload, p + at + 16, 4);
+        if (total < PW_VK_STREAM_HEADER || total > size - at || payload > total - PW_VK_STREAM_HEADER) return 1;
+        memcpy(&r.sequence, p + at + 24, 8);
+        r.opcode = opcode;
+        r.payload_bytes = payload;
+        r.payload = p + at + PW_VK_STREAM_HEADER;
+        if (pw_multi_scan_record(s, &r)) return 1;
+        at += total;
+    }
+    return at != size;
+}
+
+/* 0: every record was queued. 1: blocking batch, nothing queued; the caller
+ * must pw_multi_wait_all and replay the batch inline. The batch must already be
+ * validated. Routing changes no map, so abandoning a split restores two fields. */
+static int pw_multi_submit_batch(struct pw_async_multi *m, const void *bytes, size_t size,
+                                 pw_multi_classify classify, void *ctx)
+{
+    struct pw_multi_scan s;
+    int saved_worker = m->route.current_worker, saved_bind = m->last_bind_worker;
+    uint64_t saved_unknown = m->route.unknown_cb;
+
+    if (size > m->scratch_capacity) return 1;
+    s.m = m; s.classify = classify; s.ctx = ctx; s.pending_n = 0;
+    for (unsigned w = 0; w < m->workers; w++) m->scratch_used[w] = 0;
+    if (pw_multi_walk(&s, bytes, size) ||
+        (s.pending_n && (pw_multi_leftover_worker(m) < 0 ||
+                         pw_multi_flush_pending(&s, pw_multi_leftover_worker(m))))) {
+        m->route.current_worker = saved_worker;
+        m->last_bind_worker = saved_bind;
+        m->route.unknown_cb = saved_unknown;
+        return 1;
+    }
+    for (unsigned w = 0; w < m->workers; w++)
+        if (m->scratch_used[w])
+            pw_async_submit(&m->q[w], m->scratch[w], m->scratch_used[w]);
+    return 0;
+}
+
+static int pw_multi_wait_all(struct pw_async_multi *m)
+{
+    int failed = 0;
+    for (unsigned w = 0; w < m->workers; w++) failed |= pw_async_wait_all(&m->q[w]);
+    return failed;
+}
+
+static int pw_multi_wait_worker(struct pw_async_multi *m, int worker)
+{
+    if (worker < 0 || (unsigned)worker >= m->workers) return pw_multi_wait_all(m);
+    return pw_async_wait_all(&m->q[worker]);
+}
+
+/* Workers owning these command buffers (unknown buffers ran on worker 0). Reads the
+ * route only: call under the same lock as pw_multi_submit_batch, then wait outside it. */
+static unsigned pw_multi_owner_mask(const struct pw_async_multi *m, const uint64_t *cbs, unsigned n)
+{
+    unsigned mask = 0;
+    for (unsigned i = 0; i < n; i++) {
+        int slot = pw_route_find(&m->route.cb, cbs[i]);
+        int worker = slot < 0 ? -1 : pw_route_worker_for_pool(&m->route, m->route.cb.value[slot]);
+        mask |= 1u << (worker < 0 ? 0 : worker);
+    }
+    return mask;
+}
+
+static int pw_multi_wait_mask(struct pw_async_multi *m, unsigned mask)
+{
+    int failed = 0;
+    for (unsigned w = 0; w < m->workers; w++)
+        if (mask & (1u << w)) failed |= pw_async_wait_all(&m->q[w]);
+    return failed;
+}
+
+static int pw_multi_wait_cbs(struct pw_async_multi *m, const uint64_t *cbs, unsigned n)
+{
+    return pw_multi_wait_mask(m, pw_multi_owner_mask(m, cbs, n));
+}
+
+static int pw_multi_failed(struct pw_async_multi *m)
+{
+    for (unsigned w = 0; w < m->workers; w++)
+        if (atomic_load(&m->q[w].failed)) return 1;
+    return 0;
+}
+
+/* Tests and shutdown paths only; the production executor lives until process exit. */
+static void pw_multi_shutdown(struct pw_async_multi *m)
+{
+    for (unsigned w = 0; w < m->workers; w++) {
+        pw_async_shutdown(&m->q[w]);
+        free(m->scratch[w]);
+        m->scratch[w] = NULL;
+    }
+}
+
+#endif
diff --git a/dlls/winevulkan/pw_vk_async_route.h b/dlls/winevulkan/pw_vk_async_route.h
new file mode 100644
--- /dev/null
+++ b/dlls/winevulkan/pw_vk_async_route.h
@@ -0,0 +1,154 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Command-pool ownership for parallel Vulkan replay workers.
+ *
+ * Every command pool belongs to one replay worker (round robin when the pool
+ * is first seen allocating), and every command buffer to its pool's worker,
+ * so a pool and its buffers are only ever touched by one thread. Callers are
+ * serialised by the PE batch gate; nothing here locks or allocates.
+ * See docs/superpowers/plans/2026-11-11-parallel-native-recording.md.
+ */
+#ifndef PW_VK_ASYNC_ROUTE_H
+#define PW_VK_ASYNC_ROUTE_H
+
+#include <stdint.h>
+#include <string.h>
+
+#define PW_ROUTE_MAX_WORKERS 4u
+#define PW_ROUTE_SLOTS 4096u
+
+enum { PW_ROUTE_EMPTY = 0, PW_ROUTE_USED = 1, PW_ROUTE_DEAD = 2 };
+
+struct pw_route_map {
+    uint64_t key[PW_ROUTE_SLOTS];
+    uint64_t value[PW_ROUTE_SLOTS];
+    uint8_t state[PW_ROUTE_SLOTS];
+};
+
+struct pw_route {
+    unsigned workers;
+    unsigned next;              /* round-robin cursor for new pools */
+    int current_worker;         /* worker of the last routed command record, -1 before any */
+    uint64_t unknown_cb;        /* buffers routed to worker 0 because their pool was unknown */
+    uint64_t pools;             /* pools ever assigned */
+    struct pw_route_map pool;   /* pool -> worker */
+    struct pw_route_map cb;     /* command buffer -> pool */
+};
+
+static inline uint32_t pw_route_hash(uint64_t key)
+{
+    key ^= key >> 33;
+    key *= 0xff51afd7ed558ccdull;
+    key ^= key >> 33;
+    return (uint32_t)key & (PW_ROUTE_SLOTS - 1u);
+}
+
+/* Slot holding key, or -1. */
+static inline int pw_route_find(const struct pw_route_map *m, uint64_t key)
+{
+    uint32_t i = pw_route_hash(key);
+    for (uint32_t n = 0; n < PW_ROUTE_SLOTS; n++, i = (i + 1u) & (PW_ROUTE_SLOTS - 1u)) {
+        if (m->state[i] == PW_ROUTE_EMPTY) return -1;
+        if (m->state[i] == PW_ROUTE_USED && m->key[i] == key) return (int)i;
+    }
+    return -1;
+}
+
+/* Insert or update; returns 0, or -1 when the map is full (the key stays unknown). */
+static inline int pw_route_put(struct pw_route_map *m, uint64_t key, uint64_t value)
+{
+    int found = pw_route_find(m, key);
+    if (found >= 0) { m->value[found] = value; return 0; }
+    uint32_t i = pw_route_hash(key);
+    for (uint32_t n = 0; n < PW_ROUTE_SLOTS; n++, i = (i + 1u) & (PW_ROUTE_SLOTS - 1u)) {
+        if (m->state[i] != PW_ROUTE_USED) {
+            m->state[i] = PW_ROUTE_USED;
+            m->key[i] = key;
+            m->value[i] = value;
+            return 0;
+        }
+    }
+    return -1;
+}
+
+static inline void pw_route_remove(struct pw_route_map *m, uint64_t key)
+{
+    int i = pw_route_find(m, key);
+    if (i >= 0) m->state[i] = PW_ROUTE_DEAD;
+}
+
+static inline void pw_route_init(struct pw_route *r, unsigned workers)
+{
+    memset(r, 0, sizeof(*r));
+    r->workers = workers >= 1u && workers <= PW_ROUTE_MAX_WORKERS ? workers : 1u;
+    r->current_worker = -1;
+}
+
+/* A new pool gets `worker` when it is a valid worker (several pools of one DXVK
+ * command list share a worker), otherwise the next round-robin worker. A known
+ * pool keeps its worker. */
+static inline void pw_route_note_alloc_as(struct pw_route *r, uint64_t pool, const uint64_t *cbs, unsigned count,
+                                          int worker)
+{
+    if (pw_route_find(&r->pool, pool) < 0) {
+        int grouped = worker >= 0 && (unsigned)worker < r->workers;
+        if (pw_route_put(&r->pool, pool, grouped ? (unsigned)worker : r->next % r->workers) == 0) {
+            if (!grouped) r->next++;
+            r->pools++;
+        }
+    }
+    for (unsigned i = 0; i < count; i++)
+        pw_route_put(&r->cb, cbs[i], pool);
+}
+
+static inline void pw_route_note_alloc(struct pw_route *r, uint64_t pool, const uint64_t *cbs, unsigned count)
+{
+    pw_route_note_alloc_as(r, pool, cbs, count, -1);
+}
+
+static inline void pw_route_note_free(struct pw_route *r, uint64_t pool, const uint64_t *cbs, unsigned count)
+{
+    (void)pool;
+    for (unsigned i = 0; i < count; i++)
+        pw_route_remove(&r->cb, cbs[i]);
+}
+
+static inline void pw_route_note_destroy_pool(struct pw_route *r, uint64_t pool)
+{
+    pw_route_remove(&r->pool, pool);
+    for (uint32_t i = 0; i < PW_ROUTE_SLOTS; i++)
+        if (r->cb.state[i] == PW_ROUTE_USED && r->cb.value[i] == pool)
+            r->cb.state[i] = PW_ROUTE_DEAD;
+}
+
+static inline int pw_route_worker_for_pool(const struct pw_route *r, uint64_t pool)
+{
+    int i = pw_route_find(&r->pool, pool);
+    return i < 0 ? -1 : (int)r->pool.value[i];
+}
+
+static inline int pw_route_worker_for_cb(struct pw_route *r, uint64_t cb)
+{
+    int i = pw_route_find(&r->cb, cb);
+    int worker = i < 0 ? -1 : pw_route_worker_for_pool(r, r->cb.value[i]);
+    if (worker < 0) {
+        r->unknown_cb++;
+        worker = 0;
+    }
+    r->current_worker = worker;
+    return worker;
+}
+
+static inline int pw_route_descriptor_worker(const struct pw_route *r)
+{
+    return r->current_worker;
+}
+
+/* PW_VK_ASYNC_WORKERS: a decimal 1..4; anything else means 1. */
+static inline unsigned pw_route_parse_workers(const char *env)
+{
+    if (!env || env[0] < '1' || env[0] > '9' || env[1]) return 1u;
+    unsigned n = (unsigned)(env[0] - '0');
+    return n <= PW_ROUTE_MAX_WORKERS ? n : 1u;
+}
+
+#endif
