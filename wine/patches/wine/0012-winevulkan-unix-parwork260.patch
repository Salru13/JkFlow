+ struct replay_context *ctx=context;void *params;unsigned code;
+ if(r->opcode!=PW_VK_BATCH_GENERATED_OPCODE)return !pw_wine_vk_replay(r->opcode,r->payload,r->payload_bytes);
+ if(!generated_record(ctx,r,&params))return 1;
+ memcpy(&code,r->payload,4);return pw_vk_batch_dispatch_native(code,params)!=STATUS_SUCCESS;
+}
+/* Opt-in retained storage never changes the original default stack context. */
+#define PW_VK_RETAINED_RECORDS 128
+#define PW_VK_RETAINED_BYTES (128u*1024u)
+struct retained_record { void *params; uint64_t sequence; unsigned code; };
+struct retained_context {
+ struct replay_context base;
+ struct retained_record retained[PW_VK_RETAINED_RECORDS];
+ size_t used; unsigned retained_count, replay_index;
+};
+static int retain_preflight(void *context,const struct pw_vk_stream_record *r)
+{
+ struct retained_context *ctx=context;struct retained_record *saved;void *params;size_t used;unsigned code;
+ if(r->opcode!=PW_VK_BATCH_GENERATED_OPCODE)
+  return !(r->payload_bytes<=4096&&pw260_validate(r->opcode,r->payload,r->payload_bytes));
+ if(ctx->base.version!=PW_VK_BATCH_VERSION||r->payload_bytes<4||r->payload_bytes>PW_VK_CODEC_MAX_BYTES||ctx->retained_count==PW_VK_RETAINED_RECORDS)return 1;
+ memcpy(&code,r->payload,4);if(code>=unix_pw_vk_batch)return 1;
+ if(!pw_vk_generated_decode_used(code,r->payload+4,r->payload_bytes-4,(unsigned char *)ctx->base.arena+ctx->used,ctx->base.capacity-ctx->used,&params,&used)){
+  if(ctx->base.arena!=ctx->base.local)return 1;
+  ctx->base.arena=malloc(PW_VK_RETAINED_BYTES);if(!ctx->base.arena)return 1;
+  ctx->base.capacity=PW_VK_RETAINED_BYTES;ctx->used=0;
+  if(!pw_vk_generated_decode_used(code,r->payload+4,r->payload_bytes-4,ctx->base.arena,ctx->base.capacity,&params,&used))return 1;
+ }
+ /* A region ends on an 8-byte boundary, so rounding a successful decode fits. */
+ ctx->used+=(used+7)&~(size_t)7;
+ saved=&ctx->retained[ctx->retained_count++];saved->params=params;saved->sequence=r->sequence;saved->code=code;
+ return 0;
+}
+static int retained_replay(void *context,const struct pw_vk_stream_record *r)
+{
+ struct retained_context *ctx=context;struct retained_record *saved;unsigned code;
+ if(r->opcode!=PW_VK_BATCH_GENERATED_OPCODE)return !pw_wine_vk_replay(r->opcode,r->payload,r->payload_bytes);
+ if(ctx->replay_index>=ctx->retained_count||r->payload_bytes<4)return 1;
+ saved=&ctx->retained[ctx->replay_index++];memcpy(&code,r->payload,4);
+ if(saved->sequence!=r->sequence||saved->code!=code)return 1;
+ return pw_vk_batch_dispatch_native(code,saved->params)!=STATUS_SUCCESS;
+}
+static __attribute__((noinline)) NTSTATUS retained_batch(void *args)
+{
+ struct pw_vk_batch_params *p=args;size_t completed;struct retained_context ctx;NTSTATUS status=STATUS_SUCCESS;
+ if((p->version!=PW_VK_BATCH_VERSION&&p->version!=PW_VK_BATCH_LEGACY_VERSION)||p->bytes>PW_VK_BATCH_SCRATCH||p->code>unix_count||p->code==unix_pw_vk_batch)return STATUS_INVALID_PARAMETER;
+ ctx.base.version=p->version;ctx.base.arena=ctx.base.local;ctx.base.capacity=sizeof(ctx.base.local);ctx.base.failure=STATUS_SUCCESS;
+ ctx.used=0;ctx.retained_count=0;ctx.replay_index=0;
+ if(pw_vk_stream_replay(UlongToPtr(p->batch),p->bytes,retain_preflight,&ctx,&completed)==PW_VK_STREAM_OK){
+  if(pw_vk_stream_replay(UlongToPtr(p->batch),p->bytes,retained_replay,&ctx,&completed)!=PW_VK_STREAM_OK)status=STATUS_UNSUCCESSFUL;
+ }else{
+  /* Includes allocation failure and malformed input. Original preflight still
+   * decides the result; no native dispatch has happened on the attempted path. */
+  if(ctx.base.arena&&ctx.base.arena!=ctx.base.local)free(ctx.base.arena);
+  ctx.base.arena=ctx.base.local;ctx.base.capacity=sizeof(ctx.base.local);
+  if(pw_vk_stream_replay(UlongToPtr(p->batch),p->bytes,preflight,&ctx.base,&completed)!=PW_VK_STREAM_OK)status=ctx.base.failure?ctx.base.failure:STATUS_INVALID_PARAMETER;
+  else if(pw_vk_stream_replay(UlongToPtr(p->batch),p->bytes,replay,&ctx.base,&completed)!=PW_VK_STREAM_OK)status=STATUS_UNSUCCESSFUL;
+ }
+ if(ctx.base.arena&&ctx.base.arena!=ctx.base.local)free(ctx.base.arena);
+ if(status)return status;
+ p->status=STATUS_SUCCESS;
+ /* unix_count is the private flush-only sentinel. This check occurs before
+  * any dispatch; ordinary perf-critical thunks really return void. */
+ if(p->code!=unix_count){
+  p->status=pw_vk_batch_dispatch(p->code,UlongToPtr(p->args));
+ }
+ return STATUS_SUCCESS;
+}
+
+static __attribute__((noinline)) NTSTATUS original_batch(void *args)
+{
+ struct pw_vk_batch_params *p=args;size_t completed;struct replay_context ctx;NTSTATUS status=STATUS_SUCCESS;
+ if((p->version!=PW_VK_BATCH_VERSION&&p->version!=PW_VK_BATCH_LEGACY_VERSION)||p->bytes>PW_VK_BATCH_SCRATCH||p->code>unix_count||p->code==unix_pw_vk_batch)return STATUS_INVALID_PARAMETER;
+ ctx.version=p->version;ctx.arena=ctx.local;ctx.capacity=sizeof(ctx.local);ctx.failure=STATUS_SUCCESS;
+ if(pw_vk_stream_replay(UlongToPtr(p->batch),p->bytes,preflight,&ctx,&completed)!=PW_VK_STREAM_OK)status=ctx.failure?ctx.failure:STATUS_INVALID_PARAMETER;
+ else if(pw_vk_stream_replay(UlongToPtr(p->batch),p->bytes,replay,&ctx,&completed)!=PW_VK_STREAM_OK)status=STATUS_UNSUCCESSFUL;
+ if(ctx.arena&&ctx.arena!=ctx.local)free(ctx.arena);
+ if(status)return status;
+ p->status=STATUS_SUCCESS;
+ /* unix_count is the private flush-only sentinel. This check occurs before
+  * any dispatch; ordinary perf-critical thunks really return void. */
+ if(p->code!=unix_count){
+  p->status=pw_vk_batch_dispatch(p->code,UlongToPtr(p->args));
+ }
+ return STATUS_SUCCESS;
+}
+
+/* Read an immutable process-startup setting once. Concurrent first callers
+ * may read it together; a single atomic winner publishes the cached mode.
+ * Values other than the exact string "1" preserve the original decoder. */
+static unsigned retain_decode_mode;
+static int retain_decode_enabled(void)
+{
+ unsigned mode=__atomic_load_n(&retain_decode_mode,__ATOMIC_ACQUIRE);
+ if(!mode){
+  const char *value=getenv("PW_VK_RETAIN_DECODE");
+  unsigned selected=value&&value[0]=='1'&&!value[1]?2:1,expected=0;
+  if(__atomic_compare_exchange_n(&retain_decode_mode,&expected,selected,0,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE)){
+   mode=selected;
+   __wine_dbg_output(mode==2 ? "PW_VK_DECODE_MODE version=1 retained=1\n" : "PW_VK_DECODE_MODE version=1 retained=0\n");
+  }else mode=expected;
+ }
+ return mode==2;
+}
+NTSTATUS pw_vk_batch_unix(void *args)
+{
+ if(retain_decode_enabled())return retained_batch(args);
+ return original_batch(args);
+}
+
+/* asynccb260 capability: only with the async worker, off with PW_VK_ASYNC_CB=0. */
+int pw_vk_async_cb260_enabled(void)
+{
+ const char *value=getenv("PW_VK_ASYNC_CB");
+ if(value&&value[0]=='0'&&!value[1])return 0;
+ return pw_vk_async_enabled();
+}
diff --git a/dlls/winevulkan/pw_vk_async_core.h b/dlls/winevulkan/pw_vk_async_core.h
new file mode 100644
--- /dev/null
+++ b/dlls/winevulkan/pw_vk_async_core.h
@@ -0,0 +1,204 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Ordered single-worker job queue for asynchronous Vulkan replay.
+ *
+ * Jobs run in submission order on one worker thread. Job bytes are copied in
+ * before submit returns, so the caller may reuse its buffer at once. A ticket
+ * identifies a position in the order; waiting for a ticket means everything up
+ * to it has finished. Producers may be concurrent.
+ *
+ * Portable (C11 atomics and pthreads) so the host fixture tests this exact code.
+ */
+#ifndef PW_VK_ASYNC_CORE_H
+#define PW_VK_ASYNC_CORE_H
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define PW_ASYNC_MAX_JOBS 4096u
+/* About 100-200 us of polling: long enough to bridge the gap between batches,
+ * short enough that an idle queue sleeps instead of burning a core. */
+#define PW_ASYNC_WORKER_SPINS 8000u
+#define PW_ASYNC_WAITER_SPINS 16000u
+
+static inline void pw_async_pause(void)
+{
+#if defined(__x86_64__) || defined(__i386__)
+    __asm__ __volatile__("pause");
+#endif
+}
+
+typedef int (*pw_async_run)(void *context, const void *bytes, size_t size);
+
+struct pw_async_job { uint64_t end; uint32_t offset, size; };
+
+struct pw_async
+{
+    unsigned char *data;
+    size_t capacity;
+    pw_async_run run;
+    void *context;
+
+    atomic_flag producer;
+    uint64_t head;                 /* producer-owned monotonic byte position */
+    _Atomic uint64_t tail;         /* consumed monotonic byte position */
+    _Atomic uint64_t submitted;
+    _Atomic uint64_t completed;
+    _Atomic int failed, stop, sleeping, waiters;
+    struct pw_async_job jobs[PW_ASYNC_MAX_JOBS];
+
+    pthread_mutex_t mutex;
+    pthread_cond_t work, done;
+    pthread_t thread;
+    int started;
+};
+
+static void pw_async_notify_waiters(struct pw_async *q)
+{
+    if (!atomic_load(&q->waiters)) return;
+    pthread_mutex_lock(&q->mutex);
+    pthread_cond_broadcast(&q->done);
+    pthread_mutex_unlock(&q->mutex);
+}
+
+static void *pw_async_worker(void *arg)
+{
+    struct pw_async *q = arg;
+    uint64_t done = 0;
+    for (;;)
+    {
+        unsigned spins = 0;
+        while (atomic_load_explicit(&q->submitted, memory_order_acquire) == done)
+        {
+            if (atomic_load(&q->stop)) return NULL;
+            if (++spins < PW_ASYNC_WORKER_SPINS) { pw_async_pause(); continue; }
+            pthread_mutex_lock(&q->mutex);
+            atomic_store(&q->sleeping, 1);
+            while (atomic_load(&q->submitted) == done && !atomic_load(&q->stop))
+                pthread_cond_wait(&q->work, &q->mutex);
+            atomic_store(&q->sleeping, 0);
+            pthread_mutex_unlock(&q->mutex);
+            spins = 0;
+        }
+        {
+            const struct pw_async_job *job = &q->jobs[done % PW_ASYNC_MAX_JOBS];
+            uint64_t end = job->end;
+            /* A failed queue never starts more work; waiters report the failure. */
+            if (!atomic_load(&q->failed) && q->run(q->context, q->data + job->offset, job->size))
+                atomic_store(&q->failed, 1);
+            atomic_store_explicit(&q->tail, end, memory_order_release);
+            done++;
+            atomic_store(&q->completed, done);
+            pw_async_notify_waiters(q);
+        }
+    }
+}
+
+/* Returns 0 on success. On failure the queue is unusable and the caller must
+ * run work synchronously. */
+static int pw_async_start(struct pw_async *q, size_t capacity, pw_async_run run, void *context)
+{
+    pthread_attr_t attr;
+    memset(q, 0, sizeof(*q));
+    atomic_flag_clear(&q->producer);
+    if (!(q->data = malloc(capacity))) return -1;
+    q->capacity = capacity; q->run = run; q->context = context;
+    pthread_mutex_init(&q->mutex, NULL);
+    pthread_cond_init(&q->work, NULL);
+    pthread_cond_init(&q->done, NULL);
+    pthread_attr_init(&attr);
+    pthread_attr_setstacksize(&attr, 1024 * 1024);
+    if (pthread_create(&q->thread, &attr, pw_async_worker, q))
+    {
+        pthread_attr_destroy(&attr);
+        free(q->data); q->data = NULL;
+        return -1;
+    }
+    pthread_attr_destroy(&attr);
+    q->started = 1;
+    return 0;
+}
+
+/* Block until every job up to and including ticket has finished. Returns
+ * nonzero if any job has failed. */
+static int pw_async_wait(struct pw_async *q, uint64_t ticket)
+{
+    unsigned spins = 0;
+    while (atomic_load_explicit(&q->completed, memory_order_acquire) < ticket)
+    {
+        if (++spins < PW_ASYNC_WAITER_SPINS) { pw_async_pause(); continue; }
+        pthread_mutex_lock(&q->mutex);
+        atomic_fetch_add(&q->waiters, 1);
+        while (atomic_load(&q->completed) < ticket)
+            pthread_cond_wait(&q->done, &q->mutex);
+        atomic_fetch_sub(&q->waiters, 1);
+        pthread_mutex_unlock(&q->mutex);
+        break;
+    }
+    return atomic_load(&q->failed);
+}
+
+static int pw_async_wait_all(struct pw_async *q)
+{
+    return pw_async_wait(q, atomic_load_explicit(&q->submitted, memory_order_acquire));
+}
+
+static int pw_async_fits(const struct pw_async *q, size_t size)
+{
+    return size && size <= q->capacity / 2 && size <= UINT32_MAX;
+}
+
+/* Copy bytes into the queue and return the job's ticket. size must satisfy
+ * pw_async_fits. Blocks while the queue is full. */
+static uint64_t pw_async_submit(struct pw_async *q, const void *bytes, size_t size)
+{
+    uint64_t start, end, ticket;
+    size_t position;
+    while (atomic_flag_test_and_set_explicit(&q->producer, memory_order_acquire)) pw_async_pause();
+    position = q->head % q->capacity;
+    start = q->head + (position + size > q->capacity ? q->capacity - position : 0);
+    end = start + size;
+    ticket = atomic_load_explicit(&q->submitted, memory_order_relaxed);
+    for (;;)
+    {
+        uint64_t oldest = atomic_load_explicit(&q->completed, memory_order_acquire);
+        if (end - atomic_load_explicit(&q->tail, memory_order_acquire) <= q->capacity &&
+            ticket - oldest < PW_ASYNC_MAX_JOBS) break;
+        /* The worker only needs the next finished job to free space. */
+        pw_async_wait(q, oldest + 1);
+    }
+    memcpy(q->data + start % q->capacity, bytes, size);
+    q->jobs[ticket % PW_ASYNC_MAX_JOBS].end = end;
+    q->jobs[ticket % PW_ASYNC_MAX_JOBS].offset = (uint32_t)(start % q->capacity);
+    q->jobs[ticket % PW_ASYNC_MAX_JOBS].size = (uint32_t)size;
+    q->head = end;
+    atomic_store(&q->submitted, ticket + 1);
+    atomic_flag_clear_explicit(&q->producer, memory_order_release);
+    if (atomic_load(&q->sleeping))
+    {
+        pthread_mutex_lock(&q->mutex);
+        pthread_cond_signal(&q->work);
+        pthread_mutex_unlock(&q->mutex);
+    }
+    return ticket + 1;
+}
+
+/* For tests and shutdown paths. The production queue lives until process exit. */
+static void pw_async_shutdown(struct pw_async *q)
+{
+    if (!q->started) return;
+    pw_async_wait_all(q);
+    atomic_store(&q->stop, 1);
+    pthread_mutex_lock(&q->mutex);
+    pthread_cond_signal(&q->work);
+    pthread_mutex_unlock(&q->mutex);
+    pthread_join(q->thread, NULL);
+    pthread_cond_destroy(&q->work);
+    pthread_cond_destroy(&q->done);
+    pthread_mutex_destroy(&q->mutex);
+    free(q->data);
+    q->data = NULL; q->started = 0;
+}
+#endif
