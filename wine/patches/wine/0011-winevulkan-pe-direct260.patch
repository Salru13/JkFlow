+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Replaces winecrt0's unix_lib.c for wvkdirect.dll, a renamed copy of the
+ * i386 winevulkan PE half that lives in the game directory. Wine only binds a
+ * Unix library to builtin modules found in its own (read-only) library
+ * directory, so this copy borrows the Unix half of the real winevulkan.dll,
+ * which is the same build. The real module is only loaded, never called. */
+#include <stdarg.h>
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "wine/unixlib.h"
+
+static NTSTATUS WINAPI unix_call_fallback( unixlib_handle_t handle, unsigned int code, void *args )
+{
+    return STATUS_DLL_NOT_FOUND;
+}
+
+static void *get_dispatcher( void )
+{
+    UNICODE_STRING ntdll_name = RTL_CONSTANT_STRING( L"ntdll.dll" );
+    HMODULE module;
+    void **dispatcher;
+
+    LdrGetDllHandle( NULL, 0, &ntdll_name, &module );
+    dispatcher = RtlFindExportedRoutineByName( module, "__wine_unix_call_dispatcher" );
+    return dispatcher ? *dispatcher : (void *)unix_call_fallback;
+}
+
+static NTSTATUS WINAPI unix_call_init( unixlib_handle_t handle, unsigned int code, void *args )
+{
+    InterlockedExchangePointer( (void **)&__wine_unix_call_dispatcher, get_dispatcher() );
+    return __wine_unix_call_dispatcher( handle, code, args );
+}
+
+unixlib_handle_t __wine_unixlib_handle = 0;
+NTSTATUS (WINAPI *__wine_unix_call_dispatcher)( unixlib_handle_t, unsigned int, void * ) = unix_call_init;
+
+NTSTATUS WINAPI __wine_init_unix_call(void)
+{
+    HMODULE real = LoadLibraryW( L"winevulkan.dll" );
+    if (!real) return STATUS_DLL_NOT_FOUND;
+    return NtQueryVirtualMemory( GetCurrentProcess(), real, MemoryWineLoadUnixLib,
+                                 &__wine_unixlib_handle, sizeof(__wine_unixlib_handle), NULL );
+}
