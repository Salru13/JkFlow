--- /dev/null
+++ b/dlls/ntdll/unix/pw258_sync_spin.inc
@@ -0,0 +1,118 @@
+/* Task258: bounded user-space spin before an event wait enters the server.
+ *
+ * Install as dlls/ntdll/unix/pw258_sync_spin.inc next to server.c and apply
+ * task258_sync_spin.patch. Compiled inside server.c's WINE_INPROCESS_SERVER
+ * block, so it can use that file's static slot and backend helpers.
+ *
+ * Why: in the native266 race the main thread makes about 700 NtSetEvent calls
+ * per frame and about half take the ordinary server path. The reason counter
+ * for those is `word` (SLOW): a worker is already queued in the server, so the
+ * cell is frozen and the setter must wake it through the server. If the worker
+ * stays in user space for a short time first, the cell stays FAST and the
+ * setter's existing single CAS succeeds.
+ *
+ * Off unless PW_SYNC_SPIN_US is a plain decimal in 1..200. Anything else,
+ * including an out-of-range value, leaves it off.
+ *
+ * Spins only on an already-cached event for an untimed or long-timeout,
+ * non-alertable wait. Leaves as soon as the cell turns SLOW, so a server-queued
+ * waiter, disable or retirement (retired cells stay SLOW and are never freed)
+ * all end the spin. A success is the same CAS the existing fast wait performs.
+ */
+
+#define PW258_SPIN_MAX_US 200u
+/* Nominal Orbis TSC (the race logs report tsc_hz=1593993921). Only a bound, so
+ * it does not need to be exact. */
+#define PW258_TSC_PER_US 1594u
+/* 1 ms in NT 100 ns units. Shorter timeouts must not be stretched by a spin. */
+#define PW258_MIN_RELATIVE_TIMEOUT 10000
+#define PW258_REPORT_MASK 0xffffu
+
+static int64_t pw258_spin_ticks_cached = -1;
+static uint64_t pw258_stat_spins, pw258_stat_hits, pw258_stat_slow, pw258_stat_expired;
+
+static inline uint64_t pw258_rdtsc(void)
+{
+    uint32_t lo, hi;
+    __asm__ __volatile__("rdtsc" : "=a"(lo), "=d"(hi));
+    return ((uint64_t)hi << 32) | lo;
+}
+
+static int64_t pw258_parse_ticks(const char *text)
+{
+    unsigned long us = 0;
+    const char *p;
+    if (!text || !*text) return 0;
+    for (p = text; *p; p++)
+    {
+        if (*p < '0' || *p > '9') return 0;
+        us = us * 10 + (unsigned long)(*p - '0');
+        if (us > PW258_SPIN_MAX_US) return 0;
+    }
+    return (int64_t)us * PW258_TSC_PER_US;
+}
+
+static uint64_t pw258_spin_budget(void)
+{
+    int64_t ticks = __atomic_load_n(&pw258_spin_ticks_cached, __ATOMIC_RELAXED);
+    if (ticks < 0)
+    {
+        { const char *pw260_value = getenv("PW_SYNC_SPIN_US"); ticks = pw260_value ? pw258_parse_ticks(pw260_value) : (int64_t)50 * PW258_TSC_PER_US; }
+        __atomic_store_n(&pw258_spin_ticks_cached, ticks, __ATOMIC_RELAXED);
+    }
+    return (uint64_t)ticks;
+}
+
+static void pw258_spin_finished(uint64_t *outcome)
+{
+    uint64_t spins;
+    __atomic_add_fetch(outcome, 1, __ATOMIC_RELAXED);
+    spins = __atomic_add_fetch(&pw258_stat_spins, 1, __ATOMIC_RELAXED);
+    if (!(spins & PW258_REPORT_MASK))
+        ERR("PW_SYNC258 spins=%llu hit=%llu slow=%llu expired=%llu\n", (unsigned long long)spins,
+            (unsigned long long)__atomic_load_n(&pw258_stat_hits, __ATOMIC_RELAXED),
+            (unsigned long long)__atomic_load_n(&pw258_stat_slow, __ATOMIC_RELAXED),
+            (unsigned long long)__atomic_load_n(&pw258_stat_expired, __ATOMIC_RELAXED));
+}
+
+/* Returns 1 when the wait was satisfied, 0 when the caller must carry on down
+ * the existing path. The caller has already made one fast attempt. */
+static int pw258_spin_shared_wait(HANDLE handle, const LARGE_INTEGER *timeout)
+{
+    uint64_t budget = pw258_spin_budget(), start, old;
+    uintptr_t *slot, value;
+    struct pw_sync_word *word;
+
+    if (!budget) return 0;
+    if (timeout && (timeout->QuadPart >= 0 || timeout->QuadPart > -PW258_MIN_RELATIVE_TIMEOUT)) return 0;
+    if (!get_thread_data()->tid || !pw_sync_backend_ready(shared_sync_backend)) return 0;
+
+    slot = shared_sync_slot(wine_server_obj_handle(handle), 0);
+    value = slot ? __atomic_load_n(slot, __ATOMIC_ACQUIRE) : 0;
+    if (!value || value == PW_SYNC_SLOT_NEGATIVE || !(value & PW_SYNC_SLOT_SYNCHRONIZE)) return 0;
+    word = pw_sync_slot_word(value);
+    if (word->kind != PW_SYNC_AUTO_EVENT && word->kind != PW_SYNC_MANUAL_EVENT) return 0;
+    if (pw_sync_word_load(word) & PW_SYNC_WORD_SLOW) return 0;
+
+    start = pw258_rdtsc();
+    for (;;)
+    {
+        old = pw_sync_word_load(word);
+        if (old & PW_SYNC_WORD_SLOW)
+        {
+            pw258_spin_finished(&pw258_stat_slow);
+            return 0;
+        }
+        if ((uint32_t)old && pw_sync_word_try_wait(word))
+        {
+            pw258_spin_finished(&pw258_stat_hits);
+            return 1;
+        }
+        if (pw258_rdtsc() - start >= budget)
+        {
+            pw258_spin_finished(&pw258_stat_expired);
+            return 0;
+        }
+        __asm__ __volatile__("pause");
+    }
+}
