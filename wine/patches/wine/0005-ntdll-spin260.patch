+static struct n265_shared_stats n265_slots[128];
+static unsigned n265_omitted;
+static int n265_enabled = -1;
+static int n265_gate(void)
+{
+    int enabled = __atomic_load_n(&n265_enabled, __ATOMIC_ACQUIRE);
+    if (enabled < 0)
+    {
+        const char *value = getenv("PW_SYNC_PROFILE");
+        int chosen = value && !strcmp(value, "1"), expected = -1;
+        __atomic_compare_exchange_n(&n265_enabled, &expected, chosen, 0,
+                                   __ATOMIC_RELEASE, __ATOMIC_RELAXED);
+        enabled = __atomic_load_n(&n265_enabled, __ATOMIC_ACQUIRE);
+    }
+    return enabled;
+}
+static struct n265_shared_stats *n265_slot(void)
+{
+    uintptr_t owner = (uintptr_t)NtCurrentTeb();
+    unsigned tid = get_thread_data()->tid, i;
+    if (owner <= 1 || !tid) return NULL;
+    for (i = 0; i < 128; ++i)
+    {
+        uintptr_t value = __atomic_load_n(&n265_slots[i].owner, __ATOMIC_ACQUIRE);
+        if (value == owner && n265_slots[i].tid == tid) return &n265_slots[i];
+        if (value == 1) break;
+        if (!value)
+        {
+            uintptr_t expected = 0;
+            if (!__atomic_compare_exchange_n(&n265_slots[i].owner, &expected, 1, 0,
+                                            __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) break;
+            n265_slots[i].tid = tid;
+            __atomic_store_n(&n265_slots[i].owner, owner, __ATOMIC_RELEASE);
+            return &n265_slots[i];
+        }
+    }
+    __atomic_add_fetch(&n265_omitted, 1, __ATOMIC_RELAXED);
+    return NULL;
+}
+static void n265_record(struct n265_shared_stats *stat, unsigned operation, unsigned why)
+{
+    unsigned i;
+    ++stat->counts[operation][why];
+    ++stat->cumulative;
+    if (++stat->total == 4096)
+    {
+        for (i = 0; i < 4; ++i)
+        {
+            unsigned *c = stat->counts[i], attempts = 0, j;
+            for (j = 0; j < N265_REASONS; ++j) attempts += c[j];
+            if (!attempts) continue;
+            ERR("PW_SYNC265 tid=%04x cumulative=%llu window=4096 op=%u attempts=%u hit=%u noapi=%u notready=%u context=%u negative=%u lookup=%u access=%u word=%u omitted=%u\n",
+                stat->tid, stat->cumulative, i, attempts, c[N265_HIT], c[N265_NOAPI],
+                c[N265_NOTREADY], c[N265_CONTEXT], c[N265_NEGATIVE], c[N265_LOOKUP],
+                c[N265_ACCESS], c[N265_WORD], __atomic_load_n(&n265_omitted, __ATOMIC_RELAXED));
+        }
+        stat->total = 0;
+        memset(stat->counts, 0, sizeof(stat->counts));
+    }
+    __atomic_store_n(&stat->busy, 0, __ATOMIC_RELEASE);
+}
