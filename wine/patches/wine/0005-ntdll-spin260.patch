+/* native263 event profiler begin */
+struct n263_event_stats { uintptr_t owner; unsigned tid, busy, total, attempts[3], fallback[3], failures[3]; unsigned long long first, cumulative, ticks[3]; };
+static struct n263_event_stats n263_slots[128];
+static unsigned n263_overflow;
+static int n263_enabled = -1;
+static int n263_gate(void)
+{
+    int v = __atomic_load_n(&n263_enabled, __ATOMIC_ACQUIRE);
+    if (v < 0)
+    {
+        const char *p = getenv("PW_EVENT_PROFILE");
+        int new_value = p && !strcmp(p, "1");
+        int expected = -1;
+        __atomic_compare_exchange_n(&n263_enabled, &expected, new_value, 0, __ATOMIC_RELEASE, __ATOMIC_RELAXED);
+        v = __atomic_load_n(&n263_enabled, __ATOMIC_ACQUIRE);
+    }
+    return v;
+}
+static unsigned long long n263_clock(void)
+{
+    unsigned lo, hi;
+    __asm__ volatile("lfence; rdtsc" : "=a"(lo), "=d"(hi) :: "memory");
+    return ((unsigned long long)hi << 32) | lo;
+}
+static struct n263_event_stats *n263_slot(void)
+{
+    uintptr_t owner = (uintptr_t)NtCurrentTeb();
+    unsigned tid = get_thread_data()->tid, i;
+    if (owner <= 1 || !tid) return NULL;
+    for (i = 0; i < 128; i++)
+    {
+        uintptr_t value = __atomic_load_n(&n263_slots[i].owner, __ATOMIC_ACQUIRE);
+        if (value == owner && n263_slots[i].tid == tid) return &n263_slots[i];
+        if (value == 1) { __atomic_add_fetch(&n263_overflow, 1, __ATOMIC_RELAXED); return NULL; }
+        if (!value)
+        {
+            uintptr_t zero = 0;
+            if (__atomic_compare_exchange_n(&n263_slots[i].owner, &zero, 1, 0, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED))
+            {
+                n263_slots[i].tid = tid;
+                __atomic_store_n(&n263_slots[i].owner, owner, __ATOMIC_RELEASE);
+                return &n263_slots[i];
+            }
+            __atomic_add_fetch(&n263_overflow, 1, __ATOMIC_RELAXED);
+            return NULL;
+        }
+    }
+    __atomic_add_fetch(&n263_overflow, 1, __ATOMIC_RELAXED);
+    return NULL;
+}
+static void n263_record(struct n263_event_stats *s, unsigned path, unsigned ret, unsigned long long start)
+{
+    unsigned long long end = n263_clock();
+    s->attempts[path]++;
+    if (ret == STATUS_NOT_IMPLEMENTED && path != 2) s->fallback[path]++;
+    else if (ret) s->failures[path]++;
+    if (end >= start) s->ticks[path] += end - start;
+}
+static void n263_finish(struct n263_event_stats *s)
+{
+    ++s->cumulative;
+    if (++s->total == 4096)
+    {
+        unsigned long long end = n263_clock();
+        ERR("PW_EVENT263 tid=%04x start=%llu end=%llu calls=%u cumulative=%llu overflow=%u inproc=%u/%u/%u/%llu shared=%u/%u/%u/%llu server=%u/%u/%u/%llu\n",
+            s->tid, s->first, end, s->total, s->cumulative, __atomic_load_n(&n263_overflow, __ATOMIC_RELAXED),
+            s->attempts[0], s->fallback[0], s->failures[0], s->ticks[0],
+            s->attempts[1], s->fallback[1], s->failures[1], s->ticks[1],
+            s->attempts[2], s->fallback[2], s->failures[2], s->ticks[2]);
+        s->total = 0;
+        memset(s->attempts, 0, sizeof(s->attempts));
+        memset(s->fallback, 0, sizeof(s->fallback));
+        memset(s->failures, 0, sizeof(s->failures));
+        memset(s->ticks, 0, sizeof(s->ticks));
+    }
+    __atomic_store_n(&s->busy, 0, __ATOMIC_RELEASE);
+}
