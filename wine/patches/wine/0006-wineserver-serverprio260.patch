 #include <sys/stat.h>
 #include <sys/time.h>
 #ifdef MAJOR_IN_MKDEV
@@ -110,7 +113,10 @@
 #include "ddk/ntifs.h"
 #include "ddk/wdm.h"
 
-#if defined(HAVE_SYS_EPOLL_H) && defined(HAVE_EPOLL_CREATE)
