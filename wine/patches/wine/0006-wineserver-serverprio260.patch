diff --git a/server/fd.c b/server/fd.c
--- a/server/fd.c
+++ b/server/fd.c
@@ -78,6 +78,9 @@
 #undef LIST_INIT
 #undef LIST_ENTRY
 #endif
+#if defined(__ORBIS__) && !defined(NOTE_LOWAT)
+#define NOTE_LOWAT 0
