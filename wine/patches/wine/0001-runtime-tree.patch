new file mode 100644
--- /dev/null
+++ b/dlls/winevulkan/pw_vk_pod246.h
@@ -0,0 +1,100 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ *
+ * Task247 batch policy helpers, shared verbatim by pw_vk_batch_pe.c and the
+ * host test fixture native247_fixture.cpp (not published).
+ * Pure C/C++: no Wine/Vulkan types, allocation, locks, TLS or crossings.
+ * Include after pw_vk_batch.h.
+ *
+ * The task246 POD/viewport/scissor/blend opcodes (8-11) are withdrawn: this
+ * tree already assigns opcode 8 to PW_VK_BATCH_GENERATED_OPCODE, whose
+ * generated fieldwise codec deep-copies every supported void input thunk,
+ * a superset of the task246 46-name POD list plus viewport/scissor/blend.
+ * What task247 adds on top of the current tree:
+ *   - negotiation order async -> v2 -> v1 legacy, so a mixed new PE/old Unix
+ *     pair keeps the seven v1 fast opcodes instead of disabling batching;
+ *   - a legacy drain bound matching the v1 Unix 4 MiB scratch check;
+ *   - generated opcode 8 only with an unset mask: explicit PW_VK_BATCH_MASK
+ *     (including 0x7f) reproduces v1 for same-package A/B.
+ */
+#ifndef PW_VK_POD246_H
+#define PW_VK_POD246_H
+#include <stddef.h>
+#include <stdint.h>
+#ifndef PW_VK_BATCH_H
+#error "include pw_vk_batch.h first"
+#endif
+
+#define PW247_MASK_V1 0x7fu
+#define PW247_MASK_TEXT 32u
+
+enum pw247_backend { PW247_NONE = 0, PW247_LEGACY = 1, PW247_V2 = 2, PW247_ASYNC = 3 };
+
+typedef uint32_t (*pw247_ask_fn)(void *ctx, const char *name);
+/* Queries stop at the first exact capability. Any other answer (0, 1 from an
+ * ordinary is_available lookup, or a different capability) moves on. */
+static inline int pw247_negotiate(pw247_ask_fn ask, void *ctx)
+{
+    if (!ask) return PW247_NONE;
+    if (ask(ctx, PW_VK_BATCH_ASYNC_NAME) == PW_VK_BATCH_ASYNC_CAPABILITY) return PW247_ASYNC;
+    if (ask(ctx, PW_VK_BATCH_NAME) == PW_VK_BATCH_CAPABILITY) return PW247_V2;
+    if (ask(ctx, PW_VK_BATCH_LEGACY_NAME) == PW_VK_BATCH_LEGACY_CAPABILITY) return PW247_LEGACY;
+    return PW247_NONE;
+}
+static inline const char *pw247_backend_name(int backend)
+{
+    return backend == PW247_ASYNC ? "async" : backend == PW247_V2 ? "v2" : backend == PW247_LEGACY ? "v1" : "none";
+}
+static inline uint32_t pw247_batch_version(int backend)
+{
+    return backend == PW247_ASYNC ? PW_VK_BATCH_ASYNC_VERSION :
+           backend == PW247_LEGACY ? PW_VK_BATCH_LEGACY_VERSION : PW_VK_BATCH_VERSION;
+}
+static inline size_t pw247_batch_limit(int backend)
+{
+    return backend == PW247_LEGACY ? (size_t)PW_VK_BATCH_LEGACY_SCRATCH : (size_t)PW_VK_BATCH_SCRATCH;
+}
+
+/* GetEnvironmentVariableA semantics: n is 0 when unset and >= the buffer size
+ * when it does not fit. Unset keeps 0x7f and generated records. A valid
+ * explicit decimal/0x-hex value 0..127 sets the mask and turns generated
+ * records off. Invalid text returns 0 (caller fails closed) and changes
+ * nothing. */
+static inline int pw247_parse_mask(const char *value, size_t n, size_t cap,
+                                   uint32_t *mask, int *generated)
+{
+    unsigned base = 10, digit;
+    size_t i = 0;
+    uint32_t parsed = 0;
+    if (!n) return 1;
+    if (!value || n >= cap) return 0;
+    if (n >= 2 && value[0] == '0' && (value[1] == 'x' || value[1] == 'X')) { base = 16; i = 2; }
+    if (i == n) return 0;
+    for (; i < n; i++)
+    {
+        if (value[i] >= '0' && value[i] <= '9') digit = (unsigned)(value[i] - '0');
+        else if (base == 16 && value[i] >= 'a' && value[i] <= 'f') digit = (unsigned)(value[i] - 'a' + 10);
+        else if (base == 16 && value[i] >= 'A' && value[i] <= 'F') digit = (unsigned)(value[i] - 'A' + 10);
+        else return 0;
+        if (digit >= base || parsed > (PW247_MASK_V1 - digit) / base) return 0;
+        parsed = parsed * base + digit;
+    }
+    *mask = parsed;
+    *generated = 0;
+    return 1;
+}
+/* Generated opcode 8 needs the v2 (or async) Unix decoder, the full v1 mask
+ * and no explicit mask. */
+static inline int pw247_generated_enabled(uint32_t mask, int generated_allowed, int backend)
+{
+    return mask == PW247_MASK_V1 && generated_allowed && backend != PW247_LEGACY && backend != PW247_NONE;
+}
+/* Drain split rule. A take that does not fit is fatal except for a legacy
+ * backend that already holds an ordered prefix: dispatch that prefix as a
+ * flush-only batch, then continue at the same sequence. room < header is
+ * treated as not fitting so the take never sees a zero-sized scratch. */
+static inline int pw247_should_split(int backend, int take_full, size_t collected, size_t room, size_t header)
+{
+    if (backend != PW247_LEGACY || !collected) return 0;
+    return take_full || room < header;
+}
+#endif
diff --git a/dlls/winevulkan/pw_vk_present_interval.h b/dlls/winevulkan/pw_vk_present_interval.h
new file mode 100644
--- /dev/null
+++ b/dlls/winevulkan/pw_vk_present_interval.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef PW_VK_PRESENT_INTERVAL_H
+#define PW_VK_PRESENT_INTERVAL_H
+#include <stdint.h>
+/* Caller serializes one accumulator per queue. Timestamps are QPC ticks at
+ * successful vkQueuePresentKHR returns, not scanout or GPU completion times. */
+struct pw_vk_present_interval {
+    uint64_t previous, intervals, maximum_us, over25, over33, over50;
+    int primed;
+};
+static inline int pw_vk_present_interval_add(struct pw_vk_present_interval *s,
+    uint64_t now, uint64_t frequency, int success, uint64_t *interval_us)
+{
+    uint64_t delta, seconds, us;
+    *interval_us = 0;
+    if (!success || !frequency || frequency > UINT64_MAX / 1000000) {
+        s->primed = 0;
+        return 0;
+    }
+    if (!s->primed || now < s->previous) {
+        s->previous = now; s->primed = 1;
+        return 0;
+    }
+    delta = now - s->previous; s->previous = now;
+    seconds = delta / frequency;
+    if (seconds > (UINT64_MAX - 999999) / 1000000) us = UINT64_MAX;
+    else us = seconds * 1000000 + (delta % frequency) * 1000000 / frequency;
+    *interval_us = us;
+    if (s->intervals != UINT64_MAX) ++s->intervals;
+    if (us > s->maximum_us) s->maximum_us = us;
+    /* Thresholds are strict, using ticks to avoid rounding away sub-us excess. */
+    if ((seconds || delta > frequency * 25 / 1000) && s->over25 != UINT64_MAX) ++s->over25;
+    if ((seconds || delta > frequency * 33 / 1000) && s->over33 != UINT64_MAX) ++s->over33;
+    if ((seconds || delta > frequency * 50 / 1000) && s->over50 != UINT64_MAX) ++s->over50;
+    return 1;
+}
+#endif
diff --git a/dlls/winevulkan/pw_vk_present_pe.c b/dlls/winevulkan/pw_vk_present_pe.c
new file mode 100644
--- /dev/null
+++ b/dlls/winevulkan/pw_vk_present_pe.c
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "vulkan_loader.h"
+#include "pw_vk_present_pe.h"
+#include "pw_vk_present_interval.h"
+#include <string.h>
+static INIT_ONCE once=INIT_ONCE_STATIC_INIT;
+static CRITICAL_SECTION gate;
+static LARGE_INTEGER frequency;
+static BOOL enabled;
+static struct {VkQueue queue;struct pw_vk_present_interval stats;} queues[8];
+static BOOL CALLBACK initialize(INIT_ONCE *o,void *parameter,void **context)
+{
+ char value[2];(void)o;(void)parameter;(void)context;
+ enabled=GetEnvironmentVariableA("PW_VK_BATCH_STATS",value,sizeof(value))==1&&value[0]=='1';
+ InitializeCriticalSection(&gate);QueryPerformanceFrequency(&frequency);return TRUE;
+}
+void pw_vk_present_forget(void)
+{
+ InitOnceExecuteOnce(&once,initialize,NULL,NULL);
+ if(!enabled)return;
+ EnterCriticalSection(&gate);memset(queues,0,sizeof(queues));LeaveCriticalSection(&gate);
+}
+void pw_vk_present_observe(unsigned int code,void *args,NTSTATUS status)
+{
+ LARGE_INTEGER now;unsigned i;uint64_t us=0;int valid;
+ struct pw_vk_present_interval copy;struct vkQueuePresentKHR_params *q=args;
+ if(code!=unix_vkQueuePresentKHR&&code!=unix_vkDestroyDevice)return;
+ InitOnceExecuteOnce(&once,initialize,NULL,NULL);
+ if(!enabled)return;
+ if(code==unix_vkDestroyDevice){if(!status)pw_vk_present_forget();return;}
+ /* Capture before taking the diagnostic lock on both architectures. */
+ if(!QueryPerformanceCounter(&now)){pw_vk_present_forget();return;}
+ EnterCriticalSection(&gate);
+ for(i=0;i<8;i++)if(!queues[i].queue||queues[i].queue==q->queue)break;
+ if(i==8){LeaveCriticalSection(&gate);WINE_MESSAGE("PW_VK_PRESENT_INTERVAL version=1 dropped=1 reason=queue_capacity\n");return;}
+ queues[i].queue=q->queue;
+ valid=pw_vk_present_interval_add(&queues[i].stats,now.QuadPart,frequency.QuadPart,
+     !status&&(q->result==VK_SUCCESS||q->result==VK_SUBOPTIMAL_KHR),&us);
+ copy=queues[i].stats;LeaveCriticalSection(&gate);
+ /* A failed Unix call does not promise an initialized VkResult output. */
+ WINE_MESSAGE("PW_VK_PRESENT_INTERVAL version=1 scope=queue_return queue=%p tick=%llu frequency=%llu result=%d status=%lu valid=%u interval_us=%llu intervals=%llu max_us=%llu over25ms=%llu over33ms=%llu over50ms=%llu\n",
+     q->queue,(UINT64)now.QuadPart,(UINT64)frequency.QuadPart,status?VK_ERROR_UNKNOWN:q->result,(ULONG)status,valid,
+     (UINT64)us,(UINT64)copy.intervals,(UINT64)copy.maximum_us,(UINT64)copy.over25,(UINT64)copy.over33,(UINT64)copy.over50);
+}
+
+NTSTATUS pw_vk_present_call(unsigned int code,void *args)
+{
+ if(code!=unix_vkQueuePresentKHR&&code!=unix_vkDestroyDevice)return WINE_UNIX_CALL(code,args);
+ InitOnceExecuteOnce(&once,initialize,NULL,NULL);
+ NTSTATUS status=WINE_UNIX_CALL(code,args);
+ pw_vk_present_observe(code,args,status);
+ return status;
+}
