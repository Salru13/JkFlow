+/* The project's own files in the game folder, shipped in the package. Any Blur
+ * version may be used, but these must match the package exactly. */
+static const char *const direct_required[] = {
+    "d3d9.dll", "d3d9_blur_dxvk.dll", "d3d9.c988.dll", "dxvk.conf"
+};
+static int direct_file_equal(const char *a, const char *b)
+{
+    static uint8_t left[65536], right[65536];
+    struct stat sa, sb;
+    int same = 0, fa = open(a, O_RDONLY), fb = open(b, O_RDONLY);
+    if (fa >= 0 && fb >= 0 && fstat(fa, &sa) == 0 && fstat(fb, &sb) == 0 && sa.st_size == sb.st_size) {
+        same = 1;
+        for (off_t remain = sa.st_size; remain > 0 && same;) {
+            size_t n = remain < (off_t)sizeof(left) ? (size_t)remain : sizeof(left);
+            if (!direct_read_exact(fa, left, n) || !direct_read_exact(fb, right, n) || memcmp(left, right, n)) same = 0;
+            remain -= (off_t)n;
+        }
+    }
+    if (fa >= 0) close(fa);
+    if (fb >= 0) close(fb);
+    return same;
+}
+static int direct_file_copy(const char *src, const char *dst)
+{
+    static uint8_t chunk[65536];
+    char temp[280];
+    int ok = 0, in = open(src, O_RDONLY), out;
+    snprintf(temp, sizeof(temp), "%s.install", dst);
+    out = open(temp, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    if (in >= 0 && out >= 0) {
+        ssize_t got;
+        ok = 1;
+        while (ok && (got = read(in, chunk, sizeof(chunk))) > 0)
+            for (ssize_t done = 0; ok && done < got;) {
+                ssize_t put = write(out, chunk + done, (size_t)(got - done));
+                if (put <= 0) ok = 0; else done += put;
+            }
+        if (got < 0) ok = 0;
+    }
+    if (in >= 0) close(in);
+    if (out >= 0) close(out);
+    if (ok && rename(temp, dst) != 0) ok = 0;
+    if (!ok) unlink(temp);
+    return ok;
+}
+/* The one supported Blur.exe. */
+static const uint8_t direct_blur_sha256[32] = { 0xdb,0xa0,0x26,0x4b,0x78,0x08,0xa5,0xe3,0x8d,0x99,0xc8,0xc1,0x62,0xec,0xd7,0x1a,0xb0,0x6a,0x48,0xfb,0xc4,0x24,0xfe,0xb1,0xb9,0xa3,0xbc,0x1b,0xff,0x2f,0xbf,0x3f };
