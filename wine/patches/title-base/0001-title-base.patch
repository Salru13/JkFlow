+/* The package icon's logo, enlarged with bilinear filtering. */
+static void blur_logo(const Canvas *c, int32_t x, int32_t y, int32_t scale)
+{
+    const int32_t lw = PW_BLUR_LOGO_W, lh = PW_BLUR_LOGO_H;
+    for (int32_t j = 0; j < lh*scale; j++) for (int32_t i = 0; i < lw*scale; i++) {
+        int32_t sx = i*256/scale, sy = j*256/scale;
+        int32_t x0 = sx>>8, y0 = sy>>8, fx = sx&255, fy = sy&255;
+        int32_t x1 = x0+1 < lw ? x0+1 : x0, y1 = y0+1 < lh ? y0+1 : y0;
+        const uint8_t *a = &pw_blur_logo[(size_t)(y0*lw+x0)*3], *b = &pw_blur_logo[(size_t)(y0*lw+x1)*3];
+        const uint8_t *e = &pw_blur_logo[(size_t)(y1*lw+x0)*3], *f = &pw_blur_logo[(size_t)(y1*lw+x1)*3];
+        uint32_t ch[3];
+        for (int k = 0; k < 3; k++) {
+            int32_t top = a[k]*(256-fx)+b[k]*fx, bottom = e[k]*(256-fx)+f[k]*fx;
+            ch[k] = (uint32_t)((top*(256-fy)+bottom*fy)>>16);
+        }
+        /* Fade the crop's edges so the glow has no visible rectangle. */
+        int32_t dx = i < lw*scale-1-i ? i : lw*scale-1-i, dy = j < lh*scale-1-j ? j : lh*scale-1-j;
+        int32_t edge = dx < dy ? dx : dy;
+        if (edge < 56) for (int k = 0; k < 3; k++) ch[k] = ch[k]*(uint32_t)edge/56u;
+        put(c, x+i, y+j, rgb(ch[0], ch[1], ch[2]));
+    }
+}
