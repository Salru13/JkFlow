+    staged_end=$(tail -c 65 "$OUT/pkg-stage/seed245/blur-native248/seed.idx" | head -c 64)
+    [[ $staged_end == "$N245_SEED_END" ]] || {
+      echo "   X staged seed245 END $staged_end is not N245_SEED_END $N245_SEED_END" >&2; exit 1;
