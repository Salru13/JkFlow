diff -ruN a/prospero/native/native245_seed.c b/prospero/native/native245_seed.c
--- a/prospero/native/native245_seed.c
+++ b/prospero/native/native245_seed.c
@@ -0,0 +1,945 @@
+/* native245_seed.c -- first-launch seed importer (task 245). See native245_seed.h.
+ *
+ * Source anchors (pinned orbis-win 61c03197 == release 9749fcd for src/ and
+ * scripts/, research/agents/native-source-parity.md):
+ *   research/agents/orbis-win-architecture/native-wine64_main.c
+ *     101-108  runtime_roots = { "/app0", PW_SANDBOX_APP0 }: where package files are seen
+ *     110-115  library root /data/prospero-win after the grant
+ *     777-812  open_library(): grant, then pw_wine_library_load(library_root)
+ *     1186-1189 prefix = <root>/prefixes/<profile prefix>
+ *     1300-1310 launcher copies the CPU DLL into <prefix>/drive_c/windows/system32
+ *   research/agents/orbis-win-architecture/native-pw_wine_library.c
+ *     18,42-54  only "<[a-z0-9_-]+>.profile" names are profiles (a ".n245part" temp is invisible)
+ *     154-194   profiles.lst (when present) replaces the directory scan; a bad index hides all
+ *     196-203   first parsed entry with the id wins
+ *   research/agents/orbis-win-architecture/native-pw_wine_prefix.c
+ *     12-22     mkdir 0777, temp ".new" + rename idiom reused here
+ */
+#include "native245_seed.h"
+
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#ifdef N245_TEST_HOOKS
+int (*n245_test_fault)(const char *op, const char *path) = NULL;
+int n245_test_skip_fsync = 0;
+#define N245_FAULT(op, path) (n245_test_fault && n245_test_fault((op), (path)))
+#define N245_FSYNC(fd) (n245_test_skip_fsync ? 0 : fsync(fd))
+#else
+#define N245_FAULT(op, path) 0
+#define N245_FSYNC(fd) fsync(fd)
+#endif
+
+/* ------------------------------------------------------------------ SHA-256 */
+static const uint32_t n245_k[64] = {
+    0x428a2f98u, 0x71374491u, 0xb5c0fbcfu, 0xe9b5dba5u, 0x3956c25bu, 0x59f111f1u, 0x923f82a4u, 0xab1c5ed5u,
+    0xd807aa98u, 0x12835b01u, 0x243185beu, 0x550c7dc3u, 0x72be5d74u, 0x80deb1feu, 0x9bdc06a7u, 0xc19bf174u,
+    0xe49b69c1u, 0xefbe4786u, 0x0fc19dc6u, 0x240ca1ccu, 0x2de92c6fu, 0x4a7484aau, 0x5cb0a9dcu, 0x76f988dau,
+    0x983e5152u, 0xa831c66du, 0xb00327c8u, 0xbf597fc7u, 0xc6e00bf3u, 0xd5a79147u, 0x06ca6351u, 0x14292967u,
+    0x27b70a85u, 0x2e1b2138u, 0x4d2c6dfcu, 0x53380d13u, 0x650a7354u, 0x766a0abbu, 0x81c2c92eu, 0x92722c85u,
+    0xa2bfe8a1u, 0xa81a664bu, 0xc24b8b70u, 0xc76c51a3u, 0xd192e819u, 0xd6990624u, 0xf40e3585u, 0x106aa070u,
+    0x19a4c116u, 0x1e376c08u, 0x2748774cu, 0x34b0bcb5u, 0x391c0cb3u, 0x4ed8aa4au, 0x5b9cca4fu, 0x682e6ff3u,
+    0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u, 0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u};
+
+static uint32_t n245_ror(uint32_t x, unsigned n) { return (x >> n) | (x << (32u - n)); }
+
+static void n245_sha256_block(N245Sha256 *s, const unsigned char *p)
+{
+    uint32_t w[64], a, b, c, d, e, f, g, h;
+    unsigned i;
+    for (i = 0; i < 16; i++)
+        w[i] = (uint32_t)p[4 * i] << 24 | (uint32_t)p[4 * i + 1] << 16 | (uint32_t)p[4 * i + 2] << 8 |
+               (uint32_t)p[4 * i + 3];
+    for (i = 16; i < 64; i++) {
+        uint32_t s0 = n245_ror(w[i - 15], 7) ^ n245_ror(w[i - 15], 18) ^ (w[i - 15] >> 3);
+        uint32_t s1 = n245_ror(w[i - 2], 17) ^ n245_ror(w[i - 2], 19) ^ (w[i - 2] >> 10);
+        w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+    }
+    a = s->h[0]; b = s->h[1]; c = s->h[2]; d = s->h[3];
+    e = s->h[4]; f = s->h[5]; g = s->h[6]; h = s->h[7];
+    for (i = 0; i < 64; i++) {
+        uint32_t t1 = h + (n245_ror(e, 6) ^ n245_ror(e, 11) ^ n245_ror(e, 25)) + ((e & f) ^ (~e & g)) +
+                      n245_k[i] + w[i];
+        uint32_t t2 = (n245_ror(a, 2) ^ n245_ror(a, 13) ^ n245_ror(a, 22)) + ((a & b) ^ (a & c) ^ (b & c));
+        h = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
+    }
+    s->h[0] += a; s->h[1] += b; s->h[2] += c; s->h[3] += d;
+    s->h[4] += e; s->h[5] += f; s->h[6] += g; s->h[7] += h;
+}
+
+void n245_sha256_init(N245Sha256 *s)
+{
+    static const uint32_t iv[8] = {0x6a09e667u, 0xbb67ae85u, 0x3c6ef372u, 0xa54ff53au,
+                                   0x510e527fu, 0x9b05688cu, 0x1f83d9abu, 0x5be0cd19u};
+    memcpy(s->h, iv, sizeof(iv));
+    s->length = 0;
+    s->used = 0;
+}
+
+void n245_sha256_update(N245Sha256 *s, const void *data, size_t size)
+{
+    const unsigned char *p = (const unsigned char *)data;
+    s->length += size;
+    while (size) {
+        size_t take = 64 - s->used;
+        if (take > size) take = size;
+        memcpy(s->block + s->used, p, take);
+        s->used += take;
+        p += take;
+        size -= take;
+        if (s->used == 64) {
+            n245_sha256_block(s, s->block);
+            s->used = 0;
+        }
+    }
+}
+
+void n245_sha256_hex(N245Sha256 *s, char out[65])
+{
+    static const char digits[] = "0123456789abcdef";
+    uint64_t bits = s->length * 8u;
+    unsigned char pad = 0x80, zero = 0, len[8];
+    unsigned i;
+    n245_sha256_update(s, &pad, 1);
+    while (s->used != 56) n245_sha256_update(s, &zero, 1);
+    for (i = 0; i < 8; i++) len[i] = (unsigned char)(bits >> (56 - 8 * i));
+    n245_sha256_update(s, len, 8);
+    for (i = 0; i < 32; i++) {
+        unsigned char byte = (unsigned char)(s->h[i / 4] >> (24 - 8 * (i % 4)));
+        out[2 * i] = digits[byte >> 4];
+        out[2 * i + 1] = digits[byte & 15];
+    }
+    out[64] = 0;
+}
+
+static void n245_sha256_of(const void *data, size_t size, char out[65])
+{
+    N245Sha256 s;
+    n245_sha256_init(&s);
+    n245_sha256_update(&s, data, size);
+    n245_sha256_hex(&s, out);
+}
+
+/* ------------------------------------------------------------------ pin */
+const char *n245_seed_pinned_end(void)
+{
+#ifdef N245_SEED_END
+    return N245_SEED_END;
