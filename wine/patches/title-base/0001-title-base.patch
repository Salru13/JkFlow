diff -ruN a/prospero/native/native279-username-env.c b/prospero/native/native279-username-env.c
--- a/prospero/native/native279-username-env.c
+++ b/prospero/native/native279-username-env.c
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "native279-username-env.h"
+static int reserved(const char *name)
+{
+    static const char key[]="PW_BLUR_DISPLAY_NAME";
+    if(!name)return 0;
+    for(size_t i=0;;++i) {
+        unsigned char a=(unsigned char)name[i],b=(unsigned char)key[i];
+        if(a>='a' && a<='z')a=(unsigned char)(a-'a'+'A');
+        if(a!=b)return 0;
+        if(!a)return 1;
+    }
+}
+int pw_blur_name_export(PwWineStartEnv *env,uint32_t *count,size_t cap,const char *value)
+{
+    size_t kept=0;
+    if(!env || !count || !value || *count>cap || cap>PW_WINE_START_MAX_ENV)return -1;
+    for(size_t i=0;i<*count;++i) {
+        if(!env[i].name || !env[i].value)return -1;
+        if(!reserved(env[i].name))++kept;
+    }
+    if(kept>=cap)return -1;
+    kept=0;
+    for(size_t i=0;i<*count;++i)if(!reserved(env[i].name))env[kept++]=env[i];
+    env[kept++]=(PwWineStartEnv){"PW_BLUR_DISPLAY_NAME",value};
+    *count=(uint32_t)kept;return 0;
+}
