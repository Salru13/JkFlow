+int pw_blur_name_setup_render(const PwPresentTarget *target,const char *message,int stopped);
+static void direct_player_name_setup(PwBlurName *name,PwOskPs5 *osk,PwVideoOutPs5 *video,
+                                      int video_status,int force_edit)
+{
+    PwBlurNameSetup setup;PwBlurNameFile file;
+    PwBlurNameSetupOps ops={&file,pw_blur_name_file_load,pw_blur_name_file_save,NULL};
+    /* First-entry IME is a native setup dialog, independent of Wine's guest
+     * keyboard sink. Module preload already happened before the /data grant. */
+    if((force_edit || !pw_blur_name_portable(name)) && name->user_id>=0 && !osk->ready)
+        (void)pw_osk_ps5_open(osk,pw_osk_ps5_system_ops(osk_log),name->user_id);
+    if(pw_blur_name_file_init(&file,library_root,name->user_id)){ops.load=NULL;ops.save=NULL;}
+    int state=pw_blur_name_setup_begin(&setup,name,osk,&ops,force_edit);
+    if(state==PW_BLUR_SETUP_READY){*name=setup.selected;return;}
+    const size_t bytes=(size_t)PW_LAUNCHER_RENDER_WIDTH*PW_LAUNCHER_RENDER_HEIGHT*4u;
+    uint8_t *frame=mmap(NULL,bytes,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANON,-1,0);
+    if(video_status!=PW_OK || frame==MAP_FAILED) {
+        pw_blur_name_setup_close(&setup);
+        PS5LOG_LOG("PW_WINE64 display_name setup=failed reason=display-unavailable");
+        leave_to_home("blur-name-setup-display-unavailable");
+    }
+    const PwPresentTarget target={frame,PW_LAUNCHER_RENDER_WIDTH,PW_LAUNCHER_RENDER_HEIGHT,
+                                  PW_LAUNCHER_RENDER_WIDTH*4u,bytes};
+    const PwPresentView view={frame,target.width,target.height,target.stride,(uint32_t)bytes};
+    for(;;) {
+        if(state==PW_BLUR_SETUP_READY) {
+            *name=setup.selected;pw_blur_name_setup_close(&setup);munmap(frame,bytes);
+            PS5LOG_LOG("PW_WINE64 display_name setup=ready source=%s bytes=%u",
+                       setup.source==PW_BLUR_SETUP_ENTERED?"entered":"saved-fallback",(unsigned)name->bytes);
+            return;
+        }
+        int stopped=state!=PW_BLUR_SETUP_WAIT;
+        int rc=pw_blur_name_setup_render(&target,setup.message,stopped);
+        if(rc==PW_OK)rc=pw_videoout_ps5_present(video,&view);
+        (void)sceGnmSubmitDone();
+        if(rc!=PW_OK) {
+            pw_blur_name_setup_close(&setup);
+            PS5LOG_LOG("PW_WINE64 display_name setup=failed reason=present status=%d",rc);
+            leave_to_home("blur-name-setup-present-failed");
+        }
+        if(stopped) {
+            PS5LOG_LOG("PW_WINE64 display_name setup=%s error=%d no_game_launch=1",
+                       state==PW_BLUR_SETUP_CANCELLED?"cancelled":"failed",setup.error);
+            for(;;)usleep(250000); /* explicit page; no restart/relaunch loop */
+        }
+        usleep(PW_WINE64_TICK_US);
+        state=pw_blur_name_setup_poll(&setup);
+    }
+}
