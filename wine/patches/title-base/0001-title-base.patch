+static uint32_t sha_rotr(uint32_t x, int n) { return (x >> n) | (x << (32 - n)); }
+static void sha_block(uint32_t h[8], const uint8_t *p)
+{
+    static const uint32_t k[64] = {
+        0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
+        0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
+        0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
+        0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
+        0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
+        0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
+        0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
+        0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
+    };
+    uint32_t w[64], v[8];
+    for (int i = 0; i < 16; i++)
+        w[i] = (uint32_t)p[i*4] << 24 | (uint32_t)p[i*4+1] << 16 | (uint32_t)p[i*4+2] << 8 | p[i*4+3];
+    for (int i = 16; i < 64; i++) {
+        uint32_t s0 = sha_rotr(w[i-15],7) ^ sha_rotr(w[i-15],18) ^ (w[i-15] >> 3);
+        uint32_t s1 = sha_rotr(w[i-2],17) ^ sha_rotr(w[i-2],19) ^ (w[i-2] >> 10);
+        w[i] = w[i-16] + s0 + w[i-7] + s1;
+    }
+    memcpy(v, h, sizeof(v));
+    for (int i = 0; i < 64; i++) {
+        uint32_t t1 = v[7] + (sha_rotr(v[4],6) ^ sha_rotr(v[4],11) ^ sha_rotr(v[4],25)) +
+                      ((v[4] & v[5]) ^ (~v[4] & v[6])) + k[i] + w[i];
+        uint32_t t2 = (sha_rotr(v[0],2) ^ sha_rotr(v[0],13) ^ sha_rotr(v[0],22)) +
+                      ((v[0] & v[1]) ^ (v[0] & v[2]) ^ (v[1] & v[2]));
+        v[7] = v[6]; v[6] = v[5]; v[5] = v[4]; v[4] = v[3] + t1;
+        v[3] = v[2]; v[2] = v[1]; v[1] = v[0]; v[0] = t1 + t2;
+    }
+    for (int i = 0; i < 8; i++) h[i] += v[i];
+}
+/* SHA-256 of a whole file; returns 1 on success. */
+static int direct_file_sha256(const char *path, uint8_t out[32])
+{
+    static uint8_t chunk[65536];
+    uint32_t h[8] = { 0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19 };
+    uint8_t tail[128];
+    uint64_t total = 0;
+    size_t used = 0;
+    ssize_t got;
+    int fd = open(path, O_RDONLY);
+    if (fd < 0) return 0;
+    while ((got = read(fd, chunk + used, sizeof(chunk) - used)) > 0) {
+        size_t have = used + (size_t)got, off = 0;
+        total += (uint64_t)got;
+        for (; have - off >= 64; off += 64) sha_block(h, chunk + off);
+        used = have - off;
+        memmove(chunk, chunk + off, used);
+    }
+    close(fd);
+    if (got < 0) return 0;
+    memset(tail, 0, sizeof(tail));
+    memcpy(tail, chunk, used);
+    tail[used] = 0x80;
+    size_t pad = used < 56 ? 64 : 128;
+    for (int i = 0; i < 8; i++) tail[pad - 1 - (size_t)i] = (uint8_t)((total * 8) >> (8 * i));
+    sha_block(h, tail);
+    if (pad == 128) sha_block(h, tail + 64);
+    for (int i = 0; i < 8; i++) {
+        out[i*4] = (uint8_t)(h[i] >> 24); out[i*4+1] = (uint8_t)(h[i] >> 16);
+        out[i*4+2] = (uint8_t)(h[i] >> 8); out[i*4+3] = (uint8_t)h[i];
+    }
+    return 1;
+}
+enum { DIRECT_GAME_MISSING = 0, DIRECT_GAME_OK = 1, DIRECT_INSTALL_FAILED = 2, DIRECT_GAME_WRONG = 3 };
+/* Hashes again only when the file changes, so the page's polling stays cheap
+ * and a copy still in progress settles by itself. */
+static int direct_game_state(void)
+{
+    static off_t last_size = -1;
+    static time_t last_time;
+    static int last_state = DIRECT_GAME_MISSING;
+    static const char path[] = "/data/Pc/Blur/Blur.exe";
+    struct stat st;
+    uint8_t digest[32];
+    if (stat(path, &st) != 0 || !S_ISREG(st.st_mode)) { last_size = -1; return DIRECT_GAME_MISSING; }
+    if (st.st_size == last_size && st.st_mtime == last_time) return last_state;
+    last_size = st.st_size;
+    last_time = st.st_mtime;
+    last_state = direct_game_file_ok(path) && direct_file_sha256(path, digest) &&
+                 !memcmp(digest, direct_blur_sha256, sizeof(digest)) ? DIRECT_GAME_OK : DIRECT_GAME_WRONG;
+    PS5LOG_LOG("PW_WINE64 Blur game check size=%lld state=%d", (long long)st.st_size, last_state);
+    return last_state;
+}
