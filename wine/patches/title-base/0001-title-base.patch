+                             PwOskPs5 *osk,const PwBlurNameSetupOps *ops,int force_edit);
+int pw_blur_name_setup_poll(PwBlurNameSetup *setup);
+void pw_blur_name_setup_close(PwBlurNameSetup *setup);
+
+enum { PW_BLUR_NAME_PATH=768,PW_BLUR_NAME_DISK_MAX=65 };
+typedef struct PwBlurNameFile {
+    char directory[PW_BLUR_NAME_PATH],path[PW_BLUR_NAME_PATH];
+    unsigned char before[PW_BLUR_NAME_DISK_MAX];
+    size_t before_size;
+    int32_t user;
+    int loaded,before_exists,last_error;
+    unsigned serial;
+} PwBlurNameFile;
