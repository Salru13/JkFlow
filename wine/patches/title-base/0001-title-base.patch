+/* Returns 1 when every required file matches the package afterwards. */
+static int direct_install_required(void)
+{
+    char root[200] = "", src[280], dst[280];
+    int failed = 0;
+    for (size_t i = 0; i < sizeof(runtime_roots) / sizeof(runtime_roots[0]) && !root[0]; i++) {
+        snprintf(src, sizeof(src), "%s/blur-files/%s", runtime_roots[i], direct_required[0]);
+        if (access(src, R_OK) == 0) snprintf(root, sizeof(root), "%s/blur-files", runtime_roots[i]);
+    }
+    /* The app sets up its own folders, before the user has copied anything. */
+    (void)mkdir("/data/Pc", 0777);
+    (void)mkdir("/data/Pc/Blur", 0777);
+    if (!root[0]) {
+        PS5LOG_LOG("PW_WINE64 Blur files status=package-folder-missing");
+        return 0;
+    }
+    for (size_t i = 0; i < sizeof(direct_required) / sizeof(direct_required[0]); i++) {
+        snprintf(src, sizeof(src), "%s/%s", root, direct_required[i]);
+        snprintf(dst, sizeof(dst), "/data/Pc/Blur/%s", direct_required[i]);
+        int copied = 0;
+        if (!direct_file_equal(src, dst)) {
+            copied = direct_file_copy(src, dst);
+            if (!copied || !direct_file_equal(src, dst)) {
+                PS5LOG_LOG("PW_WINE64 Blur files status=failed file=%s errno=%d", direct_required[i], errno);
+                failed = 1;
+                continue;
+            }
+        }
+        PS5LOG_LOG("PW_WINE64 Blur files file=%s %s", direct_required[i], copied ? "installed" : "ok");
+    }
+    return !failed;
+}
