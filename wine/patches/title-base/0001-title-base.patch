+         "$PW"/native/native279-username.c "$PW"/native/native279-username-orbis.c "$PW"/native/native279-username-env.c "$PW"/native/native280-username-ui.c "$PW"/native/native280-username-ui-file.c "$PW"/native/pw_osk_ps5.c "$PW"/native/native245_seed.c "$PW"/native/ps5log/*.c; do
   [ -f "$f" ] || continue
   $CC $CFL -c "$f" -o "$OBJ/$(echo "${f#$PW/}" | tr '/' '_' | sed 's/\.c$/.o/')"
 done
@@ -249,6 +265,16 @@
   done
