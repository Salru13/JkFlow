+/* Normal-mode start page: a found game waits for Cross, a missing one explains
+ * where to put it. The file is checked again while the page is up, so a copy
+ * finished over FTP is picked up without restarting. */
+int pw_blur_start_render(const PwPresentTarget *target, int state);
+static void direct_start_screen(void)
+{
+    static PwVideoOutPs5 video;
+    static PwPadPs5 pad;
+    PwPadPs5Ops pad_ops;
+    const size_t size = (size_t)PW_LAUNCHER_RENDER_WIDTH * PW_LAUNCHER_RENDER_HEIGHT * 4u;
+    uint8_t *frame = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+    int video_status = pw_videoout_ps5_open(&video);
+    int pad_status = pw_pad_ps5_platform_ops(&pad_ops);
+    int found = -1, ready = 0, ops_ok = pad_status == PW_OK;
+    const int installed = direct_install_required();
+
+    if (ops_ok)
+        pad_status = pw_pad_ps5_open(&pad, &pad_ops, pad_open_map,
+                                     sizeof(pad_open_map) / sizeof(pad_open_map[0]));
+    if (video_status != PW_OK || frame == MAP_FAILED) {
+        PS5LOG_LOG("PW_WINE64 Blur start page video=%s frame=%d", pw_result_name(video_status), frame != MAP_FAILED);
+        if (pad_status == PW_OK) (void)pw_pad_ps5_close(&pad);
+        if (installed && direct_game_state() == DIRECT_GAME_OK) return;
+        for (;;) usleep(250000);
+    }
+    const PwPresentTarget target = { frame, PW_LAUNCHER_RENDER_WIDTH, PW_LAUNCHER_RENDER_HEIGHT,
+                                     PW_LAUNCHER_RENDER_WIDTH * 4u, size };
+    const PwPresentView view = { frame, target.width, target.height, target.stride, (uint32_t)size };
+    for (uint64_t tick = 0;; tick++) {
+        if (tick % (2 * PW_WINE64_TICKS_PER_S) == 0) {
+            int now_found = installed ? direct_game_state() : DIRECT_INSTALL_FAILED;
+            if (now_found != found) {
+                found = now_found;
+                ready = found == DIRECT_GAME_OK;
+                int rc = pw_blur_start_render(&target, found);
+                if (rc == PW_OK) rc = pw_videoout_ps5_present(&video, &view);
+                PS5LOG_LOG("PW_WINE64 Blur start page found=%d ready=%d present=%s", found, ready, pw_result_name(rc));
+            }
+            /* No controller signed in yet: keep trying while the page is up. */
+            if (pad_status != PW_OK && ops_ok && tick)
+                pad_status = pw_pad_ps5_open(&pad, &pad_ops, pad_open_map,
+                                             sizeof(pad_open_map) / sizeof(pad_open_map[0]));
+        }
+        if (ready && pad_status == PW_OK && pw_pad_ps5_read(&pad) == PW_OK &&
+            (pad.core.pressed_edges & PAD_CROSS))
+            break;
+        usleep(PW_WINE64_TICK_US);
+    }
+    PS5LOG_LOG("PW_WINE64 Blur start page chose=start");
+    (void)pw_pad_ps5_close(&pad);
+    (void)pw_videoout_ps5_close(&video);
+    munmap(frame, size);
+}
