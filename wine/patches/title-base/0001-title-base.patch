+/* Blur: the PS4's seventh core, asked for by `env = PW_SEVENTH_CORE=1` in the
+ * game profile. A thread inherits its creator's affinity, so setting it here,
+ * before Wine starts, covers every later thread. */
+extern void *scePthreadSelf(void);
+extern int scePthreadSetaffinity(void *thread, uint64_t mask);
+extern int scePthreadGetaffinity(void *thread, uint64_t *mask);
+static void pw_blur_seventh_core(int wanted)
+{
+    void *self = scePthreadSelf();
+    uint64_t had = 0, got = 0;
+    int get_rc = scePthreadGetaffinity(self, &had);
+    if (!wanted) {
+        PS5LOG_LOG("PW_WINE64 cores mask=%#llx seventh=off get_rc=%d", (unsigned long long)had, get_rc);
+        return;
+    }
+    int probe_rc = scePthreadSetaffinity(self, 0x40);
+    int check_rc = scePthreadGetaffinity(self, &got);
+    if (probe_rc == 0 && check_rc == 0 && got == 0x40) {
+        int set_rc = scePthreadSetaffinity(self, 0x7f);
+        scePthreadGetaffinity(self, &got);
+        PS5LOG_LOG("PW_WINE64 cores seventh=granted mask=%#llx was=%#llx set_rc=%d", (unsigned long long)got,
+                   (unsigned long long)had, set_rc);
+    } else {
+        int restore_rc = scePthreadSetaffinity(self, had);
+        PS5LOG_LOG("PW_WINE64 cores seventh=refused probe_rc=%#x check_rc=%#x got=%#llx restored=%#llx restore_rc=%d",
+                   probe_rc, check_rc, (unsigned long long)got, (unsigned long long)had, restore_rc);
+    }
+}
