diff -ruN a/prospero/native/pw_remote_control.h b/prospero/native/pw_remote_control.h
--- a/prospero/native/pw_remote_control.h
+++ b/prospero/native/pw_remote_control.h
@@ -0,0 +1,125 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Bounded file transport for the existing title input/lifecycle, not shell control. */
+#ifndef PW_REMOTE_CONTROL_H
+#define PW_REMOTE_CONTROL_H
+#include <ctype.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+enum { PW_RC_NONE, PW_RC_LAUNCH, PW_RC_PAD, PW_RC_RELEASE, PW_RC_CLOSE };
+typedef struct PwRemoteControl {
+    char root[512], session[64], profile[64], target[64];
+    const char *phase, *result;
+    uint32_t seq;
+    uint64_t poll_at, status_at, expires;
+    int enabled, action;
+    unsigned buttons, lt, rt;
+    int lx, ly, rx, ry;
+} PwRemoteControl;
+
+static void pw_rc_release(PwRemoteControl *c) {
+    c->expires=0; c->buttons=c->lt=c->rt=0; c->lx=c->ly=c->rx=c->ry=0;
+}
+static int pw_rc_id(const char *s) {
+    size_t n=strlen(s); if(!n || n>63) return 0;
+    for(size_t i=0;i<n;i++) if(!isalnum((unsigned char)s[i]) && s[i]!='_' && s[i]!='-') return 0;
+    return 1;
+}
+static int pw_rc_number(const char *s, long lo, long hi, long *v) {
+    char *end; if(!*s || *s=='+' || (lo>=0 && *s=='-')) return 0;
+    errno=0; long n=strtol(s,&end,0);
+    if(errno || *end || n<lo || n>hi) return 0;
+    *v=n; return 1;
+}
+static int pw_rc_path(PwRemoteControl *c,char *out,size_t cap,const char *leaf) {
+    int n=snprintf(out,cap,"%s/control/%s",c->root,leaf); return n>0 && (size_t)n<cap;
+}
+static int pw_rc_publish(PwRemoteControl *c,const char *leaf,int ack) {
+    char path[640],tmp[650];
+    if(!pw_rc_path(c,path,sizeof(path),leaf)) return 0;
+    snprintf(tmp,sizeof(tmp),"%s.tmp",path);
+    FILE *f=fopen(tmp,"wb"); if(!f) return 0;
+    int ok;
+    if(ack) ok=fprintf(f,"{\"version\":1,\"session\":\"%s\",\"seq\":%u,\"result\":\"%s\"}\n",c->session,c->seq,c->result)>=0;
+    else ok=fprintf(f,"{\"version\":1,\"session\":\"%s\",\"phase\":\"%s\",\"profile\":\"%s\",\"last_seq\":%u,\"result\":\"%s\",\"active\":%s,\"held\":%s}\n",c->session,c->phase,c->profile,c->seq,c->result,c->enabled?"true":"false",c->expires?"true":"false")>=0;
+    if(fclose(f)) ok=0;
+    return ok && rename(tmp,path)==0;
+}
+static int pw_rc_ack(PwRemoteControl *c,const char *result) {
+    c->result=result;
+    int ok=pw_rc_publish(c,"ack.json",1);
+    (void)pw_rc_publish(c,"status.json",0);
+    return ok;
+}
+static void pw_rc_init(PwRemoteControl *c,const char *root,const char *phase,const char *profile,uint64_t now) {
+    memset(c,0,sizeof(*c)); c->phase=phase; c->result="ready";
+    if(strlen(root)>=sizeof(c->root)) return;
+    strcpy(c->root,root);
+    if(profile && pw_rc_id(profile)) strcpy(c->profile,profile);
+    snprintf(c->session,sizeof(c->session),"%lu-%llu",(unsigned long)getpid(),(unsigned long long)now);
+}
+/* Mutate no state on malformed or stale input. Host parser rejects extra tokens. */
+static int pw_rc_parse(PwRemoteControl *c,char *line,uint64_t now) {
+    char *tok[13],*save=NULL,*s=strtok_r(line," \t\r\n",&save); unsigned n=0;
+    while(s && n<13) {tok[n++]=s;s=strtok_r(NULL," \t\r\n",&save);}
+    long seq,v[8];
+    if(s || n<4 || strcmp(tok[0],"PWCTRL1") || strcmp(tok[1],c->session) ||
+       !pw_rc_number(tok[2],1,4294967295L,&seq) || (uint32_t)seq<=c->seq) return 0;
+    int action=PW_RC_NONE;
+    if(n==5 && !strcmp(tok[3],"LAUNCH") && pw_rc_id(tok[4])) action=PW_RC_LAUNCH;
+    else if(n==4 && !strcmp(tok[3],"RELEASE")) action=PW_RC_RELEASE;
+    else if(n==4 && !strcmp(tok[3],"CLOSE")) action=PW_RC_CLOSE;
+    else if(n==12 && !strcmp(tok[3],"PAD")) {
+        for(unsigned i=0;i<8;i++) {
+            long lo=i>=3 && i<=6?-32768: i==7?1:0;
+            long hi=i==0?65535:i<3?255:i==7?5000:32767;
+            if(!pw_rc_number(tok[4+i],lo,hi,&v[i])) return 0;
+        }
+        if(v[0] & ~0xf3ffL) return 0; /* reject Guide and reserved bit */
+        action=PW_RC_PAD;
+    }
+    if(!action) return 0;
+    c->seq=(uint32_t)seq; c->action=action;
+    if(action==PW_RC_LAUNCH) strcpy(c->target,tok[4]);
+    if(action==PW_RC_PAD) {
+        c->buttons=(unsigned)v[0];c->lt=(unsigned)v[1];c->rt=(unsigned)v[2];
+        c->lx=(int)v[3];c->ly=(int)v[4];c->rx=(int)v[5];c->ry=(int)v[6];
+        c->expires=now+(uint64_t)v[7]*1000000u;
+    }
+    if(action==PW_RC_RELEASE || action==PW_RC_CLOSE) pw_rc_release(c);
+    return action;
+}
+static int pw_rc_poll(PwRemoteControl *c,uint64_t now) {
+    if(c->expires && now>=c->expires) pw_rc_release(c);
+    if(now<c->poll_at || !c->root[0]) return 0;
+    c->poll_at=now+200000000u;
+    char path[640],text[514];
+    snprintf(path,sizeof(path),"%s/pw_remote_control",c->root);
+    FILE *f=fopen(path,"rb"); size_t got=f?fread(text,1,4,f):0; if(f) fclose(f);
+    int enabled=(got==1 && text[0]=='1') || (got==2 && text[0]=='1' && text[1]=='\n');
+    if(!enabled) { if(c->enabled) {c->enabled=0;pw_rc_release(c);(void)pw_rc_publish(c,"status.json",0);} return 0; }
+    if(!c->enabled) {
+        c->enabled=1; pw_rc_path(c,path,sizeof(path),"");
+        if(mkdir(path,0700) && errno!=EEXIST) {c->enabled=0;return 0;}
+        /* Commands queued during a disabled interval must never replay. */
+        snprintf(c->session,sizeof(c->session),"%lu-%llu",(unsigned long)getpid(),(unsigned long long)now);
+        c->seq=0;c->result="ready";c->status_at=0;
+    }
+    if(now>=c->status_at) {(void)pw_rc_publish(c,"status.json",0);c->status_at=now+1000000000u;}
+    pw_rc_path(c,path,sizeof(path),"command.txt");f=fopen(path,"rb");if(!f) return 0;
+    got=fread(text,1,513,f);int bad=ferror(f);fclose(f);
+    if(bad || !got || got>512 || memchr(text,0,got)) return 0;
+    text[got]=0;
+    int action=pw_rc_parse(c,text,now);
+    if(action && ((action==PW_RC_LAUNCH && strcmp(c->phase,"launcher")) ||
+                  ((action==PW_RC_PAD || action==PW_RC_CLOSE) && strcmp(c->phase,"game")))) {
+        pw_rc_release(c);(void)pw_rc_ack(c,"wrong_phase");return 0;
+    }
+    return action;
+}
+#endif
