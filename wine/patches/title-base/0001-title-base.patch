+      ( cd "$OUT/pkg-stage" && sha256sum --quiet --strict -c "$N245_SEED_DIR/runtime-pins.sha256" ) || {
+        echo "   X staged Wine PE runtime does not match the seed245 runtime pins" >&2; exit 1;
