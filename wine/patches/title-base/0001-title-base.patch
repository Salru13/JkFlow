diff -ruN a/prospero/native/native279-username.c b/prospero/native/native279-username.c
--- a/prospero/native/native279-username.c
+++ b/prospero/native/native279-username.c
@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "native279-username.h"
+#include <string.h>
+
+static void clear(PwBlurName *out) { memset(out,0,sizeof(*out)); out->user_id=-1; }
+
+int pw_blur_name_validate(const char *text, size_t extent, PwBlurName *out)
+{
+    PwBlurName value;
+    size_t length=0, i=0, units=0, scalars=0;
+    int visible=0;
+    if(!out) return 0;
+    clear(out); clear(&value);
+    if(!text || !extent) return 0;
+    while(length<extent && length<PW_BLUR_NAME_UTF8_CAP && text[length]) ++length;
+    if(!length || length>=extent || length>=PW_BLUR_NAME_UTF8_CAP) return 0;
+    while(i<length) {
+        unsigned char first=(unsigned char)text[i++];
+        uint32_t code; unsigned extra; uint32_t minimum;
+        if(first<0x80) {code=first;extra=0;minimum=0;}
+        else if(first>=0xc2 && first<=0xdf) {code=first&31;extra=1;minimum=0x80;}
+        else if(first>=0xe0 && first<=0xef) {code=first&15;extra=2;minimum=0x800;}
+        else if(first>=0xf0 && first<=0xf4) {code=first&7;extra=3;minimum=0x10000;}
+        else return 0;
+        if(i+extra>length) return 0;
+        for(unsigned j=0;j<extra;++j) {
+            unsigned char next=(unsigned char)text[i++];
+            if((next&0xc0)!=0x80) return 0;
+            code=(code<<6)|(next&63);
+        }
+        if(code<minimum || code>0x10ffff || (code>=0xd800 && code<=0xdfff) ||
+           code<0x20 || (code>=0x7f && code<=0x9f) || code==0x2028 || code==0x2029 ||
+           (code&0xffff)==0xfffe || (code&0xffff)==0xffff || ++scalars>PW_BLUR_NAME_SCALARS) return 0;
+        if(!(code==0x20 || code==0xa0 || code==0x1680 || (code>=0x2000 && code<=0x200a) ||
+             code==0x202f || code==0x205f || code==0x3000)) visible=1;
+        if(units+(code<0x10000?1u:2u)>=PW_BLUR_NAME_UTF16_CAP) return 0;
+        if(code<0x10000) value.utf16[units++]=(uint16_t)code;
+        else {code-=0x10000;value.utf16[units++]=(uint16_t)(0xd800+(code>>10));
+              value.utf16[units++]=(uint16_t)(0xdc00+(code&1023));}
+    }
+    if(!visible) return 0;
+    memcpy(value.utf8,text,length+1);
+    value.bytes=length;value.units=units;value.scalars=scalars;*out=value;
+    return 1;
+}
+
+int pw_blur_name_select(const PwBlurNameOps *ops,const char *fallback,size_t extent,PwBlurName *out)
+{
+    char text[PW_BLUR_NAME_UTF8_CAP];
+    PwBlurName selected;
+    int32_t user=-1,foreground_rc=-1,username_rc=-1;
+    if(!out) return PW_BLUR_NAME_NEEDS_ENTRY;
+    clear(out);
+    if(ops && ops->foreground && ops->username) {
+        foreground_rc=ops->foreground(&user);
+        if(foreground_rc!=0) user=-1;
+        if(foreground_rc==0 && user>=0) {
+            /* Do not force a terminator: a service that omitted it must fail,
+             * rather than silently accepting a truncated name. */
+            memset(text,0xa5,sizeof(text));
+            username_rc=ops->username(user,text,sizeof(text));
+            if(username_rc==0 && pw_blur_name_validate(text,sizeof(text),&selected)) {
+                selected.source=PW_BLUR_NAME_LOCAL;goto done;
+            }
+        }
+    }
+    if(pw_blur_name_validate(fallback,extent,&selected)) selected.source=PW_BLUR_NAME_FALLBACK;
+    else clear(&selected);
+done:
+    selected.user_id=user;selected.foreground_rc=foreground_rc;selected.username_rc=username_rc;
+    *out=selected;return out->source;
+}
+
+int pw_blur_name_fallback_decode(const void *bytes,size_t size,PwBlurName *out)
+{
+    char line[PW_BLUR_NAME_UTF8_CAP];
+    if(!out) return 0;
+    clear(out);
+    if(!bytes || !size || size>PW_BLUR_NAME_UTF8_CAP) return 0;
+    const char *input=bytes;
+    if(input[size-1]=='\n') --size;
+    if(!size || size>=sizeof(line) || memchr(input,0,size)) return 0;
+    memcpy(line,input,size);line[size]=0;
+    if(!pw_blur_name_validate(line,size+1,out)) return 0;
+    out->source=PW_BLUR_NAME_FALLBACK;
+    return 1;
+}
+
+int pw_blur_name_fallback_encode(const PwBlurName *name,char *out,size_t cap,size_t *size)
+{
+    PwBlurName checked;
+    if(size) *size=0;
+    if(!name || !out || !size || !pw_blur_name_validate(name->utf8,sizeof(name->utf8),&checked) ||
+       cap<checked.bytes+1) return 0;
+    memcpy(out,checked.utf8,checked.bytes);out[checked.bytes]='\n';*size=checked.bytes+1;
+    return 1;
+}
diff -ruN a/prospero/native/native279-username.h b/prospero/native/native279-username.h
--- a/prospero/native/native279-username.h
+++ b/prospero/native/native279-username.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef NATIVE273_USERNAME_H
+#define NATIVE273_USERNAME_H
+#include <stddef.h>
+#include <stdint.h>
+
+enum { PW_BLUR_NAME_UTF8_CAP=65, PW_BLUR_NAME_UTF16_CAP=17, PW_BLUR_NAME_SCALARS=16 };
+enum { PW_BLUR_NAME_NEEDS_ENTRY=0, PW_BLUR_NAME_LOCAL=1, PW_BLUR_NAME_FALLBACK=2 };
+typedef struct PwBlurNameOps {
+    int32_t (*foreground)(int32_t *user);
+    int32_t (*username)(int32_t user, char *out, size_t capacity);
+} PwBlurNameOps;
+typedef struct PwBlurName {
+    char utf8[PW_BLUR_NAME_UTF8_CAP];
+    uint16_t utf16[PW_BLUR_NAME_UTF16_CAP];
+    size_t bytes, units, scalars;
+    int32_t user_id, foreground_rc, username_rc;
+    int source;
+} PwBlurName;
+
+/* Input includes NUL within extent; no truncation/replacement of malformed UTF8.
+ * Returns 1 for a valid nonblank name, 0 otherwise. Clears all output on failure.
+ * This validates the provider encoding, not the game's ANSI/font capabilities.
+ */
+int pw_blur_name_validate(const char *text, size_t extent, PwBlurName *out);
+/* Existing pad/lifecycle owns UserService init/terminate. No service ownership,
+ * account/network operations or prefix/environment changes are performed here.
+ * A persisted editable fallback is considered only if the local name fails.
+ */
+int pw_blur_name_select(const PwBlurNameOps *ops, const char *fallback,
+                        size_t fallback_extent, PwBlurName *out);
+/* Bounded editable UTF8 line codec for a FUTURE launcher-owned per-local-user
+ * file outside the Wine prefix. No disk writes/UI are implemented by this core.
+ */
+int pw_blur_name_fallback_decode(const void *bytes, size_t size, PwBlurName *out);
+int pw_blur_name_fallback_encode(const PwBlurName *name, char *out, size_t capacity, size_t *size);
+int pw_blur_name_from_orbis(const char *fallback, size_t extent, PwBlurName *out);
+#endif
diff -ruN a/prospero/native/native280-username-ui-file.c b/prospero/native/native280-username-ui-file.c
--- a/prospero/native/native280-username-ui-file.c
+++ b/prospero/native/native280-username-ui-file.c
@@ -0,0 +1,120 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "native280-username-ui.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static int error(PwBlurNameFile *f,int value){f->last_error=value?value:EIO;return -1;}
+static int directory(PwBlurNameFile *f,int create)
+{
+    struct stat st;
+    if(lstat(f->directory,&st)) {
+        if(errno!=ENOENT)return error(f,errno);
+        if(!create)return PW_BLUR_NAME_FILE_MISSING;
+        if(mkdir(f->directory,0700) && errno!=EEXIST)return error(f,errno);
+        if(lstat(f->directory,&st))return error(f,errno);
+    }
+    if(!S_ISDIR(st.st_mode))return error(f,ENOTDIR);
+    return PW_BLUR_NAME_FILE_OK;
+}
+/* Distinguish actual ENOENT from access/IO/type errors. Refuse symlinks/FIFOs,
+ * and bound reads to65 bytes. Existing bytes remain untouched on every failure.
+ */
+static int raw(PwBlurNameFile *f,unsigned char bytes[PW_BLUR_NAME_DISK_MAX],size_t *size)
+{
+    struct stat before,after;int fd,flags=O_RDONLY|O_NONBLOCK;size_t got=0;
+    if(lstat(f->path,&before))return errno==ENOENT?PW_BLUR_NAME_FILE_MISSING:error(f,errno);
+    if(!S_ISREG(before.st_mode) || before.st_size<0 || before.st_size>PW_BLUR_NAME_DISK_MAX)return error(f,EINVAL);
+#ifdef O_NOFOLLOW
+    flags|=O_NOFOLLOW;
+#endif
+    fd=open(f->path,flags);
+    if(fd<0)return error(f,errno);
+    if(fstat(fd,&after) || !S_ISREG(after.st_mode) || before.st_dev!=after.st_dev || before.st_ino!=after.st_ino ||
+       after.st_size!=before.st_size){int saved=errno;close(fd);return error(f,saved?saved:EAGAIN);}
+    while(got<(size_t)before.st_size) {
+        ssize_t n=read(fd,bytes+got,(size_t)before.st_size-got);
+        if(n<0 && errno==EINTR)continue;
+        if(n<=0){int saved=errno;close(fd);return error(f,saved?saved:EIO);}
+        got+=(size_t)n;
+    }
+    unsigned char extra;ssize_t n;
+    do n=read(fd,&extra,1);while(n<0 && errno==EINTR);
+    int rc=close(fd);
+    if(n!=0 || rc)return error(f,errno?errno:EAGAIN);
+    *size=got;return PW_BLUR_NAME_FILE_OK;
+}
+int pw_blur_name_file_init(PwBlurNameFile *f,const char *root,int32_t user)
+{
+    if(!f || !root || root[0]!='/' || user<0)return -1;
+    size_t length=strnlen(root,PW_BLUR_NAME_PATH);
+    if(!length || length>=PW_BLUR_NAME_PATH)return -1;
+    while(length>1 && root[length-1]=='/')--length;
+    memset(f,0,sizeof(*f));f->user=user;
+    int rc=snprintf(f->directory,sizeof(f->directory),"%.*s/player-names",(int)length,root);
+    if(rc<0 || (size_t)rc>=sizeof(f->directory))return -1;
+    rc=snprintf(f->path,sizeof(f->path),"%s/%08x.txt",f->directory,(unsigned)user);
+    return rc>=0 && (size_t)rc<sizeof(f->path)?0:-1;
+}
+int pw_blur_name_file_load(void *context,int32_t user,char *text,size_t capacity)
+{
+    PwBlurNameFile *f=context;PwBlurName parsed;size_t size=0;
+    if(!f || user!=f->user || !text || !capacity)return -1;
+    text[0]=0;f->loaded=0;
+    int rc=directory(f,0);
+    if(rc<0)return rc;
+    if(rc==PW_BLUR_NAME_FILE_MISSING){f->loaded=1;f->before_exists=0;f->before_size=0;return rc;}
+    rc=raw(f,f->before,&size);
+    if(rc<0)return rc;
+    f->loaded=1;f->before_exists=rc==PW_BLUR_NAME_FILE_OK;f->before_size=size;
+    if(rc==PW_BLUR_NAME_FILE_MISSING)return rc;
+    if(!pw_blur_name_fallback_decode(f->before,size,&parsed) || !pw_blur_name_portable(&parsed))return PW_BLUR_NAME_FILE_INVALID;
+    if(parsed.bytes+1>capacity)return error(f,ENOBUFS);
+    memcpy(text,parsed.utf8,parsed.bytes+1);return PW_BLUR_NAME_FILE_OK;
+}
+int pw_blur_name_file_save(void *context,int32_t user,const char *text)
+{
+    PwBlurNameFile *f=context;PwBlurName parsed;char temp[PW_BLUR_NAME_PATH+48],next[PW_BLUR_NAME_UTF8_CAP];
+    unsigned char current[PW_BLUR_NAME_DISK_MAX];size_t size=0,length=0;int fd=-1,created=0;
+    if(!f || !f->loaded || user!=f->user || !pw_blur_name_validate(text,PW_BLUR_NAME_UTF8_CAP,&parsed) ||
+       !pw_blur_name_portable(&parsed) || !pw_blur_name_fallback_encode(&parsed,next,sizeof(next),&length))return -1;
+    if(directory(f,1))return -1;
+    for(unsigned attempt=0;attempt<5;++attempt) {
+        int count=snprintf(temp,sizeof(temp),"%s.tmp-%lu-%u",f->path,(unsigned long)getpid(),++f->serial);
+        if(count<0 || (size_t)count>=sizeof(temp))return error(f,ENAMETOOLONG);
+        fd=open(temp,O_WRONLY|O_CREAT|O_EXCL,0600);
+        if(fd>=0){created=1;break;}
+        if(errno!=EEXIST)return error(f,errno);
+    }
+    if(!created)return error(f,EEXIST);
+    while(size<length) {
+        ssize_t n=write(fd,next+size,length-size);
+        if(n<0 && errno==EINTR)continue;
+        if(n<=0)goto failed;
+        size+=(size_t)n;
+    }
+    if(fsync(fd))goto failed;
+    if(close(fd)){fd=-1;goto failed;}fd=-1;
+    size=0;int rc=raw(f,current,&size);
+    if(rc<0 || (f->before_exists?(rc!=PW_BLUR_NAME_FILE_OK || size!=f->before_size || memcmp(current,f->before,size)):
+                                            rc!=PW_BLUR_NAME_FILE_MISSING)) {
+        errno=EAGAIN;goto failed;
+    }
+    if(rename(temp,f->path))goto failed;
+    created=0; /* Never unlink/restore a published or intervening destination. */
+    int flags=O_RDONLY;
+#ifdef O_DIRECTORY
+    flags|=O_DIRECTORY;
+#endif
+    fd=open(f->directory,flags);
+    if(fd<0 || fsync(fd))goto failed;
+    if(close(fd)){fd=-1;goto failed;}fd=-1;
+    size=0;rc=raw(f,current,&size);
+    if(rc!=PW_BLUR_NAME_FILE_OK || size!=length || memcmp(current,next,length)){errno=EIO;goto failed;}
+    memcpy(f->before,next,length);f->before_size=length;f->before_exists=1;f->last_error=0;return 0;
+failed:
+    {int saved=errno?errno:EIO;if(fd>=0)close(fd);if(created)unlink(temp);return error(f,saved);}
+}
diff -ruN a/prospero/native/native280-username-ui.c b/prospero/native/native280-username-ui.c
--- a/prospero/native/native280-username-ui.c
+++ b/prospero/native/native280-username-ui.c
@@ -0,0 +1,122 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "native280-username-ui.h"
+#include <string.h>
+
+static const uint16_t title[]={ 'P','l','a','y','e','r',' ','n','a','m','e',0 };
+static const uint16_t hint[]={ '1','-','1','6',' ','l','e','t','t','e','r','s',',',' ','n','u','m','b','e','r','s',',',' ','.',' ','_',' ','-',0 };
+
+int pw_blur_name_portable(const PwBlurName *name)
+{
+    if(!name || !name->bytes || name->bytes>16 || name->utf8[0]=='.' || name->utf8[name->bytes-1]=='.')return 0;
+    for(size_t i=0;i<name->bytes;++i) {
+        unsigned char c=(unsigned char)name->utf8[i];
+        if(!((c>='a' && c<='z') || (c>='A' && c<='Z') || (c>='0' && c<='9') || c=='_' || c=='-' || c=='.'))return 0;
+    }
+    return name->utf8[name->bytes]==0;
+}
+static int valid(PwBlurNameSetup *s,const char *text,size_t capacity,PwBlurName *out)
+{
+    return pw_blur_name_validate(text,capacity,out) &&
+        (s->ops.compatible?s->ops.compatible(out):pw_blur_name_portable(out));
+}
+static int finish_dialog(PwBlurNameSetup *s)
+{
+    int rc=0;
+    if(s->owns_dialog) {
+        s->owns_dialog=0;s->osk->showing=0;
+        rc=s->osk->dialog_term();
+    }
+    return rc;
+}
+static int failed(PwBlurNameSetup *s,int error,const char *message)
+{
+    (void)finish_dialog(s);s->state=PW_BLUR_SETUP_ERROR;s->error=error;s->message=message;return s->state;
+}
+static int dialog(PwBlurNameSetup *s,const PwBlurName *prefill)
+{
+    PwOskPs5 *osk=s->osk;
+    if(!osk || !osk->ready || osk->showing || osk->user_id!=s->user || !osk->dialog_init ||
+       !osk->dialog_status || !osk->dialog_result || !osk->dialog_term)
+        return failed(s,-10,"Player name setup is unavailable.");
+    if(!osk->common_tried) {
+        osk->common_tried=1;
+        osk->common_dialog_rc=osk->ops.common_dialog_init?osk->ops.common_dialog_init():-1;
+    }
+    memset(s->text,0,sizeof(s->text));memset(&s->param,0,sizeof(s->param));
+    if(prefill && pw_blur_name_portable(prefill))memcpy(s->text,prefill->utf16,(prefill->units+1)*sizeof(uint16_t));
+    s->param.user_id=s->user;s->param.type=1; /* actual Orbis BASIC_LATIN */
+    s->param.max_text_length=16;s->param.input_text_buffer=s->text;
+    s->param.horizontal_alignment=s->param.vertical_alignment=1;
+    s->param.title=title;s->param.placeholder=hint;
+    int rc=osk->dialog_init(&s->param,NULL);
+    if(rc)return failed(s,rc,"Player name setup could not open.");
+    s->owns_dialog=1;osk->showing=1;s->polls=0;++s->attempts;
+    s->state=PW_BLUR_SETUP_WAIT;return s->state;
+}
+
+int pw_blur_name_setup_begin(PwBlurNameSetup *s,const PwBlurName *local,PwOskPs5 *osk,
+                             const PwBlurNameSetupOps *ops,int force_edit)
+{
+    PwBlurName check,cached;char saved[PW_BLUR_NAME_UTF8_CAP];
+    if(!s || !local || !ops)return PW_BLUR_SETUP_ERROR;
+    memset(s,0,sizeof(*s));s->ops=*ops;s->osk=osk;s->user=local->user_id;
+    s->message="Choose your player name.";
+    if(s->user<0 || local->foreground_rc!=0)return failed(s,-2,"No local user is available for player name setup.");
+    if(!force_edit && local->source==PW_BLUR_NAME_LOCAL && valid(s,local->utf8,sizeof(local->utf8),&check)) {
+        s->selected=*local;s->source=PW_BLUR_SETUP_LOCAL;s->state=PW_BLUR_SETUP_READY;return s->state;
+    }
+    if(!ops->load || !ops->save)return failed(s,-3,"Player name settings are unavailable.");
+    memset(saved,0,sizeof(saved));
+    int rc=ops->load(ops->context,s->user,saved,sizeof(saved));
+    if(rc<0)return failed(s,rc,"Player name settings could not be read.");
+    if(rc==PW_BLUR_NAME_FILE_OK && valid(s,saved,sizeof(saved),&cached)) {
+        if(!force_edit) {
+            s->selected=cached;s->selected.user_id=s->user;s->selected.source=PW_BLUR_NAME_FALLBACK;
+            s->source=PW_BLUR_SETUP_SAVED;s->state=PW_BLUR_SETUP_READY;return s->state;
+        }
+        return dialog(s,&cached);
+    }
+    if(rc!=PW_BLUR_NAME_FILE_OK && rc!=PW_BLUR_NAME_FILE_MISSING && rc!=PW_BLUR_NAME_FILE_INVALID)
+        return failed(s,-4,"Player name settings have an unknown state.");
+    return dialog(s,NULL);
+}
+
+int pw_blur_name_setup_poll(PwBlurNameSetup *s)
+{
+    if(!s)return PW_BLUR_SETUP_ERROR;
+    if(s->state!=PW_BLUR_SETUP_WAIT)return s->state;
+    int status=s->osk->dialog_status();++s->polls;
+    if(status==PW_OSK_PS5_RUNNING)return s->state;
+    if(status==PW_OSK_PS5_NONE && s->polls<PW_OSK_PS5_GRACE_POLLS)return s->state;
+    if(status!=PW_OSK_PS5_FINISHED)return failed(s,-11,"Player name setup stopped unexpectedly.");
+    PwOskPs5Result result;memset(&result,0,sizeof(result));
+    int rc=s->osk->dialog_result(&result),term=finish_dialog(s);
+    if(rc || term)return failed(s,rc?rc:term,"Player name setup could not finish.");
+    if(result.outcome==PW_OSK_PS5_CANCELLED || result.outcome==PW_OSK_PS5_ABORTED) {
+        s->state=PW_BLUR_SETUP_CANCELLED;s->message="Player name setup was cancelled.";return s->state;
+    }
+    if(result.outcome!=PW_OSK_PS5_OK)return failed(s,-12,"Player name setup returned an unknown result.");
+    char text[17];size_t length=0;
+    while(length<17 && s->text[length]) {
+        if(s->text[length]>127)break;
+        text[length]=(char)s->text[length];++length;
+    }
+    PwBlurName accepted;
+    if(length>=17 || s->text[length] || !length)goto invalid;
+    text[length]=0;
+    if(!valid(s,text,length+1,&accepted))goto invalid;
+    if(s->ops.save(s->ops.context,s->user,accepted.utf8))
+        return failed(s,-13,"Player name could not be saved.");
+    accepted.user_id=s->user;accepted.source=PW_BLUR_NAME_FALLBACK;s->selected=accepted;
+    s->source=PW_BLUR_SETUP_ENTERED;s->state=PW_BLUR_SETUP_READY;s->message="Player name saved.";return s->state;
+invalid:
+    s->message="Use 1-16 letters, numbers, dot, underscore or hyphen.";
+    if(s->attempts>=3)return failed(s,-14,"Player name setup needs a valid name. Restart to try again.");
+    return dialog(s,NULL);
+}
+void pw_blur_name_setup_close(PwBlurNameSetup *s)
+{
+    if(!s)return;
+    (void)finish_dialog(s);
+    if(s->state==PW_BLUR_SETUP_WAIT){s->state=PW_BLUR_SETUP_CANCELLED;s->message="Player name setup was cancelled.";}
+}
