+/* Read a bounded DOS and PE32 header from an open regular file. The fixed
+ * offset ceiling avoids unbounded seeks on damaged files. No game bytes are
+ * modified and no full-file hashing occurs during startup. */
+static int direct_read_exact(int fd, uint8_t *dst, size_t size)
+{
+    while (size) {
+        ssize_t got = read(fd, dst, size);
+        if (got < 0 && errno == EINTR) continue;
+        if (got <= 0) return 0;
+        dst += (size_t)got;
+        size -= (size_t)got;
+    }
+    return 1;
+}
+static int direct_game_file_ok(const char *path)
+{
+    enum { DOS_SIZE = 64, PE_SIZE = 26, MAX_PE_OFFSET = 1024 * 1024 };
+    uint8_t dos[DOS_SIZE], pe[PE_SIZE];
+    struct stat st;
+    uint32_t off;
+    int ok = 0, fd;
+    if (stat(path, &st) != 0 || !S_ISREG(st.st_mode)) return 0;
+    fd = open(path, O_RDONLY | O_NONBLOCK);
+    if (fd < 0) return 0;
+    if (fstat(fd, &st) != 0 || !S_ISREG(st.st_mode) || st.st_size < DOS_SIZE + PE_SIZE ||
+        !direct_read_exact(fd, dos, sizeof(dos)) || dos[0] != 'M' || dos[1] != 'Z') goto done;
+    off = (uint32_t)dos[60] | (uint32_t)dos[61] << 8 |
+          (uint32_t)dos[62] << 16 | (uint32_t)dos[63] << 24;
+    if (off < DOS_SIZE || off > MAX_PE_OFFSET || (uint64_t)off + PE_SIZE > (uint64_t)st.st_size ||
+        lseek(fd, (off_t)off, SEEK_SET) != (off_t)off || !direct_read_exact(fd, pe, sizeof(pe))) goto done;
+    /* PE signature, i386 machine, PE32 optional-header magic. */
+    ok = pe[0] == 'P' && pe[1] == 'E' && pe[2] == 0 && pe[3] == 0 &&
+         pe[4] == 0x4c && pe[5] == 0x01 && ((uint32_t)pe[20] | (uint32_t)pe[21] << 8) >= 2 && pe[24] == 0x0b && pe[25] == 0x01 &&
+         (uint64_t)off + 24u + ((uint32_t)pe[20] | (uint32_t)pe[21] << 8) <= (uint64_t)st.st_size;
+done:
+    close(fd);
+    return ok;
+}
+/* N276_FILECHECK_END */
