+
+/* ------------------------------------------------------------------ helpers */
+static int n245_is_hex64(const char *s)
+{
+    size_t i;
+    for (i = 0; i < 64; i++)
+        if (!((s[i] >= '0' && s[i] <= '9') || (s[i] >= 'a' && s[i] <= 'f'))) return 0;
+    return s[64] == 0;
+}
+
+static int n245_join(char *out, size_t size, const char *a, const char *b)
+{
+    int n = snprintf(out, size, "%s/%s", a, b);
+    return n >= 0 && (size_t)n < size;
+}
+
+static int n245_join3(char *out, size_t size, const char *a, const char *b, const char *c)
+{
+    int n = snprintf(out, size, "%s/%s/%s", a, b, c);
+    return n >= 0 && (size_t)n < size;
+}
+
+static int n245_ends_with(const char *s, const char *suffix)
+{
+    size_t a = strlen(s), b = strlen(suffix);
+    return a >= b && !memcmp(s + a - b, suffix, b);
+}
+
+/* Whole file up to limit bytes into a malloc'd, NUL-terminated buffer.
+ * 0 ok, -1 absent (ENOENT), -2 other read error, -3 larger than limit. */
+static int n245_read_all(const char *path, size_t limit, char **data, size_t *size)
+{
+    int fd = open(path, O_RDONLY);
+    size_t used = 0, cap = 4096;
+    char *buf;
+    if (fd < 0) return errno == ENOENT || errno == ENOTDIR ? -1 : -2;
+    buf = (char *)malloc(cap + 1);
+    if (!buf) { close(fd); return -2; }
+    for (;;) {
+        ssize_t got;
+        if (used == cap) {
+            char *bigger;
+            if (cap > limit) { free(buf); close(fd); return -3; }
+            cap *= 2;
+            bigger = (char *)realloc(buf, cap + 1);
+            if (!bigger) { free(buf); close(fd); return -2; }
+            buf = bigger;
+        }
+        got = read(fd, buf + used, cap - used);
+        if (got < 0) { if (errno == EINTR) continue; free(buf); close(fd); return -2; }
+        if (!got) break;
+        used += (size_t)got;
+        if (used > limit) { free(buf); close(fd); return -3; }
+    }
+    close(fd);
+    buf[used] = 0;
+    *data = buf;
+    *size = used;
+    return 0;
+}
+
+/* SHA-256 + size of a file. 0 ok, -1 absent, -2 error. */
+static int n245_hash_file(const char *path, char hex[65], unsigned long long *size)
+{
+    static unsigned char buf[64 * 1024];
+    N245Sha256 s;
+    int fd = open(path, O_RDONLY);
+    if (fd < 0) return errno == ENOENT || errno == ENOTDIR ? -1 : -2;
+    n245_sha256_init(&s);
+    *size = 0;
+    for (;;) {
+        ssize_t got = read(fd, buf, sizeof(buf));
+        if (got < 0) { if (errno == EINTR) continue; close(fd); return -2; }
+        if (!got) break;
+        n245_sha256_update(&s, buf, (size_t)got);
+        *size += (unsigned long long)got;
+    }
+    close(fd);
+    n245_sha256_hex(&s, hex);
+    return 0;
+}
+
+static int n245_exists(const char *path, int *is_dir)
+{
+    struct stat st;
+    if (stat(path, &st) != 0) return 0;
+    if (is_dir) *is_dir = S_ISDIR(st.st_mode) ? 1 : 0;
+    return 1;
+}
+
+static void n245_sync_dir(const char *path)
+{
+    int fd = open(path, O_RDONLY | O_DIRECTORY);
+    if (fd >= 0) { (void)N245_FSYNC(fd); close(fd); }   /* best effort: not every FS allows it */
+}
+
+static int n245_mkdir_one(const char *path)
+{
+    int is_dir = 0;
+    if (n245_exists(path, &is_dir)) return is_dir ? 0 : -1;
+    if (N245_FAULT("mkdir", path)) return -1;
+    if (mkdir(path, 0777) != 0 && errno != EEXIST) return -1;
+    return n245_exists(path, &is_dir) && is_dir ? 0 : -1;
+}
+
+/* mkdir -p for an absolute path. */
+static int n245_mkdir_p(const char *path)
+{
+    char tmp[N245_PATH_MAX];
+    size_t i, n = strlen(path);
+    if (n == 0 || n >= sizeof(tmp)) return -1;
+    memcpy(tmp, path, n + 1);
+    for (i = 1; i < n; i++) {
+        if (tmp[i] != '/') continue;
+        tmp[i] = 0;
+        if (n245_mkdir_one(tmp)) return -1;
+        tmp[i] = '/';
+    }
+    return n245_mkdir_one(tmp);
+}
+
+static int n245_mkdir_parent(const char *path)
+{
+    char tmp[N245_PATH_MAX];
+    const char *slash = strrchr(path, '/');
+    size_t n;
+    if (!slash) return -1;
+    n = (size_t)(slash - path);
+    if (n == 0) return 0;
+    if (n >= sizeof(tmp)) return -1;
+    memcpy(tmp, path, n);
+    tmp[n] = 0;
+    return n245_mkdir_p(tmp);
+}
+
+static int n245_write_all(int fd, const char *path, const void *data, size_t size)
+{
+    const char *p = (const char *)data;
+    (void)path;   /* only the fixture fault hook reads it */
+    while (size) {
+        ssize_t put;
+        if (N245_FAULT("write", path)) return -1;
+        put = write(fd, p, size);
+        if (put < 0) { if (errno == EINTR) continue; return -1; }
+        p += put;
+        size -= (size_t)put;
+    }
+    return 0;
+}
+
+/* Write bytes to <final>.n245part, fsync, read back by hash, rename to final. */
+static int n245_publish_bytes(const char *final_path, const void *data, size_t size)
+{
+    char part[N245_PATH_MAX + 16], want[65], got[65];
+    unsigned long long got_size = 0;
+    int fd;
+    if (snprintf(part, sizeof(part), "%s%s", final_path, N245_PART_SUFFIX) >= (int)sizeof(part)) return -1;
+    if (N245_FAULT("create", part)) return -1;
+    fd = open(part, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    if (fd < 0) return -1;
+    if (n245_write_all(fd, part, data, size) || N245_FSYNC(fd) != 0) { close(fd); return -1; }
+    if (close(fd) != 0) return -1;
+    n245_sha256_of(data, size, want);
+    if (n245_hash_file(part, got, &got_size) || got_size != size || strcmp(want, got)) return -1;
+    if (N245_FAULT("rename", final_path)) return -1;
+    return rename(part, final_path) == 0 ? 0 : -1;
+}
+
+/* ------------------------------------------------------------------ index */
+typedef struct N245File {
+    unsigned long long size;
+    const char *sha;   /* 64 hex */
+    const char *rel;   /* prefix-relative */
+    const char *src;   /* "-" = objects/<sha>; otherwise app-relative runtime path */
+} N245File;
+
+typedef struct N245Index {
+    char *text;
+    const char *end_hash;
+    const char *manifest_end;
+    unsigned long long profile_size;
+    const char *profile_sha;
+    const char **dirs;
+    unsigned dir_count;
+    N245File *files;
+    unsigned file_count;
+} N245Index;
+
+static void n245_index_free(N245Index *ix)
+{
+    free(ix->text);
+    free((void *)ix->dirs);
+    free(ix->files);
+    memset(ix, 0, sizeof(*ix));
+}
+
+static int n245_parse_u64(const char *s, unsigned long long *v)
+{
+    unsigned long long x = 0;
+    size_t n = 0;
+    if (!*s) return -1;
+    for (; *s; s++, n++) {
+        if (*s < '0' || *s > '9' || n >= 19) return -1;
+        x = x * 10u + (unsigned long long)(*s - '0');
+    }
+    *v = x;
+    return 0;
+}
+
+/* A prefix-relative path: no absolute, empty, "." or ".." component, no
+ * control byte or backslash, and none of the importer's reserved names. */
+static int n245_valid_rel(const char *rel)
+{
+    const char *p = rel, *comp = rel;
+    size_t n = strlen(rel);
+    if (n == 0 || n > 512 || rel[0] == '/') return 0;
+    for (;; p++) {
+        if (*p == '/' || *p == 0) {
+            size_t len = (size_t)(p - comp);
+            if (len == 0 || (len == 1 && comp[0] == '.') || (len == 2 && comp[0] == '.' && comp[1] == '.'))
+                return 0;
+            if (*p == 0) break;
+            comp = p + 1;
+            continue;
+        }
+        if ((unsigned char)*p < 0x20 || *p == 0x7f || *p == '\\') return 0;
+    }
+    if (n245_ends_with(rel, N245_PART_SUFFIX)) return 0;
+    if (!strcmp(rel, N245_OWNER_FILE) || !strcmp(rel, N245_MARKER_FILE)) return 0;
+    return 1;
+}
+
+/* Runtime sources are confined to the package's two Wine PE directories. */
+static int n245_valid_runtime_src(const char *src)
+{
+    static const char *const allowed[] = {"win/wine/lib/wine/i386-windows/", "win/wine/lib/wine/x86_64-windows/"};
+    size_t i;
+    for (i = 0; i < 2; i++) {
+        size_t n = strlen(allowed[i]);
+        if (!strncmp(src, allowed[i], n)) {
+            const char *name = src + n;
+            if (!*name || strchr(name, '/') || !n245_valid_rel(name)) return 0;
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static int n245_split_tabs(char *line, char **fields, int max)
+{
+    int n = 0;
+    fields[n++] = line;
+    for (; *line; line++)
+        if (*line == '\t') {
+            if (n == max) return -1;
+            *line = 0;
+            fields[n++] = line + 1;
+        }
+    return n;
+}
+
+static N245Status n245_index_load(const char *path, const char *pinned, N245Index *ix, char *detail, size_t dsize)
+{
+    char *text = NULL, *body_end, *line, *next, digest[65];
+    size_t size = 0;
+    unsigned dir_cap = 0, file_cap = 0, lineno = 0;
+    int have_header = 0, have_slug = 0, have_manifest = 0, have_profile = 0, rc;
+
+    memset(ix, 0, sizeof(*ix));
+    rc = n245_read_all(path, N245_INDEX_LIMIT, &text, &size);
+    if (rc) { snprintf(detail, dsize, "index unreadable rc=%d", rc); return N245_ERR_SEED; }
+    ix->text = text;
+    if (memchr(text, 0, size)) { snprintf(detail, dsize, "index has NUL"); return N245_ERR_SEED; }
+    /* END line: the last line, "END <hex>\n", hashing every byte before it. */
+    if (size < 69 || text[size - 1] != '\n') { snprintf(detail, dsize, "index has no END line"); return N245_ERR_SEED; }
+    body_end = text + size - 69;   /* "END " + 64 hex + "\n" */
+    if (strncmp(body_end, "END ", 4) || (body_end != text && body_end[-1] != '\n')) {
+        snprintf(detail, dsize, "index has no END line");
+        return N245_ERR_SEED;
+    }
+    body_end[68] = 0;
+    if (!n245_is_hex64(body_end + 4)) { snprintf(detail, dsize, "index END malformed"); return N245_ERR_SEED; }
+    n245_sha256_of(text, (size_t)(body_end - text), digest);
+    if (strcmp(digest, body_end + 4)) { snprintf(detail, dsize, "index END mismatch body=%.16s", digest); return N245_ERR_SEED; }
+    if (strcmp(digest, pinned)) {
+        snprintf(detail, dsize, "index END %.16s is not the pinned %.16s", digest, pinned);
+        return N245_ERR_SEED;
+    }
+    ix->end_hash = body_end + 4;
+    *body_end = 0;
+
+    for (line = text; *line; line = next) {
+        char *fields[6];
+        int nf;
+        next = strchr(line, '\n');
+        if (!next) { snprintf(detail, dsize, "index line %u unterminated", lineno + 1); return N245_ERR_SEED; }
+        *next++ = 0;
+        lineno++;
+        if (!have_header) {
+            if (strcmp(line, N245_INDEX_HEADER)) { snprintf(detail, dsize, "index header"); return N245_ERR_SEED; }
+            have_header = 1;
+            continue;
+        }
+        if (!strncmp(line, "slug ", 5)) {
+            if (have_slug || strcmp(line + 5, N245_SLUG)) { snprintf(detail, dsize, "index slug"); return N245_ERR_SEED; }
+            have_slug = 1;
+            continue;
+        }
+        if (!strncmp(line, "manifest_end ", 13)) {
+            if (have_manifest || !n245_is_hex64(line + 13)) { snprintf(detail, dsize, "index manifest_end"); return N245_ERR_SEED; }
+            ix->manifest_end = line + 13;
+            have_manifest = 1;
+            continue;
+        }
+        nf = n245_split_tabs(line, fields, 6);
+        if (nf == 3 && !strcmp(fields[0], "P") && !have_profile && n245_is_hex64(fields[2]) &&
+            !n245_parse_u64(fields[1], &ix->profile_size) && ix->profile_size > 0 &&
+            ix->profile_size < N245_PROFILE_LIMIT) {
+            ix->profile_sha = fields[2];
+            have_profile = 1;
+        } else if (nf == 2 && !strcmp(fields[0], "D") && n245_valid_rel(fields[1])) {
+            if (ix->dir_count == dir_cap) {
+                const char **grown;
+                if (dir_cap >= N245_MAX_ENTRIES) { snprintf(detail, dsize, "index too many dirs"); return N245_ERR_SEED; }
+                dir_cap = dir_cap ? dir_cap * 2 : 256;
+                grown = (const char **)realloc((void *)ix->dirs, dir_cap * sizeof(*grown));
+                if (!grown) { snprintf(detail, dsize, "out of memory"); return N245_ERR_SEED; }
+                ix->dirs = grown;
+            }
+            ix->dirs[ix->dir_count++] = fields[1];
+        } else if (nf == 5 && !strcmp(fields[0], "F") && n245_is_hex64(fields[2]) && n245_valid_rel(fields[3]) &&
+                   (!strcmp(fields[4], "-") || n245_valid_runtime_src(fields[4]))) {
+            N245File *f;
+            unsigned i;
+            if (ix->file_count == file_cap) {
+                N245File *grown;
+                if (file_cap >= N245_MAX_ENTRIES) { snprintf(detail, dsize, "index too many files"); return N245_ERR_SEED; }
+                file_cap = file_cap ? file_cap * 2 : 512;
+                grown = (N245File *)realloc(ix->files, file_cap * sizeof(*grown));
+                if (!grown) { snprintf(detail, dsize, "out of memory"); return N245_ERR_SEED; }
+                ix->files = grown;
+            }
+            for (i = 0; i < ix->file_count; i++)
+                if (!strcmp(ix->files[i].rel, fields[3])) {
+                    snprintf(detail, dsize, "index duplicate file line %u", lineno);
+                    return N245_ERR_SEED;
+                }
+            f = &ix->files[ix->file_count++];
+            if (n245_parse_u64(fields[1], &f->size)) { snprintf(detail, dsize, "index size line %u", lineno); return N245_ERR_SEED; }
+            f->sha = fields[2];
+            f->rel = fields[3];
+            f->src = fields[4];
+        } else {
+            snprintf(detail, dsize, "index line %u malformed", lineno);
+            return N245_ERR_SEED;
+        }
+    }
+    if (!have_header || !have_slug || !have_manifest || !have_profile || ix->file_count == 0) {
+        snprintf(detail, dsize, "index incomplete");
+        return N245_ERR_SEED;
+    }
+    return N245_IMPORTED;   /* "ok" */
+}
+
+/* ------------------------------------------------------------------ profiles */
+static void n245_trim(char **s, char **e)
+{
+    while (*s < *e && (**s == ' ' || **s == '\t' || **s == '\r')) (*s)++;
+    while (*e > *s && ((*e)[-1] == ' ' || (*e)[-1] == '\t' || (*e)[-1] == '\r')) (*e)--;
+}
+
+/* Does an INI profile's [application] section declare id or prefix == slug? */
+static int n245_profile_claims_slug(const char *text, size_t size)
+{
+    const char *p = text, *end = text + size;
+    int in_app = 0;
+    while (p < end) {
+        const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+        char *s = (char *)p, *e = (char *)(nl ? nl : end);
+        p = nl ? nl + 1 : end;
+        n245_trim(&s, &e);
+        if (s == e || *s == '#' || *s == ';') continue;
+        if (*s == '[') {
+            in_app = (size_t)(e - s) == 13 && !memcmp(s, "[application]", 13);
+            continue;
+        }
+        if (in_app) {
+            char *eq = (char *)memchr(s, '=', (size_t)(e - s));
+            char *ks = s, *ke, *vs, *ve = e;
+            if (!eq) continue;
+            ke = eq;
+            vs = eq + 1;
+            n245_trim(&ks, &ke);
+            n245_trim(&vs, &ve);
+            if ((((size_t)(ke - ks) == 2 && !memcmp(ks, "id", 2)) ||
+                 ((size_t)(ke - ks) == 6 && !memcmp(ks, "prefix", 6))) &&
+                (size_t)(ve - vs) == strlen(N245_SLUG) && !memcmp(vs, N245_SLUG, strlen(N245_SLUG)))
+                return 1;
+        }
+    }
+    return 0;
+}
+
+static int n245_profile_file_name(const char *name, size_t len)
+{
+    size_t i;
+    if (len <= 8 || len >= 64 || memcmp(name + len - 8, ".profile", 8)) return 0;
+    for (i = 0; i < len - 8; i++) {
+        char c = name[i];
+        if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_')) return 0;
+    }
+    return 1;
+}
+
+/* profiles.lst limited to the grammar this importer can safely extend: lines
+ * of "<name>.profile", '\n' terminated, at most 31 entries (room for ours).
+ * Returns 1 pure, 0 not pure; *listed set when our name is already there. */
+static int n245_catalog_pure(const char *text, size_t size, int *listed, unsigned *count)
+{
+    const char *p = text, *end = text + size;
+    *listed = 0;
+    *count = 0;
+    if (size && text[size - 1] != '\n') return 0;
+    while (p < end) {
+        const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+        size_t len = (size_t)(nl - p);
+        if (!n245_profile_file_name(p, len)) return 0;
+        if (len == strlen(N245_SLUG ".profile") && !memcmp(p, N245_SLUG ".profile", len)) *listed = 1;
+        if (++*count > 31) return 0;
+        p = nl + 1;
+    }
+    return 1;
+}
+
+/* Refuse when any other profile the launcher would read claims our id/prefix. */
+static N245Status n245_conflicts(const char *profiles_dir, const char *catalog, size_t catalog_size,
+                                 int have_catalog, char *detail, size_t dsize)
+{
+    char path[N245_PATH_MAX];
+    if (have_catalog) {
+        const char *p = catalog, *end = catalog + catalog_size;
+        while (p < end) {
+            const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+            char name[64];
+            size_t len = (size_t)(nl - p);
+            char *text = NULL;
+            size_t size = 0;
+            memcpy(name, p, len);
+            name[len] = 0;
+            p = nl + 1;
+            if (!strcmp(name, N245_SLUG ".profile")) continue;
+            if (!n245_join(path, sizeof(path), profiles_dir, name)) return N245_ERR_ARGS;
+            if (n245_read_all(path, N245_PROFILE_LIMIT, &text, &size) == 0) {
+                int claims = n245_profile_claims_slug(text, size);
+                free(text);
+                if (claims) { snprintf(detail, dsize, "profile %s claims %s", name, N245_SLUG); return N245_REFUSED_CONFLICT; }
+            }
+        }
+        return N245_IMPORTED;
+    }
+    {
+        DIR *dir = opendir(profiles_dir);
+        struct dirent *ent;
+        N245Status st = N245_IMPORTED;
+        if (!dir) return N245_IMPORTED;   /* no profiles directory: nothing can conflict */
+        while ((ent = readdir(dir)) != NULL) {
+            char *text = NULL;
+            size_t size = 0, len = strlen(ent->d_name);
+            if (!n245_profile_file_name(ent->d_name, len) || !strcmp(ent->d_name, N245_SLUG ".profile")) continue;
+            if (!n245_join(path, sizeof(path), profiles_dir, ent->d_name)) { st = N245_ERR_ARGS; break; }
+            if (n245_read_all(path, N245_PROFILE_LIMIT, &text, &size) == 0) {
+                int claims = n245_profile_claims_slug(text, size);
+                free(text);
+                if (claims) {
+                    snprintf(detail, dsize, "profile %s claims %s", ent->d_name, N245_SLUG);
+                    st = N245_REFUSED_CONFLICT;
+                    break;
+                }
+            }
+        }
+        closedir(dir);
+        return st;
+    }
+}
+
+/* ------------------------------------------------------------------ copy */
+/* Copy src to <dst>.n245part while hashing the source, fsync, hash the written
+ * part back, then rename it to dst. ERR_SEED when the source is not the pinned
+ * bytes, ERR_IO on any /data failure. */
+static N245Status n245_copy_verified(const char *src, const char *dst, unsigned long long size, const char *sha,
+                                     unsigned long long *bytes, char *detail, size_t dsize)
+{
+    static unsigned char buf[64 * 1024];
+    char part[N245_PATH_MAX + 16], hex[65];
+    unsigned long long total = 0, back = 0;
+    N245Sha256 s;
+    int in, out;
+
+    if (snprintf(part, sizeof(part), "%s%s", dst, N245_PART_SUFFIX) >= (int)sizeof(part)) return N245_ERR_ARGS;
+    in = open(src, O_RDONLY);
+    if (in < 0) { snprintf(detail, dsize, "seed source missing %.200s", src); return N245_ERR_SEED; }
+    if (N245_FAULT("create", part)) { close(in); snprintf(detail, dsize, "create %.200s", part); return N245_ERR_IO; }
+    out = open(part, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    if (out < 0) { close(in); snprintf(detail, dsize, "create %.200s errno=%d", part, errno); return N245_ERR_IO; }
+    n245_sha256_init(&s);
+    for (;;) {
+        ssize_t got = read(in, buf, sizeof(buf));
+        if (got < 0) {
+            if (errno == EINTR) continue;
+            close(in); close(out);
+            snprintf(detail, dsize, "read %.200s errno=%d", src, errno);
+            return N245_ERR_SEED;
+        }
+        if (!got) break;
+        total += (unsigned long long)got;
+        if (total > size) break;
+        n245_sha256_update(&s, buf, (size_t)got);
+        if (n245_write_all(out, part, buf, (size_t)got)) {
+            close(in); close(out);
+            snprintf(detail, dsize, "write %.200s errno=%d", part, errno);
+            return N245_ERR_IO;
+        }
+    }
+    close(in);
+    n245_sha256_hex(&s, hex);
+    if (total != size || strcmp(hex, sha)) {
+        close(out);
+        (void)unlink(part);
+        snprintf(detail, dsize, "seed source %.200s is not pinned (size %llu/%llu)", src, total, size);
+        return N245_ERR_SEED;
+    }
+    if (N245_FSYNC(out) != 0) { close(out); snprintf(detail, dsize, "fsync %.200s errno=%d", part, errno); return N245_ERR_IO; }
+    if (close(out) != 0) { snprintf(detail, dsize, "close %.200s errno=%d", part, errno); return N245_ERR_IO; }
+    if (n245_hash_file(part, hex, &back) || back != size || strcmp(hex, sha)) {
+        snprintf(detail, dsize, "read-back mismatch %.200s", part);
+        return N245_ERR_IO;
+    }
+    if (N245_FAULT("rename", dst) || rename(part, dst) != 0) {
+        snprintf(detail, dsize, "rename %.200s errno=%d", dst, errno);
+        return N245_ERR_IO;
+    }
+    *bytes += size;
+    return N245_IMPORTED;
+}
+
+static int n245_file_matches(const char *path, unsigned long long size, const char *sha)
+{
+    char hex[65];
+    unsigned long long got = 0;
+    return n245_hash_file(path, hex, &got) == 0 && got == size && !strcmp(hex, sha);
+}
+
+/* Staging owned by this seed, or empty but for our own owner temp (a crash
+ * between mkdir and the owner rename). */
+static int n245_staging_adoptable(const char *staging, const char *owner_text)
+{
+    char path[N245_PATH_MAX], *text = NULL;
+    size_t size = 0;
+    DIR *dir;
+    struct dirent *ent;
+    int only_ours = 1;
+    if (!n245_join(path, sizeof(path), staging, N245_OWNER_FILE)) return 0;
+    if (n245_read_all(path, 256, &text, &size) == 0) {
+        int same = size == strlen(owner_text) && !memcmp(text, owner_text, size);
+        free(text);
+        return same;
+    }
+    dir = opendir(staging);
+    if (!dir) return 0;
+    while ((ent = readdir(dir)) != NULL)
+        if (strcmp(ent->d_name, ".") && strcmp(ent->d_name, "..") &&
+            strcmp(ent->d_name, N245_OWNER_FILE N245_PART_SUFFIX))
+            only_ours = 0;
+    closedir(dir);
+    return only_ours;
+}
+
+/* ------------------------------------------------------------------ import */
+N245Status n245_seed_import(const char *const *app_roots, size_t root_count, const char *data_root,
+                            const char *pinned_end, N245Result *r)
+{
+    char seed[N245_PATH_MAX], path[N245_PATH_MAX], src[N245_PATH_MAX];
+    char profiles_dir[N245_PATH_MAX], prefixes_dir[N245_PATH_MAX], prefix[N245_PATH_MAX];
+    char staging[N245_PATH_MAX], profile_path[N245_PATH_MAX], catalog_path[N245_PATH_MAX];
+    char owner_text[128], marker_text[128], hex[65];
+    char *profile = NULL, *existing = NULL, *catalog = NULL, *marker = NULL;
+    size_t profile_size = 0, existing_size = 0, catalog_size = 0, marker_size = 0, i;
+    int have_catalog = 0, listed = 0, rc, is_dir = 0;
+    unsigned catalog_count = 0;
+    N245Index ix;
+    N245Status st = N245_ERR_ARGS, publish_status = N245_IMPORTED;
+
+    if (!r) return N245_ERR_ARGS;
+    memset(r, 0, sizeof(*r));
+    memset(&ix, 0, sizeof(ix));
+#define N245_DONE(code) do { st = (code); goto done; } while (0)
+    if (!pinned_end) N245_DONE(N245_DISABLED);
+    if (!app_roots || !data_root || !*data_root || strlen(pinned_end) != 64 || !n245_is_hex64(pinned_end)) {
+        snprintf(r->detail, sizeof(r->detail), "bad arguments");
+        N245_DONE(N245_ERR_ARGS);
+    }
+    seed[0] = 0;
+    for (i = 0; i < root_count; i++) {
+        if (!app_roots[i]) continue;
+        if (!n245_join3(path, sizeof(path), app_roots[i], N245_SEED_DIR, "seed.idx")) continue;
+        if (n245_exists(path, &is_dir) && !is_dir) {
+            n245_join(seed, sizeof(seed), app_roots[i], N245_SEED_DIR);
+            snprintf(r->seed_root, sizeof(r->seed_root), "%s", app_roots[i]);
+            break;
+        }
+    }
+    if (!seed[0]) N245_DONE(N245_NO_SEED);
+    if (!n245_join(path, sizeof(path), seed, "seed.idx")) N245_DONE(N245_ERR_ARGS);
+    st = n245_index_load(path, pinned_end, &ix, r->detail, sizeof(r->detail));
+    if (st != N245_IMPORTED) goto done;
+    r->files_total = ix.file_count;
+    r->dirs_total = ix.dir_count;
+
+    /* The seed profile object: pinned by the index. */
+    if (!n245_join3(path, sizeof(path), seed, "objects", ix.profile_sha)) N245_DONE(N245_ERR_ARGS);
+    rc = n245_read_all(path, N245_PROFILE_LIMIT, &profile, &profile_size);
+    if (rc || profile_size != ix.profile_size) {
+        snprintf(r->detail, sizeof(r->detail), "seed profile object missing or wrong size");
+        N245_DONE(N245_ERR_SEED);
+    }
+    n245_sha256_of(profile, profile_size, hex);
+    if (strcmp(hex, ix.profile_sha)) {
+        snprintf(r->detail, sizeof(r->detail), "seed profile object hash mismatch");
+        N245_DONE(N245_ERR_SEED);
+    }
+
+    if (!n245_join(profiles_dir, sizeof(profiles_dir), data_root, "profiles") ||
+        !n245_join(prefixes_dir, sizeof(prefixes_dir), data_root, "prefixes") ||
+        !n245_join(prefix, sizeof(prefix), prefixes_dir, N245_SLUG) ||
+        !n245_join(staging, sizeof(staging), prefixes_dir, N245_STAGING_NAME) ||
+        !n245_join(profile_path, sizeof(profile_path), profiles_dir, N245_SLUG ".profile") ||
+        !n245_join(catalog_path, sizeof(catalog_path), profiles_dir, "profiles.lst"))
+        N245_DONE(N245_ERR_ARGS);
+    snprintf(owner_text, sizeof(owner_text), "N245-OWNER %s\n", ix.end_hash);
+    snprintf(marker_text, sizeof(marker_text), "N245-COMPLETE %s\n", ix.end_hash);
+
+    /* 1. An existing profile is never replaced. */
+    rc = n245_read_all(profile_path, N245_PROFILE_LIMIT, &existing, &existing_size);
+    if (rc != -1) {
+        if (rc != 0 || existing_size != profile_size || memcmp(existing, profile, profile_size)) {
+            snprintf(r->detail, sizeof(r->detail), "existing %.200s differs from the seed", profile_path);
+            N245_DONE(N245_REFUSED_FOREIGN_PROFILE);
+        }
+        if (!n245_join(path, sizeof(path), prefix, N245_MARKER_FILE)) N245_DONE(N245_ERR_ARGS);
+        if (n245_read_all(path, 256, &marker, &marker_size) == 0 && marker_size == strlen(marker_text) &&
+            !memcmp(marker, marker_text, marker_size))
+            N245_DONE(N245_PRESENT);
+        N245_DONE(N245_PRESENT_EXTERNAL);
+    }
+
+    /* 2. The launcher's view of the other profiles must not already claim Blur. */
+    rc = n245_read_all(catalog_path, 8191, &catalog, &catalog_size);
+    if (rc == 0) {
+        have_catalog = 1;
+        if (!n245_catalog_pure(catalog, catalog_size, &listed, &catalog_count)) {
+            snprintf(r->detail, sizeof(r->detail), "profiles.lst is not a plain name list");
+            N245_DONE(N245_REFUSED_CATALOG);
+        }
+    } else if (rc != -1) {
+        snprintf(r->detail, sizeof(r->detail), "profiles.lst unreadable rc=%d", rc);
+        N245_DONE(N245_REFUSED_CATALOG);
+    }
+    st = n245_conflicts(profiles_dir, catalog, catalog_size, have_catalog, r->detail, sizeof(r->detail));
+    if (st != N245_IMPORTED) goto done;
+
+    /* 3. The prefix: completed earlier (publish only), foreign (refuse), or built now. */
+    if (n245_exists(prefix, &is_dir)) {
+        unsigned k;
+        if (!is_dir || !n245_join(path, sizeof(path), prefix, N245_MARKER_FILE) ||
+            n245_read_all(path, 256, &marker, &marker_size) != 0 || marker_size != strlen(marker_text) ||
+            memcmp(marker, marker_text, marker_size)) {
+            snprintf(r->detail, sizeof(r->detail), "%.200s exists and was not completed by this seed", prefix);
+            N245_DONE(N245_REFUSED_FOREIGN_PREFIX);
+        }
+        /* Wine rewrites the hives on its first run: unchanged hives and link
+         * table mean the prefix was never used, so publishing is safe. */
+        for (k = 0; k < ix.file_count; k++) {
+            const N245File *f = &ix.files[k];
+            int sentinel = (!strchr(f->rel, '/') && n245_ends_with(f->rel, ".reg")) ||
+                           !strcmp(f->rel, "dosdevices/.pw-symlinks");
+            if (!sentinel) continue;
+            if (!n245_join(path, sizeof(path), prefix, f->rel) || !n245_file_matches(path, f->size, f->sha)) {
+                snprintf(r->detail, sizeof(r->detail), "completed prefix changed: %s", f->rel);
+                N245_DONE(N245_REFUSED_PREFIX_MODIFIED);
+            }
+        }
+        publish_status = N245_RESUMED_PUBLISH;
+    } else {
+        unsigned k;
+        if (n245_exists(staging, &is_dir)) {
+            if (!is_dir || !n245_staging_adoptable(staging, owner_text)) {
+                snprintf(r->detail, sizeof(r->detail), "%.200s belongs to another seed", staging);
+                N245_DONE(N245_REFUSED_STAGING);
+            }
+        } else if (n245_mkdir_p(prefixes_dir) || n245_mkdir_one(staging)) {
+            snprintf(r->detail, sizeof(r->detail), "mkdir %.200s errno=%d", staging, errno);
+            N245_DONE(N245_ERR_IO);
+        }
+        if (!n245_join(path, sizeof(path), staging, N245_OWNER_FILE)) N245_DONE(N245_ERR_ARGS);
+        if (!n245_exists(path, NULL)) {
+            if (n245_publish_bytes(path, owner_text, strlen(owner_text))) {
+                snprintf(r->detail, sizeof(r->detail), "owner stamp errno=%d", errno);
+                N245_DONE(N245_ERR_IO);
+            }
+            n245_sync_dir(staging);
+        }
+        for (k = 0; k < ix.dir_count; k++) {
+            if (!n245_join(path, sizeof(path), staging, ix.dirs[k]) || n245_mkdir_p(path)) {
+                snprintf(r->detail, sizeof(r->detail), "mkdir %s errno=%d", ix.dirs[k], errno);
+                N245_DONE(N245_ERR_IO);
+            }
+        }
+        for (k = 0; k < ix.file_count; k++) {
+            const N245File *f = &ix.files[k];
+            if (!n245_join(path, sizeof(path), staging, f->rel)) N245_DONE(N245_ERR_ARGS);
+            if (n245_file_matches(path, f->size, f->sha)) { r->kept++; continue; }
+            if (!strcmp(f->src, "-")) {
+                if (!n245_join3(src, sizeof(src), seed, "objects", f->sha)) N245_DONE(N245_ERR_ARGS);
+            } else if (!n245_join(src, sizeof(src), r->seed_root, f->src)) {
+                N245_DONE(N245_ERR_ARGS);
+            }
+            if (n245_mkdir_parent(path)) {
+                snprintf(r->detail, sizeof(r->detail), "mkdir parent of %s errno=%d", f->rel, errno);
+                N245_DONE(N245_ERR_IO);
+            }
+            st = n245_copy_verified(src, path, f->size, f->sha, &r->bytes_copied, r->detail, sizeof(r->detail));
+            if (st != N245_IMPORTED) goto done;
+            r->copied++;
+        }
+        /* Every file is verified: stamp completion, then make it the prefix. */
+        if (!n245_join(path, sizeof(path), staging, N245_MARKER_FILE) ||
+            n245_publish_bytes(path, marker_text, strlen(marker_text))) {
+            snprintf(r->detail, sizeof(r->detail), "completion stamp errno=%d", errno);
+            N245_DONE(N245_ERR_IO);
+        }
+        n245_sync_dir(staging);
+        if (N245_FAULT("rename", prefix) || rename(staging, prefix) != 0) {
+            snprintf(r->detail, sizeof(r->detail), "rename staging errno=%d", errno);
+            N245_DONE(N245_ERR_IO);
+        }
+        n245_sync_dir(prefixes_dir);
+    }
+
+    /* 4. Catalog first (a listed-but-absent profile is only skipped by the
+     *    launcher, native-wine64_main.c:816-820), profile last. */
+    if (n245_mkdir_p(profiles_dir)) {
+        snprintf(r->detail, sizeof(r->detail), "mkdir %.200s errno=%d", profiles_dir, errno);
+        N245_DONE(N245_ERR_IO);
+    }
+    if (have_catalog && !listed) {
+        size_t name_len = strlen(N245_SLUG ".profile");
+        char *grown = (char *)malloc(catalog_size + name_len + 2);
+        int failed;
+        if (!grown) N245_DONE(N245_ERR_IO);
+        memcpy(grown, catalog, catalog_size);
+        memcpy(grown + catalog_size, N245_SLUG ".profile\n", name_len + 1);
+        failed = n245_publish_bytes(catalog_path, grown, catalog_size + name_len + 1);
+        free(grown);
+        if (failed) {
+            snprintf(r->detail, sizeof(r->detail), "profiles.lst update errno=%d", errno);
+            N245_DONE(N245_ERR_IO);
+        }
+    }
+    if (n245_publish_bytes(profile_path, profile, profile_size)) {
+        snprintf(r->detail, sizeof(r->detail), "profile publish errno=%d", errno);
+        N245_DONE(N245_ERR_IO);
+    }
+    n245_sync_dir(profiles_dir);
+    st = publish_status;
+
+done:
+#undef N245_DONE
+    r->status = st;
+    free(profile);
+    free(existing);
+    free(catalog);
+    free(marker);
+    n245_index_free(&ix);
+    return st;
+}
diff -ruN a/prospero/native/native245_seed.h b/prospero/native/native245_seed.h
--- a/prospero/native/native245_seed.h
+++ b/prospero/native/native245_seed.h
@@ -0,0 +1,113 @@
+/* native245_seed.h -- first-launch seed importer for a self-sufficient
+ * native Wine Blur PKG (task 245).
+ *
+ * The package carries a read-only, hash-pinned seed under
+ *     <app0>/seed245/blur-native/seed.idx
+ *     <app0>/seed245/blur-native/objects/<sha256>
+ * and reuses the package's own Wine PE runtime (<app0>/win/wine/lib/wine/...)
+ * for every prefix module that task243 rebased onto the 01.38 package files,
+ * so no second copy of those modules is staged.
+ *
+ * After the /data grant and before pw_wine_library_load(), the launcher calls
+ * n245_seed_import(). On first launch it builds the writable prefix under
+ * <data_root>/prefixes/.blur-native.n245-staging, verifies every file by
+ * SHA-256 read-back, stamps it complete, renames the directory to
+ * <data_root>/prefixes/blur-native, appends the profile name to an existing
+ * pure-name profiles.lst, and publishes profiles/blur-native.profile LAST
+ * (temp + fsync + rename). Later launches take a cheap fast path (one
+ * <8 KiB profile read and one marker read). Existing profiles, catalogs and
+ * prefixes are never overwritten; a foreign Blur profile or prefix is a
+ * logged refusal that leaves /data untouched and lets the launcher continue.
+ *
+ * Written in the common subset of C11 and C++17 so the same file compiles
+ * into the Orbis title (gnu11) and into the host/Orbis C++ fixtures.
+ */
+#ifndef NATIVE245_SEED_H
+#define NATIVE245_SEED_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define N245_SLUG "blur-native248"
+#define N245_SEED_DIR "seed245/" N245_SLUG
+#define N245_INDEX_HEADER "N245-SEED 1"
+#define N245_STAGING_NAME "." N245_SLUG ".n245-staging"
+#define N245_OWNER_FILE ".n245-owner"
+#define N245_MARKER_FILE ".n245-complete"
+#define N245_PART_SUFFIX ".n245part"
+#define N245_INDEX_LIMIT (4u << 20)
+#define N245_PROFILE_LIMIT 8192u
+#define N245_MAX_ENTRIES 8192u
+#define N245_PATH_MAX 1024u
+
+typedef enum N245Status {
+    N245_IMPORTED = 0,            /* fresh prefix + profile published this launch */
+    N245_PRESENT = 1,             /* our marker + identical profile already there */
+    N245_PRESENT_EXTERNAL = 2,    /* identical profile, prefix not ours (e.g. task244 push): untouched */
+    N245_RESUMED_PUBLISH = 3,     /* prefix completed earlier, profile published now */
+    N245_DISABLED = 10,           /* built without N245_SEED_END: importer compiled out */
+    N245_NO_SEED = 11,            /* package carries no seed: nothing to do */
+    N245_REFUSED_FOREIGN_PROFILE = 20,
+    N245_REFUSED_FOREIGN_PREFIX = 21,
+    N245_REFUSED_CONFLICT = 22,   /* another profile declares id/prefix blur-native */
+    N245_REFUSED_CATALOG = 23,    /* profiles.lst present but not a pure name list */
+    N245_REFUSED_STAGING = 24,    /* staging dir owned by another seed or not ours */
+    N245_REFUSED_PREFIX_MODIFIED = 25, /* completed prefix no longer matches the seed */
+    N245_ERR_SEED = 30,           /* index/object missing, unpinned or hash mismatch */
+    N245_ERR_IO = 31,             /* /data write or read-back failure (resumable) */
+    N245_ERR_ARGS = 32
+} N245Status;
+
+typedef struct N245Result {
+    N245Status status;
+    unsigned files_total;
+    unsigned dirs_total;
+    unsigned copied;              /* files written this run */
+    unsigned kept;                /* files already correct in staging (resume) */
+    unsigned long long bytes_copied;
+    char seed_root[N245_PATH_MAX];
+    char detail[320];
+} N245Result;
+
+/* The pinned seed index END hash compiled into this title, or NULL. */
+const char *n245_seed_pinned_end(void);
+
+/* app_roots: candidate package roots, in the launcher's runtime_roots order.
+ * data_root: the launcher's library_root after the grant (/data/prospero-win).
+ * pinned_end: 64 lowercase hex END hash of seed.idx; NULL means disabled. */
+N245Status n245_seed_import(const char *const *app_roots, size_t root_count,
+                            const char *data_root, const char *pinned_end,
+                            N245Result *result);
+
+const char *n245_status_name(N245Status status);
+
+/* SHA-256 helpers, exported for the fixtures. */
+typedef struct N245Sha256 {
+    uint32_t h[8];
+    uint64_t length;
+    unsigned char block[64];
+    size_t used;
+} N245Sha256;
+void n245_sha256_init(N245Sha256 *s);
+void n245_sha256_update(N245Sha256 *s, const void *data, size_t size);
+void n245_sha256_hex(N245Sha256 *s, char out[65]);
+
+#ifdef N245_TEST_HOOKS
+/* Fixture-only fault injection: called before every mutating /data operation
+ * (mkdir, file create, write, rename, unlink). Returning nonzero makes that
+ * operation fail as if power was lost just before it. */
+extern int (*n245_test_fault)(const char *op, const char *path);
+/* Nonzero skips fsync so a many-run crash sweep fits the worker's time limit;
+ * the fixture keeps real fsync for its fresh-install and resume tests. */
+extern int n245_test_skip_fsync;
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+
