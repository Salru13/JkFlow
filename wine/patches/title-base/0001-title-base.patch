+ * Existing lifecycle owns service init/terminate. Never pick a random logged-in
+ * user, query an NP identity, or rename the Wine account/home to obtain a label.
+ */
+int pw_blur_name_from_orbis(const char *fallback,size_t extent,PwBlurName *out)
