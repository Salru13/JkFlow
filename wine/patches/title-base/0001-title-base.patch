   for m in libc.prx libSceFios2.prx; do
     if [[ ! -f "$OUT/pkg-stage/sce_module/$m" ]] || ! cmp -s "$MODULE_STUBS_DIR/$m" "$OUT/pkg-stage/sce_module/$m"; then
@@ -411,6 +437,17 @@
       exit 1
