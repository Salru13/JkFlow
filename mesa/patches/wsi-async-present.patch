+++ b/src/vulkan/wsi/wsi_orbis_present_queue.h
@@ -0,0 +1,187 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * ⚠ THE PRESENT LEAVES THE APPLICATION'S SUBMIT THREAD (native-dxvk, 2026-11-13).
+ *
+ * MEASURED (run-natpp1, native DXVK 1.10.3, 4-player race): SynchronizePresent waited 24-28 ms per frame, the GPU
+ * idled ~24 ms per frame and replay took ~10 ms. DXVK calls vkQueuePresentKHR on its submit thread, in order with
+ * its command submissions, and the deferred present in wsi_common_headless.c waits there for the previous frame's
+ * GPU work and then for a flip slot. While it waits, nothing else is submitted, so replay, GPU and flip run one
+ * after another instead of overlapping.
+ *
+ * So queue_present only records {image, the GPU sequence that renders it} here and returns, and one thread per
+ * swapchain does what the deferred present did, in the same order: wait for that sequence, wait for a flip slot,
+ * flip, and hand the image back to acquire through the flip queue.
+ *
+ * ⚠ THE FIFO BOUND IS THE OLD DEFERRED SLOT, NOT A NEW NUMBER. The zero-copy reservation (wsi_orbis_scanout_reserve)
+ * already counts one image for the application and one held by the WSI after its present, and that is exactly
+ * what this queue holds: at most `bound` images waiting, plus the one the worker is flipping, which is the
+ * "flip about to be submitted" slot in wsi_orbis_wait_for_flip_slot's P + 2 + R <= count. A deeper queue would
+ * need a larger reservation and add latency without adding throughput. A present that finds the queue full waits
+ * here, which is the back-pressure the old synchronous wait gave, now one frame later.
+ *
+ * Self-contained (pthread only) so the same code is driven under ThreadSanitizer on the host
+ * (research/native-wine/native-dxvk/wsi-async/pq_tsan_test.c).
+ */
+#ifndef WSI_ORBIS_PRESENT_QUEUE_H
+#define WSI_ORBIS_PRESENT_QUEUE_H
+
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+
+#define WSI_ORBIS_PQ_MAX 8
+
+struct wsi_orbis_pq {
+   /* Guards everything below AND the owner's image bookkeeping (busy_on_host, the flip queue), because the
+    * worker releases images while acquire_next_image looks for one on another thread. */
+   pthread_mutex_t lock;
+   pthread_cond_t cond;   /* queue changed: an item arrived, an item finished, or stop was asked */
+   pthread_t thread;
+   bool started;          /* the worker exists and must be joined */
+   bool start_failed;     /* pthread_create refused once: the owner presents synchronously from then on */
+   bool stop;
+   uint32_t bound;        /* at most this many images waiting (not counting the one in flight) */
+   int32_t q[WSI_ORBIS_PQ_MAX];
+   uint64_t seq[WSI_ORBIS_PQ_MAX];
+   uint32_t head, n;
+   int32_t inflight;      /* the image the worker is presenting, or -1 */
+   bool inflight_released;/* the application took it back meanwhile (release_images) */
+   bool failed;           /* a present failed; the next queue_present reports it */
+   uint64_t presented, failures;
+   void *ctx;
+   /* Called WITHOUT the lock: waits for the GPU, waits for a slot, flips. Returns false on a failed flip. */
+   bool (*present)(void *ctx, uint32_t index, uint64_t seq);
+   /* Called WITH the lock: the image has been handed to the display (or failed); release what can be released.
+    * Not called for an image the application released while it was in flight. */
+   void (*done)(void *ctx, uint32_t index, bool ok);
+};
+
+static inline void
+wsi_orbis_pq_init(struct wsi_orbis_pq *pq, uint32_t bound, void *ctx,
+                  bool (*present)(void *, uint32_t, uint64_t), void (*done)(void *, uint32_t, bool))
+{
+   memset(pq, 0, sizeof(*pq));
+   pthread_mutex_init(&pq->lock, NULL);
+   pthread_cond_init(&pq->cond, NULL);
+   pq->bound = bound < 1 ? 1 : bound > WSI_ORBIS_PQ_MAX ? WSI_ORBIS_PQ_MAX : bound;
+   pq->inflight = -1;
+   pq->ctx = ctx;
+   pq->present = present;
+   pq->done = done;
+}
+
+static void *
+wsi_orbis_pq_main(void *arg)
+{
+   struct wsi_orbis_pq *const pq = arg;
+   pthread_mutex_lock(&pq->lock);
+   for (;;) {
+      while (pq->n == 0 && !pq->stop)
+         pthread_cond_wait(&pq->cond, &pq->lock);
+      if (pq->n == 0)
+         break;   /* stop asked and nothing left: every queued frame has been presented */
+      const int32_t index = pq->q[pq->head];
+      const uint64_t seq = pq->seq[pq->head];
+      pq->head = (pq->head + 1) % WSI_ORBIS_PQ_MAX;
+      pq->n--;
+      if (index < 0) {   /* released by the application while it waited */
+         pthread_cond_broadcast(&pq->cond);
+         continue;
+      }
+      pq->inflight = index;
+      pq->inflight_released = false;
+      pthread_mutex_unlock(&pq->lock);
+
+      const bool ok = pq->present(pq->ctx, (uint32_t)index, seq);
+
+      pthread_mutex_lock(&pq->lock);
+      if (!pq->inflight_released)
+         pq->done(pq->ctx, (uint32_t)index, ok);
+      pq->inflight = -1;
+      pq->presented++;
+      if (!ok) {
+         pq->failed = true;
+         pq->failures++;
+      }
+      pthread_cond_broadcast(&pq->cond);
+   }
+   pthread_mutex_unlock(&pq->lock);
+   return NULL;
+}
+
+/* Hands `index` to the worker. Returns 1 when queued; 0 when no worker could be started, in which case nothing
+ * was queued and the caller must present synchronously. Blocks while the queue is full. Takes the lock. */
+static inline int
+wsi_orbis_pq_enqueue(struct wsi_orbis_pq *pq, uint32_t index, uint64_t seq)
+{
+   pthread_mutex_lock(&pq->lock);
+   if (!pq->started && !pq->start_failed) {
+      if (pthread_create(&pq->thread, NULL, wsi_orbis_pq_main, pq) == 0)
+         pq->started = true;
+      else
+         pq->start_failed = true;
+   }
+   if (!pq->started) {
+      pthread_mutex_unlock(&pq->lock);
+      return 0;
+   }
+   while (pq->n >= pq->bound)
+      pthread_cond_wait(&pq->cond, &pq->lock);
+   const uint32_t tail = (pq->head + pq->n) % WSI_ORBIS_PQ_MAX;
+   pq->q[tail] = (int32_t)index;
+   pq->seq[tail] = seq;
+   pq->n++;
+   pthread_cond_broadcast(&pq->cond);
+   pthread_mutex_unlock(&pq->lock);
+   return 1;
+}
+
+/* With the lock held: true once if a present failed since the last call. */
+static inline bool
+wsi_orbis_pq_take_failure_locked(struct wsi_orbis_pq *pq)
+{
+   const bool f = pq->failed;
+   pq->failed = false;
+   return f;
+}
+
+/* With the lock held: the application took `index` back (VK_EXT_swapchain_maintenance1). A waiting entry is
+ * dropped; an entry in flight is still flipped (it cannot be recalled) but not handed to done(), so the image is
+ * not released a second time under the application. */
+static inline void
+wsi_orbis_pq_forget_locked(struct wsi_orbis_pq *pq, uint32_t index)
+{
+   for (uint32_t i = 0; i < pq->n; i++) {
+      const uint32_t at = (pq->head + i) % WSI_ORBIS_PQ_MAX;
+      if (pq->q[at] == (int32_t)index)
+         pq->q[at] = -1;
+   }
+   if (pq->inflight == (int32_t)index)
+      pq->inflight_released = true;
+}
+
+/* Presents everything still queued, stops the worker and joins it. Called at swapchain destroy, before the scan-out
+ * and the images go away. Takes the lock; the caller must not hold it. */
+static inline void
+wsi_orbis_pq_drain_and_stop(struct wsi_orbis_pq *pq)
+{
+   pthread_mutex_lock(&pq->lock);
+   const bool started = pq->started;
+   pq->stop = true;
+   pthread_cond_broadcast(&pq->cond);
+   pthread_mutex_unlock(&pq->lock);
+   if (started)
+      pthread_join(pq->thread, NULL);
+   pq->started = false;
+}
+
+static inline void
+wsi_orbis_pq_finish(struct wsi_orbis_pq *pq)
+{
+   pthread_cond_destroy(&pq->cond);
+   pthread_mutex_destroy(&pq->lock);
+}
+
+#endif /* WSI_ORBIS_PRESENT_QUEUE_H */
